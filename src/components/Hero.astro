---
// Hero.astro - Cartographic Telemetry Hero with Dynamic Scroll Narrowing
import ActionButton from "./ActionButton.astro";
import HeroMap from "./HeroMap.astro";

interface Props {
  firstName?: string;
  middleName?: string;
  lastName?: string;
}

const {
  firstName = "Yovan",
  middleName = "Gunardio.",
  lastName = "",
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;

const cleanFirstName = firstName.replace(/;$/, "");

const primaryStack = [
  { name: "React", icon: "ti-brand-react" },
  { name: "Electron", icon: "ti-atom-2" },
  { name: "Laravel", icon: "ti-brand-laravel" },
  { name: "TypeScript", icon: "ti-brand-typescript" },
  { name: "Tailwind CSS", icon: "ti-brand-tailwind" },
  { name: "Astro", icon: "ti-brand-astro" },
];

const secondaryStack = [
  { name: "Docker", icon: "ti-brand-docker" },
  { name: "Google Cloud", icon: "ti-cloud" },
  { name: "Node.js", icon: "ti-brand-nodejs" },
  { name: "Vite", icon: "ti-brand-vite" },
  { name: "Git", icon: "ti-brand-git" },
  { name: "Zustand", icon: "ti-database-cog" },
  { name: "REST API", icon: "ti-api" },
  { name: "SQLite", icon: "ti-database" },
  { name: "Three.js", icon: "ti-brand-threejs" },
  { name: "WebSockets", icon: "ti-broadcast" },
  { name: "C# / .NET", icon: "ti-brand-c-sharp" },
  { name: "PHP", icon: "ti-brand-php" },
  { name: "Leaflet.js", icon: "ti-map-2" },
  { name: "MySQL", icon: "ti-brand-mysql" },
];
---

<!-- Sticky Scroll Wrapper for Smooth Hero Compression (Offset for 3.5rem Navbar) -->
<div class="relative w-full" id="hero-scroll-wrapper" style="height: calc(100vh - 3.5rem + 75vh);">
  <!-- Unified Sticky Pinned Container (Holds both compressed map stage AND locked marquee) -->
  <div class="sticky top-[3.5rem] w-full flex flex-col z-10">
    <main
      class="w-full bg-[#fcfbf9] dark:bg-[#090909] text-neutral-950 dark:text-white overflow-hidden flex flex-col justify-between selection:bg-neutral-900 selection:text-white dark:selection:bg-white dark:selection:text-black will-change-[height] relative z-10"
      id="hero-main-stage"
      style="height: calc(100vh - 3.5rem); min-height: calc((100vh - 3.5rem) * 0.618);"
    >
    <!-- Full-Bleed Ambient Map Background with Parallax (Anchored fixed height to prevent Leaflet tile invalidation during stage compression) -->
    <div id="hero-map-parallax" class="absolute inset-x-0 -top-12 h-[115vh] z-10 pointer-events-none overflow-hidden will-change-transform" style="contain: paint; backface-visibility: hidden;">
      <HeroMap interactive={false} />
      <!-- Subtle OLED Radial Vignette -->
      <div
        class="absolute inset-0 z-10 pointer-events-none"
        style="background: radial-gradient(ellipse 110% 90% at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.4) 70%, #000000 100%);"
      ></div>
    </div>

    <!-- Minimal Header (Geographic Location) - Absolute to avoid scroll layout shift -->
    <header class="absolute top-0 inset-x-0 z-20 w-full px-6 sm:px-8 lg:px-12 pt-6 sm:pt-8 flex items-center justify-between font-sans text-xs tracking-wider text-neutral-500 dark:text-neutral-400 select-none">
      <div class="flex items-center gap-3">
        <div id="hero-location-carousel" class="relative overflow-hidden inline-flex items-center will-change-[width]">
          <div id="hero-location-track" class="inline-flex items-center will-change-transform">
            <span id="hero-loc-bogor" class="whitespace-nowrap text-neutral-800 dark:text-neutral-200 font-medium pr-6" data-en="Bogor, West Java" data-id="Bogor, Jawa Barat">Bogor, West Java</span>
            <span id="hero-loc-jakarta" class="whitespace-nowrap text-neutral-800 dark:text-neutral-200 font-medium" data-en="Greater Jakarta, Indonesia" data-id="Jabodetabek, Indonesia">Greater Jakarta, Indonesia</span>
          </div>
        </div>
        <span class="text-neutral-400 dark:text-neutral-600 select-none">•</span>
        <span id="hero-header-coords" class="text-neutral-500 font-mono text-[11px] whitespace-nowrap select-none font-medium">6°35′ S, 106°47′ E</span>
      </div>
    </header>

    <!-- Center Stage: Balanced Position (~12.5vw from left) -->
    <div class="relative z-20 w-full pl-[6vw] sm:pl-[10vw] lg:pl-[12vw] pr-6 my-auto flex flex-col items-start gap-3 sm:gap-4 origin-left pointer-events-none" id="hero-typography-stage">
      <h1
        id="hero-name-container"
        class="flex flex-col leading-[0.88] m-0 p-0 text-neutral-950 dark:text-white transition-colors duration-150 select-none font-machina font-bold pointer-events-auto"
        style="font-size: clamp(3rem, 12vw, 8.8rem); letter-spacing: -0.02em; font-weight: 300;"
        aria-label={`${cleanFirstName}; ${middleName}${lastName ? ` ${lastName}` : ''}`}
      >
        <!-- Row 1: Yovan; -->
        <div id="hero-title-r1" class="relative inline-flex items-baseline whitespace-nowrap">
          <span>{cleanFirstName}</span><span id="hero-semi" class="transition-colors hover:text-[#52FF1A] cursor-pointer">;</span>
        </div>

        <!-- Row 2: Gunardio. -->
        <div id="hero-title-r2" class="inline-flex items-baseline whitespace-nowrap" style="margin-top: -0.8rem;">
          <span>{middleName}</span>
        </div>

        {lastName && (
          <div id="hero-title-r3" class="relative inline-flex items-baseline whitespace-nowrap text-neutral-700 dark:text-neutral-300">
            <span>{lastName}</span>
          </div>
        )}
      </h1>

      <!-- Halved State Content: Bio & Action Buttons (Staggered reveal: emerges together after main telemetry fades out) -->
      <div
        id="hero-halved-bio"
        class="max-w-2xl opacity-0 pointer-events-none will-change-[opacity,transform] pt-2 flex flex-col gap-3.5 sm:gap-4"
        style="transform: translate3d(0, 14px, 0);"
      >
        <p
          data-en="Software Engineer & systems builder turning ideas into working products; from landing pages and web apps to touchscreen kiosks and the hardware behind them."
          data-id="Software Engineer & systems builder yang membuat imajinasi jadi produk nyata; mulai dari landing page, web app sampai touchscreen kiosk dan hardware pendukungnya."
          class="font-sans text-[13.5px] sm:text-[15.5px] md:text-[17.5px] text-neutral-600 dark:text-neutral-400 font-normal leading-relaxed"
        >
          Software Engineer & systems builder turning ideas into working
          products; from landing pages and web apps to touchscreen kiosks and
          the hardware behind them.
        </p>

        <!-- Social / Document Action Row -->
        <div class="flex items-center gap-2 flex-wrap">
          <ActionButton
            href="https://github.com/navoyovan"
            target="_blank"
            rel="noopener noreferrer"
            ariaLabel="GitHub Profile (opens in new tab)"
            data-aria-en="GitHub Profile (opens in new tab)"
            data-aria-id="Profil GitHub (buka di tab baru)"
            variant="secondary"
            size="micro"
          >
            <i class="ti ti-brand-github text-sm" aria-hidden="true"></i>
          </ActionButton>

          <ActionButton
            href="https://linkedin.com/in/yovan-g-d-22379ba7/"
            target="_blank"
            rel="noopener noreferrer"
            ariaLabel="LinkedIn Profile (opens in new tab)"
            data-aria-en="LinkedIn Profile (opens in new tab)"
            data-aria-id="Profil LinkedIn (buka di tab baru)"
            variant="secondary"
            size="micro"
          >
            <i class="ti ti-brand-linkedin text-sm" aria-hidden="true"></i>
          </ActionButton>

          <ActionButton
            href="mailto:yovangunardio@gmail.com"
            ariaLabel="Send Email to Yovan"
            data-aria-en="Send Email to Yovan"
            data-aria-id="Kirim Email ke Yovan"
            variant="secondary"
            size="micro"
          >
            <i class="ti ti-mail text-sm" aria-hidden="true"></i>
          </ActionButton>

          <a
            href="https://docs.google.com/document/d/1dlUKA5EGLI3qPxEOfJ3acjt4tA39oxKy_Fs1Z_JM0Pk/export?format=pdf"
            target="_blank"
            rel="noopener noreferrer"
            download="Yovan_Gunardio_Resume.pdf"
            aria-label="Download Resume / CV as PDF (opens in new tab)"
            data-aria-en="Download Resume / CV as PDF (opens in new tab)"
            data-aria-id="Unduh Resume / CV dalam format PDF (buka di tab baru)"
            class="h-8 min-h-[32px] px-2.5 inline-flex items-center gap-1.5 rounded-[8px] border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-neutral-100 hover:border-neutral-950 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 active:scale-[0.98] transition-[transform,background-color,color,border-color] duration-150 ease-out select-none font-heading font-bold text-[11px] tracking-wider uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
          >
            <i class="ti ti-download text-sm" aria-hidden="true"></i>
            <span data-en="Download Resume" data-id="Unduh Resume">Download Resume</span>
          </a>
        </div>

        <!-- Main Navigation Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full sm:w-auto pt-0.5">
          <ActionButton
            variant="primary-neutral"
            size="md"
            href="#projects"
            class="group overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
          >
            <div class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out">
              <span data-en="FEATURED WORK" data-id="KARYA PILIHAN">FEATURED WORK</span>
              <span class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out">
                ↓
              </span>
            </div>
          </ActionButton>

          <ActionButton
            variant="secondary"
            size="md"
            href={`${base}/portfolio-index`}
            class="group overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
          >
            <div class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out">
              <span data-en="PORTFOLIO INDEX" data-id="INDEX PORTOFOLIO">PORTFOLIO INDEX</span>
              <span class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out">
                →
              </span>
            </div>
          </ActionButton>
        </div>
      </div>
    </div>

    <!-- Clean Editorial Footer with Scale Ruler - Elevated for Navbar & Viewport Comfort -->
    <footer class="absolute bottom-0 inset-x-0 z-20 w-full px-6 sm:px-8 lg:px-12 pb-8 sm:pb-10 lg:pb-12 flex items-end justify-between font-sans text-[11px] text-neutral-500 select-none">
      <div class="flex flex-col items-start gap-1">
        <span>Personal Portfolio & Systems Archive</span>
        <span class="font-mono text-[10px] text-neutral-600">Edition 2026</span>
      </div>

      <div class="flex flex-col items-end gap-2">
        <!-- Dynamic Architectural Scale Ruler (Bottom Right) -->
        <div id="hero-ruler-container" class="flex flex-col gap-1 w-36 sm:w-44" aria-label="Cartographic Scale">
          <div class="flex items-center justify-between font-mono text-[9px] tracking-widest text-neutral-400">
            <span>0</span>
            <span id="hero-ruler-mid">1.5</span>
            <span id="hero-ruler-max">3 KM</span>
          </div>
          <!-- Architectural notched scale line -->
          <div class="relative h-[5px] w-full border-b border-neutral-600 flex items-end justify-between">
            <span class="w-px h-full bg-neutral-400"></span>
            <span class="w-px h-[3px] bg-neutral-600"></span>
            <span class="w-px h-full bg-neutral-500"></span>
            <span class="w-px h-[3px] bg-neutral-600"></span>
            <span class="w-px h-full bg-neutral-400"></span>
          </div>
        </div>
        <span id="hero-ruler-ratio" class="text-neutral-500 text-[10px] tracking-wide font-sans">1:50,000 Architectural Scale</span>
      </div>
    </footer>
  </main>

  <!-- Lower Viewport Stack Marquee: Two-Tier Techno-Editorial Infinite Marquee -->
  <div
    class="relative w-full overflow-hidden py-4 sm:py-5 flex flex-col gap-3 sm:gap-4 select-none pointer-events-auto border-t border-neutral-800/60 bg-black/40 backdrop-blur-md hero-stack-marquee-wrapper"
    aria-label="Technology Stack Archive"
  >
    <!-- Row 1: Core Primary Stack (Continuous seamless leftward scroll) -->
    <div class="marquee-row group flex overflow-hidden w-full">
      <div class="marquee-group flex shrink-0 items-center gap-8 sm:gap-12 pr-8 sm:pr-12 animate-marquee-left group-hover:[animation-play-state:paused]">
        {primaryStack.concat(primaryStack).concat(primaryStack).map((item) => (
          <div class="flex items-center gap-2.5 opacity-90 hover:opacity-100 transition-opacity duration-200 shrink-0 cursor-default">
            <i class={`ti ${item.icon} text-2xl sm:text-3xl text-neutral-200 transition-transform duration-200 hover:scale-110`} aria-hidden="true"></i>
            <span class="font-sans text-xs sm:text-sm text-neutral-300 font-medium tracking-tight whitespace-nowrap">{item.name}</span>
          </div>
        ))}
      </div>
      <div class="marquee-group flex shrink-0 items-center gap-8 sm:gap-12 pr-8 sm:pr-12 animate-marquee-left group-hover:[animation-play-state:paused]" aria-hidden="true">
        {primaryStack.concat(primaryStack).concat(primaryStack).map((item) => (
          <div class="flex items-center gap-2.5 opacity-90 hover:opacity-100 transition-opacity duration-200 shrink-0 cursor-default">
            <i class={`ti ${item.icon} text-2xl sm:text-3xl text-neutral-200 transition-transform duration-200 hover:scale-110`} aria-hidden="true"></i>
            <span class="font-sans text-xs sm:text-sm text-neutral-300 font-medium tracking-tight whitespace-nowrap">{item.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Secondary Tools & Utilities (Continuous seamless rightward reverse scroll) -->
    <div class="marquee-row group flex overflow-hidden w-full">
      <div class="marquee-group flex shrink-0 items-center gap-7 sm:gap-10 pr-7 sm:pr-10 animate-marquee-right group-hover:[animation-play-state:paused]">
        {secondaryStack.concat(secondaryStack).map((item) => (
          <div class="flex items-center gap-2 opacity-50 hover:opacity-100 transition-opacity duration-200 shrink-0 cursor-default">
            <i class={`ti ${item.icon} text-base sm:text-lg text-neutral-300 transition-transform duration-200 hover:scale-115`} aria-hidden="true"></i>
            <span class="font-sans text-[11px] sm:text-xs text-neutral-400 font-normal tracking-tight whitespace-nowrap">{item.name}</span>
          </div>
        ))}
      </div>
      <div class="marquee-group flex shrink-0 items-center gap-7 sm:gap-10 pr-7 sm:pr-10 animate-marquee-right group-hover:[animation-play-state:paused]" aria-hidden="true">
        {secondaryStack.concat(secondaryStack).map((item) => (
          <div class="flex items-center gap-2 opacity-50 hover:opacity-100 transition-opacity duration-200 shrink-0 cursor-default">
            <i class={`ti ${item.icon} text-base sm:text-lg text-neutral-300 transition-transform duration-200 hover:scale-115`} aria-hidden="true"></i>
            <span class="font-sans text-[11px] sm:text-xs text-neutral-400 font-normal tracking-tight whitespace-nowrap">{item.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
  </div>{/* End sticky pinned container */}
</div>{/* End hero-scroll-wrapper */}

<style>
  .hero-stack-marquee-wrapper {
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    transform: translateZ(0);
    contain: content;
  }

  .marquee-row {
    transform: translateZ(0);
  }

  @keyframes marquee-scroll-left {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-100%, 0, 0);
    }
  }

  @keyframes marquee-scroll-right {
    from {
      transform: translate3d(-100%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  .animate-marquee-left {
    animation: marquee-scroll-left 25s linear infinite;
    will-change: transform;
    transform: translateZ(0);
  }

  .animate-marquee-right {
    animation: marquee-scroll-right 18s linear infinite;
    will-change: transform;
    transform: translateZ(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee-left,
    .animate-marquee-right {
      animation: none !important;
    }
  }
</style>

<script>
  let cleanupHero: (() => void) | null = null;

  const setupHeroInteractions = () => {
    if (cleanupHero) {
      cleanupHero();
      cleanupHero = null;
    }

    // 1. Dynamic Architectural Scale Ruler
    const mapEl = document.getElementById('hero-leaflet-map');
    const ruler = document.getElementById('hero-ruler-container');
    const midLabel = document.getElementById('hero-ruler-mid');
    const maxLabel = document.getElementById('hero-ruler-max');
    const ratioLabel = document.getElementById('hero-ruler-ratio');
    const carousel = document.getElementById('hero-location-carousel');
    const track = document.getElementById('hero-location-track');
    const locBogor = document.getElementById('hero-loc-bogor');
    const locJakarta = document.getElementById('hero-loc-jakarta');
    const headerCoords = document.getElementById('hero-header-coords');

    let cachedRulerWidth = ruler ? ruler.offsetWidth : 144;
    const disposers: (() => void)[] = [];

    if (mapEl && ruler && midLabel && maxLabel && ratioLabel) {
      let currentView = 'bogor';
      let coordRaf: number | null = null;
      let currentLat = -6.6271;
      let currentLng = 106.7607;

      const formatCoords = (lat: number, lng: number) => {
        const absLat = Math.abs(lat);
        const dLat = Math.floor(absLat);
        const mLat = Math.round((absLat - dLat) * 60);
        const hemiLat = lat >= 0 ? 'N' : 'S';

        const absLng = Math.abs(lng);
        const dLng = Math.floor(absLng);
        const mLng = Math.round((absLng - dLng) * 60);
        const hemiLng = lng >= 0 ? 'E' : 'W';

        return `${dLat}°${String(mLat).padStart(2, '0')}′ ${hemiLat}, ${dLng}°${String(mLng).padStart(2, '0')}′ ${hemiLng}`;
      };

      const updateCarouselLayout = (isAnimated = true) => {
        if (!carousel || !track || !locBogor || !locJakarta) return;
        const isJkt = currentView === 'jabodetabek';
        const targetWidth = isJkt ? locJakarta.offsetWidth : (locBogor.offsetWidth - 24); // subtract pr-6 gap
        const slideOffset = locBogor.offsetWidth; // slide past Bogor + gap

        carousel.style.transition = isAnimated ? 'width 500ms cubic-bezier(0.16, 1, 0.3, 1)' : 'none';
        track.style.transition = isAnimated ? 'transform 500ms cubic-bezier(0.16, 1, 0.3, 1)' : 'none';

        carousel.style.width = `${targetWidth}px`;
        track.style.transform = isJkt ? `translate3d(-${slideOffset}px, 0, 0)` : 'translate3d(0, 0, 0)';
      };

      // Continuous 60fps coordinate rolling ticker during map flight
      const animateCoordsTo = (targetLat: number, targetLng: number, durationMs = 1400) => {
        if (coordRaf) cancelAnimationFrame(coordRaf);
        const startLat = currentLat;
        const startLng = currentLng;
        const startTime = performance.now();

        const tick = (now: number) => {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / durationMs, 1);
          const ease = 1 - Math.pow(1 - progress, 3);

          currentLat = startLat + (targetLat - startLat) * ease;
          currentLng = startLng + (targetLng - startLng) * ease;

          if (headerCoords) {
            headerCoords.textContent = formatCoords(currentLat, currentLng);
          }

          if (progress < 1) {
            coordRaf = requestAnimationFrame(tick);
          } else {
            currentLat = targetLat;
            currentLng = targetLng;
            if (headerCoords) {
              headerCoords.textContent = formatCoords(currentLat, currentLng);
            }
            coordRaf = null;
          }
        };

        coordRaf = requestAnimationFrame(tick);
      };

      // Initial layout setup
      setTimeout(() => updateCarouselLayout(false), 50);

      const onResizeRuler = () => {
        if (ruler) cachedRulerWidth = ruler.offsetWidth;
        updateCarouselLayout(false);
      };
      window.addEventListener('resize', onResizeRuler, { passive: true });
      disposers.push(() => window.removeEventListener('resize', onResizeRuler));

      const onLangChange = () => {
        const isId = document.documentElement.lang === 'id';
        if (locBogor) locBogor.textContent = isId ? (locBogor.dataset.id ?? 'Bogor, Jawa Barat') : (locBogor.dataset.en ?? 'Bogor, West Java');
        if (locJakarta) locJakarta.textContent = isId ? (locJakarta.dataset.id ?? 'Jabodetabek, Indonesia') : (locJakarta.dataset.en ?? 'Greater Jakarta, Indonesia');
        updateCarouselLayout(false);
      };
      window.addEventListener('portfolio:lang-change', onLangChange);
      disposers.push(() => window.removeEventListener('portfolio:lang-change', onLangChange));

      const updateScale = () => {
        const map = (mapEl as any)._leaflet_map;
        const L = (window as any).L;
        if (!map || !L) return;

        const rulerWidthPx = cachedRulerWidth || 144;

        const center = map.getCenter();
        const pt1 = map.latLngToContainerPoint(center);
        const pt2 = L.point(pt1.x + rulerWidthPx, pt1.y);
        const latLng2 = map.containerPointToLatLng(pt2);

        const distanceMeters = center.distanceTo(latLng2);

        let maxVal: string;
        let midVal: string;

        if (distanceMeters >= 1000) {
          const km = distanceMeters / 1000;
          if (km >= 10) {
            maxVal = `${Math.round(km)} KM`;
            midVal = `${Math.round(km / 2)}`;
          } else {
            maxVal = `${km.toFixed(1)} KM`;
            midVal = `${(km / 2).toFixed(1)}`;
          }
        } else {
          maxVal = `${Math.round(distanceMeters)} M`;
          midVal = `${Math.round(distanceMeters / 2)}`;
        }

        maxLabel.textContent = maxVal;
        midLabel.textContent = midVal;

        const distanceMm = distanceMeters * 1000;
        const screenWidthMm = rulerWidthPx * 0.264583;
        const scaleRatio = Math.round(distanceMm / screenWidthMm / 1000) * 1000;
        const formattedRatio = scaleRatio >= 1000 ? scaleRatio.toLocaleString('en-US') : Math.round(distanceMm / screenWidthMm);

        const isRegional = typeof map.getZoom === 'function' && map.getZoom() <= 11;
        const scaleName = isRegional ? 'Regional Scale' : 'Architectural Scale';
        ratioLabel.textContent = `1:${formattedRatio} ${scaleName}`;
      };

      const pollMap = () => {
        const map = (mapEl as any)._leaflet_map;
        if (map) {
          updateScale();
          map.on('zoom', updateScale);
          map.on('move', updateScale);
          map.on('zoomend', updateScale);
          map.on('moveend', updateScale);
          const onMapViewChange = (e: any) => {
            const detail = e.detail;
            if (detail && detail.view) {
              currentView = detail.view;
              updateCarouselLayout(true);
              if (detail.view === 'jabodetabek') {
                const isMobile = window.innerWidth < 768;
                const targetCenter = isMobile ? { lat: -6.44, lng: 106.8270 } : { lat: -6.22, lng: 106.5270 };
                animateCoordsTo(targetCenter.lat, targetCenter.lng, 1400);
              } else {
                animateCoordsTo(-6.6271, 106.7607, 1400);
              }
            }
            updateScale();
          };
          window.addEventListener('portfolio:map-view-change', onMapViewChange);
          disposers.push(() => {
            map.off('zoom', updateScale);
            map.off('move', updateScale);
            map.off('zoomend', updateScale);
            map.off('moveend', updateScale);
            window.removeEventListener('portfolio:map-view-change', onMapViewChange);
          });
        } else {
          setTimeout(pollMap, 150);
        }
      };
      pollMap();
    }

    // 2. Smooth Sticky Scroll Compression & Time-Decoupled Marquee Momentum Ease
    const heroMain = document.getElementById('hero-main-stage');
    const heroWrapper = document.getElementById('hero-scroll-wrapper');
    const typoStage = document.getElementById('hero-typography-stage');
    const bioEl = document.getElementById('hero-halved-bio');
    const headerEl = heroMain?.querySelector('header');
    const footerEl = heroMain?.querySelector('footer');
    const badgeBox = document.getElementById('hero-map-badge');
    const mapParallax = document.getElementById('hero-map-parallax');

    if (heroMain && heroWrapper) {
      let ticking = false;
      let currentPlaybackRate = 1.0;
      let targetPlaybackRate = 1.0;
      let speedLerpRaf: number | null = null;
      const marqueeGroups = Array.from(heroWrapper.querySelectorAll<HTMLElement>('.marquee-group'));

      const applyPlaybackRate = () => {
        for (let i = 0; i < marqueeGroups.length; i++) {
          const anims = marqueeGroups[i].getAnimations();
          for (let j = 0; j < anims.length; j++) {
            anims[j].playbackRate = currentPlaybackRate;
          }
        }
      };

      const tickSpeedLerp = () => {
        const diff = targetPlaybackRate - currentPlaybackRate;
        if (Math.abs(diff) > 0.005) {
          // Smooth time-based momentum ease on its own rAF clock (independent of scroll ticks)
          currentPlaybackRate += diff * 0.045;
          applyPlaybackRate();
          speedLerpRaf = requestAnimationFrame(tickSpeedLerp);
        } else {
          currentPlaybackRate = targetPlaybackRate;
          applyPlaybackRate();
          speedLerpRaf = null;
        }
      };

      const setTargetSpeedRate = (newTarget: number) => {
        if (Math.abs(targetPlaybackRate - newTarget) > 0.02) {
          targetPlaybackRate = newTarget;
          if (!speedLerpRaf) {
            speedLerpRaf = requestAnimationFrame(tickSpeedLerp);
          }
        }
      };

      const updateHeroOnScroll = () => {
        const scrollY = window.scrollY || window.pageYOffset;
        const navHeight = 56;
        const stageHeight = window.innerHeight - navHeight;
        const phi = 0.618034; // Golden Ratio major section (61.8%)
        const compressDistance = stageHeight * (1 - phi); // 38.2% smooth scroll distance
        const progress = Math.min(Math.max(scrollY / compressDistance, 0), 1);

        const ease = 1 - Math.pow(1 - progress, 2.5);
        const minH = stageHeight * phi;
        const currentHeight = stageHeight - (ease * (stageHeight - minH));
        heroMain.style.height = `${currentHeight}px`;

        if (mapParallax) {
          const mapOffsetY = progress * -40;
          mapParallax.style.transform = `translate3d(0, ${mapOffsetY}px, 0)`;
        }

        // 1. Main Telemetry Data fades out FIRST (0.0 to 0.42 progress)
        const mainDataOpacity = Math.max(1 - (progress / 0.42), 0);

        if (headerEl) {
          headerEl.style.opacity = mainDataOpacity.toString();
          headerEl.style.pointerEvents = mainDataOpacity === 0 ? 'none' : 'auto';
        }
        if (footerEl) {
          footerEl.style.opacity = mainDataOpacity.toString();
          footerEl.style.pointerEvents = mainDataOpacity === 0 ? 'none' : 'auto';
        }
        if (badgeBox) {
          badgeBox.style.opacity = mainDataOpacity.toString();
          badgeBox.style.pointerEvents = mainDataOpacity === 0 ? 'none' : 'auto';
        }

        // 2. Title scales down slightly
        if (typoStage) {
          const scale = 1 - (ease * 0.15);
          typoStage.style.transform = `scale(${scale})`;
        }

        // 3. Bio Paragraph emerges AFTER main data fades out (0.42 to 1.0 progress)
        if (bioEl) {
          const bioProgress = Math.min(Math.max((progress - 0.42) / 0.58, 0), 1);
          const bioEase = 1 - Math.pow(1 - bioProgress, 2);
          bioEl.style.opacity = bioProgress.toString();
          const translateY = (1 - bioEase) * 14;
          bioEl.style.transform = `translate3d(0, ${translateY}px, 0)`;
          bioEl.style.pointerEvents = bioProgress > 0.6 ? 'auto' : 'none';
        }

        // 4. Time-Decoupled Marquee Velocity Easing (avoid offsetHeight reflow thrashing)
        const totalTrackScroll = window.innerHeight * 0.75;
        if (scrollY > compressDistance) {
          const dwellProgress = Math.min(Math.max((scrollY - compressDistance) / (totalTrackScroll - compressDistance), 0), 1);
          if (dwellProgress < 0.85) {
            // Pinned dwell reading zone: eases down to calm 0.28x speed
            setTargetSpeedRate(0.28);
          } else {
            // As Section 01 pushes in: smoothly ramps back to full 1.0x speed
            setTargetSpeedRate(1.0);
          }
        } else {
          // Top state
          setTargetSpeedRate(1.0);
        }

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(updateHeroOnScroll);
          ticking = true;
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      disposers.push(() => window.removeEventListener('scroll', onScroll));
      updateHeroOnScroll();
    }

    cleanupHero = () => {
      disposers.forEach((dispose) => dispose());
    };
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroInteractions);
  } else {
    setupHeroInteractions();
  }
  document.addEventListener('astro:page-load', setupHeroInteractions);
</script>

---
// Hero.astro - Server-rendered Hero section with Syne typography
import ActionButton from "./ActionButton.astro";
import HeroMap from "./HeroMap.astro";

interface Props {
  firstName?: string;
  middleName?: string;
  lastName?: string;
}

const {
  firstName = "yovan",
  middleName = "gunardio",
  lastName = "darmawan",
} = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
---

<section
  id="greeting"
  class="hero-loading relative min-h-[78vh] sm:min-h-[82vh] lg:min-h-[86vh] flex flex-col justify-center items-start z-10 pt-8 sm:pt-12 pb-10 sm:pb-16 w-full overflow-hidden"
>
  <!-- Full-Bleed Ambient Map Background -->
  <HeroMap />

  <div
    class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto relative z-20 pointer-events-none flex flex-col lg:flex-row lg:items-end justify-between gap-10"
  >
    <!-- Main Column: Title & Actions -->
    <div class="max-w-2xl flex flex-col items-start w-full pointer-events-auto">
      <h1
        class="hero-title-group select-none flex flex-col leading-none pl-7 sm:pl-0 m-0 p-0"
        aria-label={`${firstName} ${middleName} ${lastName}`}
      >
        <!-- Row 1: < yovan -->
        <div
          id="hero-h1"
          class="hero-h1 relative inline-flex items-baseline whitespace-nowrap leading-[0.9] m-0 p-0 text-neutral-950/90 dark:text-white/90 font-heading font-black"
          style="letter-spacing: -0.04em; margin-bottom: 0;"
          aria-hidden="true"
        >
          <span
            id="hero-bracket-l"
            class="hero-h1-bracket-l absolute right-full mr-[0.1em] select-none text-neutral-950 dark:text-white"
            style="bottom: 0.15em; opacity: 0.6; font-weight: 900;">&lt;</span
          >
          <span id="hero-title-text">{firstName}</span>
        </div>

        <!-- Row 2: gunardio; -->
        <div
          id="hero-h2"
          class="hero-h2 inline-flex items-baseline whitespace-nowrap border-none p-0 m-0 leading-[0.95] text-neutral-950/85 dark:text-white/85 font-heading font-black"
          style="letter-spacing: -0.03em; margin-top: clamp(-0.6rem, -1.2vw, -0.3rem); margin-bottom: clamp(0.2rem, 0.6vw, 0.5rem);"
          aria-hidden="true"
        >
          <span>{middleName}</span>
          <span
            class="hero-h2-semi text-neutral-950 dark:text-white"
            style="opacity: 0.6; margin-left: 0.05em; font-weight: 900;">;</span
          >
        </div>

        <!-- Row 3: // darmawan /> -->
        <div
          id="hero-h3"
          class="hero-h3 relative inline-flex items-baseline whitespace-nowrap p-0 m-0 leading-[1] font-heading font-normal"
          style="letter-spacing: 0.06em;"
          aria-hidden="true"
        >
          <span
            class="hero-h3-slashes text-[var(--color-accent,#52FF1A)] mr-[0.25em] select-none"
            style="opacity: 0.6; font-weight: 400;">//</span
          >
          <span class="inline-flex items-baseline whitespace-nowrap">
            <span class="text-neutral-700/80 dark:text-neutral-300/80"
              >{lastName}</span
            >
            <span
              id="hero-bracket-r"
              class="hero-h1-bracket-r ml-[0.15em] select-none text-neutral-950 dark:text-white"
              style="opacity: 0.6; font-weight: 900;">/&gt;</span
            >
          </span>
        </div>
      </h1>

      <!-- Subtitle & Quick Action Pills -->
      <div class="mt-6 sm:mt-10 max-w-xl space-y-6">
        <p
          data-en="Software Engineer & systems builder turning ideas into working products; from landing pages and web apps to touchscreen kiosks and the hardware behind them."
          data-id="Software Engineer & systems builder yang membuat imajinasi jadi produk nyata; mulai dari landing page, web app sampai touchscreen kiosk dan hardware pendukungnya."
          class="text-sm sm:text-base md:text-lg text-neutral-600 dark:text-neutral-400 font-normal leading-relaxed"
        >
          Software Engineer & systems builder turning ideas into working
          products; from landing pages and web apps to touchscreen kiosks and
          the hardware behind them.
        </p>

        <div class="space-y-4 pt-1">
          <div class="flex items-center gap-2">
            <ActionButton
              href="https://github.com/navoyovan"
              target="_blank"
              rel="noopener noreferrer"
              ariaLabel="GitHub Profile (opens in new tab)"
              data-aria-en="GitHub Profile (opens in new tab)"
              data-aria-id="Profil GitHub (buka di tab baru)"
              variant="secondary"
              size="micro"
            >
              <i class="ti ti-brand-github text-sm" aria-hidden="true"></i>
            </ActionButton>

            <ActionButton
              href="https://linkedin.com/in/yovan-g-d-22379ba7/"
              target="_blank"
              rel="noopener noreferrer"
              ariaLabel="LinkedIn Profile (opens in new tab)"
              data-aria-en="LinkedIn Profile (opens in new tab)"
              data-aria-id="Profil LinkedIn (buka di tab baru)"
              variant="secondary"
              size="micro"
            >
              <i class="ti ti-brand-linkedin text-sm" aria-hidden="true"></i>
            </ActionButton>

            <ActionButton
              href="mailto:yovangunardio@gmail.com"
              ariaLabel="Send Email to Yovan"
              data-aria-en="Send Email to Yovan"
              data-aria-id="Kirim Email ke Yovan"
              variant="secondary"
              size="micro"
            >
              <i class="ti ti-mail text-sm" aria-hidden="true"></i>
            </ActionButton>

            <a
              href="https://docs.google.com/document/d/1dlUKA5EGLI3qPxEOfJ3acjt4tA39oxKy_Fs1Z_JM0Pk/export?format=pdf"
              target="_blank"
              rel="noopener noreferrer"
              download="Yovan_Gunardio_Resume.pdf"
              aria-label="Download Resume / CV as PDF (opens in new tab)"
              data-aria-en="Download Resume / CV as PDF (opens in new tab)"
              data-aria-id="Unduh Resume / CV dalam format PDF (buka di tab baru)"
              class="h-8 min-h-[32px] px-2.5 inline-flex items-center gap-1.5 rounded-[8px] border border-neutral-300 dark:border-neutral-700 bg-transparent text-neutral-900 dark:text-neutral-100 hover:border-neutral-950 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 active:scale-[0.98] transition-[transform,background-color,color,border-color] duration-150 ease-out select-none font-heading font-bold text-[11px] tracking-wider uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
            >
              <i class="ti ti-download text-sm" aria-hidden="true"></i>
              <span data-en="Download Resume" data-id="Unduh Resume">Download Resume</span>
            </a>
          </div>

          <div
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full sm:w-auto"
          >
            <ActionButton
              variant="primary"
              size="md"
              href="#projects"
              class="group overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
            >
              <div
                class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out"
              >
                <span data-en="FEATURED WORK" data-id="KARYA PILIHAN"
                  >FEATURED WORK</span
                >
                <span
                  class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out"
                >
                  ↓
                </span>
              </div>
            </ActionButton>

            <ActionButton
              variant="secondary"
              size="md"
              href={`${base}/portfolio-index`}
              class="group overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
            >
              <div
                class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out"
              >
                <span data-en="PORTFOLIO INDEX" data-id="INDEX PORTOFOLIO"
                  >PORTFOLIO INDEX</span
                >
                <span
                  class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out"
                >
                  →
                </span>
              </div>
            </ActionButton>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initHero = () => {
    const greeting = document.getElementById("greeting");
    if (greeting && greeting.classList.contains("hero-loading")) {
      setTimeout(() => {
        greeting.classList.remove("hero-loading");
      }, 500);
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHero);
  } else {
    initHero();
  }
  document.addEventListener("astro:page-load", initHero);
</script>

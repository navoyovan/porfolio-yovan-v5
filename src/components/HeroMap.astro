---
interface Props {
  city?: string;
  country?: string;
  timezone?: string;
  lat?: number;
  lng?: number;
  zoom?: number;
  interactive?: boolean;
}

const {
  lat = -6.6271,
  lng = 106.7607,
  zoom = 13,
  interactive = false,
} = Astro.props;

// Compute server-rendered time for initial paint (Asia/Jakarta, UTC+7)
const jktTimeFormatter = new Intl.DateTimeFormat('en-GB', {
  timeZone: 'Asia/Jakarta',
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  hour12: false,
});
const initialTime = jktTimeFormatter.format(new Date());

const mapThemes = [
  { id: 'default', label: 'DEFAULT', code: 'AUTO' },
  { id: 'voyager', label: 'VOYAGER', code: 'CART' },
  { id: 'dark', label: 'DARK MATTER', code: 'DARK' },
  { id: 'light', label: 'POSITRON', code: 'LITE' },
  { id: 'osm', label: 'OPENSTREETMAP', code: 'OSM' },
  { id: 'satellite', label: 'SATELLITE', code: 'ESRI' },
];

const fontPresets = [
  { id: 'default', label: 'DEFAULT (SYNE)', code: 'SYNE' },
  { id: 'machina', label: 'NEUE MACHINA', code: 'MACH' },
  { id: 'swiss', label: 'SWISS MODERN', code: 'JAKARTA' },
  { id: 'brutalist', label: 'EDITORIAL BRUTAL', code: 'CLASH' },
  { id: 'mono', label: 'TECH MONOSPACE', code: 'GROTESK' },
  { id: 'serif', label: 'ARCHIVAL SERIF', code: 'FRAUNCES' },
  { id: 'industrial', label: 'NEO INDUSTRIAL', code: 'OSWALD' },
];

const scrimPresets = [
  { id: 'none', label: 'OFF (RAW MAP)', code: 'NONE' },
  { id: 'subtle', label: 'WHISPER (RECOMMENDED)', code: 'SOFT' },
  { id: 'full', label: 'ORIGINAL (FULL)', code: 'FULL' },
];
---

<div
  class:list={[
    "hero-map-background absolute inset-0 w-full h-full overflow-hidden select-none z-0",
    interactive ? "pointer-events-auto" : "pointer-events-none"
  ]}
  style="contain: paint; backface-visibility: hidden;"
  data-lat={lat}
  data-lng={lng}
  data-zoom={zoom}
  data-interactive={interactive ? "true" : "false"}
  aria-hidden={interactive ? "false" : "true"}
>
  <!-- Leaflet Map Canvas (Zero opacity lag / direct composite) -->
  <div
    id="hero-leaflet-map"
    class="w-full h-full bg-[#fcfbf9] dark:bg-[#090909] opacity-90 dark:opacity-80"
    style="contain: paint; backface-visibility: hidden;"
  ></div>

  <!-- Interactive Archival Viewfinder (Swiss Overlapping Wireframe Rectangles) -->
  <div
    id="hero-map-badge"
    data-view="bogor"
    class="absolute right-[6%] sm:right-[8%] lg:right-[10vw] top-[10%] sm:top-[20%] lg:top-[24%] pointer-events-none z-30 select-none group/maptarget data-[view=jabodetabek]:translate-x-0 data-[view=jabodetabek]:translate-y-0 sm:data-[view=jabodetabek]:-translate-x-44 sm:data-[view=jabodetabek]:translate-y-32 lg:data-[view=jabodetabek]:-translate-x-64 lg:data-[view=jabodetabek]:translate-y-40 transition-[opacity,transform] duration-300 ease-out"
  >
    <!-- Stepped Archival Wireframe (286 x 297 Reference Proportion) -->
    <div
      class="relative w-[210px] sm:w-[380px] lg:w-[460px] h-[218px] sm:h-[395px] lg:h-[478px] pointer-events-none"
    >
      <!-- Frame 1 (Vertical / Portrait Rectangle: Upper-Right) -->
      <div
        class="absolute right-0 top-0 w-[54.9%] h-[73.1%] border-[1.5px] border-neutral-950/70 dark:border-white/70 bg-neutral-950/[0.01] dark:bg-white/[0.01] transition-colors duration-200 rounded-none pointer-events-none"
      ></div>

      <!-- Frame 2 (Horizontal / Landscape Rectangle: Lower-Left) -->
      <div
        class="absolute left-0 top-[73.1%] w-[63.6%] h-[26.9%] border-[1.5px] border-neutral-950/70 dark:border-white/70 bg-neutral-950/[0.01] dark:bg-white/[0.01] transition-colors duration-200 rounded-none pointer-events-none"
      ></div>

      <!-- Middle Notch: Interactive Hitbox for toggling map location (Bogor <-> Jabodetabek) -->
      <button
        type="button"
        id="hero-map-city-btn"
        aria-label="Expand map view to Greater Jakarta"
        data-aria-en="Expand map view to Greater Jakarta"
        data-aria-id="Perluas tampilan peta ke Jabodetabek"
        title="Click to toggle map view (Bogor / Greater Jakarta)"
        data-title-en="Click to toggle map view (Bogor / Greater Jakarta)"
        data-title-id="Klik untuk beralih tampilan peta (Bogor / Jabodetabek)"
        class="absolute top-[73.1%] left-[45.1%] w-[18.5%] min-w-[55px] sm:min-w-[65px] lg:min-w-[75px] -translate-y-1/2 z-20 flex items-center justify-center bg-neutral-950 text-white dark:bg-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-200 active:scale-95 transition-[transform,background-color,color] duration-150 px-2 py-0.5 sm:py-1 font-mono font-medium text-[8px] sm:text-[9px] lg:text-[10px] tracking-wider uppercase leading-none pointer-events-auto cursor-pointer select-none rounded-none border-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
      >
        <span id="hero-map-location-title">BOGOR</span>
      </button>

      <!-- Bottom Notch: Interactive Hitbox for 00 // COOL STUFF • Jam Digital Easter Egg -->
      <button
        type="button"
        id="hero-map-time-btn"
        data-easter="jam-clock"
        aria-label="Unlock Jam Digital Cool Stuff"
        data-aria-en="Unlock Jam Digital Cool Stuff"
        data-aria-id="Buka Cool Stuff Jam Digital"
        title="00 // COOL STUFF • Jam Digital (Click to view)"
        data-title-en="00 // COOL STUFF • Jam Digital (Click to view)"
        data-title-id="00 // COOL STUFF • Jam Digital (Klik untuk melihat)"
        class="absolute bottom-0 left-0 w-[25.2%] min-w-[85px] sm:min-w-[95px] lg:min-w-[105px] -translate-y-1/2 z-20 flex items-center justify-center bg-neutral-950 text-white dark:bg-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-200 hover:text-[var(--color-accent,#52FF1A)] dark:hover:text-emerald-950 active:scale-95 transition-[transform,background-color,color] duration-150 px-2 py-0.5 sm:py-1 font-mono font-medium text-[7.5px] sm:text-[8.5px] lg:text-[9px] tracking-wider leading-none pointer-events-auto cursor-pointer select-none rounded-none border-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
      >
        <span
          id="hero-map-timezone"
          data-en="UTC+7"
          data-id="WIB"
        >{initialTime} UTC+7</span>
      </button>
    </div>
  </div>

  <!-- Dynamic Gradient Scrim Overlays -->
  <div id="hero-map-scrim-container" class="pointer-events-none select-none z-[1]">
    <!-- Subtle Scrim (Whisper) -->
    <div id="scrim-subtle" class="pointer-events-none">
      <div class="absolute inset-y-0 left-0 w-full sm:w-[36%] lg:w-[28%] bg-gradient-to-r from-[#fcfbf9]/60 via-[#fcfbf9]/20 to-transparent dark:from-[#0e0e0e]/65 dark:via-[#0e0e0e]/20 dark:to-transparent pointer-events-none"></div>
      <div class="absolute bottom-0 inset-x-0 h-24 sm:h-32 bg-gradient-to-t from-[#fcfbf9] to-transparent dark:from-[#0e0e0e] dark:to-transparent pointer-events-none"></div>
    </div>

    <!-- Full Scrim (Original) -->
    <div id="scrim-full" class="hidden pointer-events-none">
      <div class="absolute inset-y-0 left-0 w-full sm:w-[42%] lg:w-[32%] bg-gradient-to-r from-[#fcfbf9]/80 via-[#fcfbf9]/30 to-transparent dark:from-[#0e0e0e]/85 dark:via-[#0e0e0e]/30 dark:to-transparent pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#fcfbf9]/20 via-transparent to-[#fcfbf9] dark:from-[#0e0e0e]/20 dark:via-transparent dark:to-[#0e0e0e] pointer-events-none"></div>
    </div>
  </div>
</div>

<!-- Dev Settings Dropdown (reusing exact LangSwitcher / Navbar dropdown style) -->
<div
  id="hero-map-dev-menu"
  role="menu"
  aria-label="Dev Options"
  class="fixed top-20 right-6 min-w-[240px] bg-[#fcfbf9]/95 dark:bg-[#0e0e0e]/95 backdrop-blur-xl border border-neutral-200/90 dark:border-neutral-800/90 rounded-lg shadow-xl dark:shadow-2xl p-1.5 z-50 opacity-0 -translate-y-2 scale-95 pointer-events-none transition-[opacity,transform] duration-200 ease-out origin-top flex flex-col gap-1 select-none"
  style="-webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);"
>
  <div class="px-2 pt-1 pb-1.5 border-b border-neutral-200/60 dark:border-neutral-800/60 flex items-center justify-between gap-2">
    <div class="flex items-center gap-1 bg-neutral-200/50 dark:bg-neutral-800/60 p-0.5 rounded">
      <button
        type="button"
        id="dev-tab-map-btn"
        class="dev-tab-btn px-2 py-0.5 text-[10px] font-mono rounded font-semibold text-neutral-950 dark:text-white bg-white dark:bg-neutral-900 shadow-sm transition-all cursor-pointer border-0"
      >
        MAP
      </button>
      <button
        type="button"
        id="dev-tab-fonts-btn"
        class="dev-tab-btn px-2 py-0.5 text-[10px] font-mono rounded font-semibold text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer border-0 bg-transparent"
      >
        FONTS
      </button>
      <button
        type="button"
        id="dev-tab-scrim-btn"
        class="dev-tab-btn px-2 py-0.5 text-[10px] font-mono rounded font-semibold text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer border-0 bg-transparent"
      >
        SCRIM
      </button>
      <button
        type="button"
        id="dev-tab-dither-btn"
        class="dev-tab-btn px-2 py-0.5 text-[10px] font-mono rounded font-semibold text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer border-0 bg-transparent"
      >
        DITHER
      </button>
      <button
        type="button"
        id="dev-tab-ascii-btn"
        class="dev-tab-btn px-2 py-0.5 text-[10px] font-mono rounded font-semibold text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-all cursor-pointer border-0 bg-transparent"
      >
        ASCII
      </button>
    </div>
    <kbd class="px-1.5 py-0.5 text-[9px] font-mono rounded bg-neutral-200/60 dark:bg-neutral-800/80 text-neutral-500">`</kbd>
  </div>

  <!-- Map Themes Panel -->
  <div id="dev-panel-map" class="flex flex-col gap-0.5">
    <div class="px-3 pt-1 pb-0.5 text-[9px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none">
      // MAP THEME
    </div>
    <ul class="flex flex-col gap-0.5 list-none m-0 p-0" role="none">
      {mapThemes.map((t) => (
        <li role="none">
          <button
            type="button"
            role="menuitem"
            data-theme={t.id}
            data-code={t.code}
            class="map-theme-btn group flex items-center justify-between px-3 py-2 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] border-0 bg-transparent"
          >
            <span class="font-heading font-bold uppercase tracking-tight">{t.label}</span>
            <span class="map-theme-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors">
              {t.code}
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <!-- Font Presets Panel -->
  <div id="dev-panel-fonts" class="hidden flex-col gap-0.5">
    <div class="px-3 pt-1 pb-0.5 text-[9px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none">
      // PRIMARY FONTS
    </div>
    <ul class="flex flex-col gap-0.5 list-none m-0 p-0" role="none">
      {fontPresets.map((f) => (
        <li role="none">
          <button
            type="button"
            role="menuitem"
            data-font={f.id}
            data-code={f.code}
            class="font-preset-btn group flex items-center justify-between px-3 py-2 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] border-0 bg-transparent"
          >
            <span class="font-heading font-bold uppercase tracking-tight">{f.label}</span>
            <span class="font-preset-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors">
              {f.code}
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <!-- Scrim Presets Panel -->
  <div id="dev-panel-scrim" class="hidden flex-col gap-0.5">
    <div class="px-3 pt-1 pb-0.5 text-[9px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none">
      // GRADIENT SCRIM OVERLAY
    </div>
    <ul class="flex flex-col gap-0.5 list-none m-0 p-0" role="none">
      {scrimPresets.map((s) => (
        <li role="none">
          <button
            type="button"
            role="menuitem"
            data-scrim={s.id}
            data-code={s.code}
            class="scrim-preset-btn group flex items-center justify-between px-3 py-2 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] border-0 bg-transparent"
          >
            <span class="font-heading font-bold uppercase tracking-tight">{s.label}</span>
            <span class="scrim-preset-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors">
              {s.code}
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <!-- Dither Presets Panel -->
  <div id="dev-panel-dither" class="hidden flex-col gap-1.5 p-1">
    <div class="px-2 pt-0.5 text-[9px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none">
      // PORTRAIT DITHER PALETTE
    </div>
    <div class="flex flex-col gap-0.5">
      <button
        type="button"
        data-dither-idx="0"
        class="dither-palette-btn flex items-center justify-between px-2.5 py-1.5 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>1. CYBER WAVE</span>
        <span class="dither-palette-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600">✓</span>
      </button>
      <button
        type="button"
        data-dither-idx="1"
        class="dither-palette-btn flex items-center justify-between px-2.5 py-1.5 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>2. RETRO INK</span>
        <span class="dither-palette-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
      <button
        type="button"
        data-dither-idx="2"
        class="dither-palette-btn flex items-center justify-between px-2.5 py-1.5 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>3. TERMINAL GLOW</span>
        <span class="dither-palette-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
      <button
        type="button"
        data-dither-idx="3"
        class="dither-palette-btn flex items-center justify-between px-2.5 py-1.5 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>4. WARM EDITORIAL</span>
        <span class="dither-palette-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
      <button
        type="button"
        data-dither-idx="4"
        class="dither-palette-btn flex items-center justify-between px-2.5 py-1.5 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>5. SUBTLE CHARCOAL</span>
        <span class="dither-palette-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
    </div>

    <div class="px-2 pt-2 border-t border-neutral-200/60 dark:border-neutral-800/60 text-[9px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none">
      // PATTERN SHAPE
    </div>
    <div class="flex flex-col gap-0.5">
      <button
        type="button"
        data-pattern-idx="0"
        class="dither-pattern-btn flex items-center justify-between px-2.5 py-1 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>1. DIRECTIONAL WAVE</span>
        <span class="dither-pattern-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600">✓</span>
      </button>
      <button
        type="button"
        data-pattern-idx="1"
        class="dither-pattern-btn flex items-center justify-between px-2.5 py-1 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>2. RADIAL HALO</span>
        <span class="dither-pattern-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
      <button
        type="button"
        data-pattern-idx="2"
        class="dither-pattern-btn flex items-center justify-between px-2.5 py-1 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>3. TOPOGRAPHIC CONTOUR</span>
        <span class="dither-pattern-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
      <button
        type="button"
        data-pattern-idx="3"
        class="dither-pattern-btn flex items-center justify-between px-2.5 py-1 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>4. CRT MATRIX</span>
        <span class="dither-pattern-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
      <button
        type="button"
        data-pattern-idx="4"
        class="dither-pattern-btn flex items-center justify-between px-2.5 py-1 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>5. RISOGRAPH DOTS</span>
        <span class="dither-pattern-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
      <button
        type="button"
        data-pattern-idx="5"
        class="dither-pattern-btn flex items-center justify-between px-2.5 py-1 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors text-left w-full cursor-pointer border-0 bg-transparent"
      >
        <span>6. CLOUDY INTERFERENCE</span>
        <span class="dither-pattern-indicator text-[10px] font-mono text-neutral-400 dark:text-neutral-600"></span>
      </button>
    </div>

    <div class="px-2 pt-2 border-t border-neutral-200/60 dark:border-neutral-800/60 text-[9px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none flex items-center justify-between">
      <span>// PIXEL SCALE</span>
      <span id="dither-scale-val" class="text-[var(--color-accent,#52FF1A)] font-bold">2PX</span>
    </div>
    <div class="grid grid-cols-4 gap-1 px-1">
      <button type="button" data-dither-scale="1" class="dither-scale-btn py-1 text-center font-mono text-[10px] rounded border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-900 cursor-pointer">1PX</button>
      <button type="button" data-dither-scale="2" class="dither-scale-btn py-1 text-center font-mono text-[10px] rounded border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-900 cursor-pointer">2PX</button>
      <button type="button" data-dither-scale="3" class="dither-scale-btn py-1 text-center font-mono text-[10px] rounded border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-900 cursor-pointer">3PX</button>
      <button type="button" data-dither-scale="4" class="dither-scale-btn py-1 text-center font-mono text-[10px] rounded border border-neutral-200 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-900 cursor-pointer">4PX</button>
    </div>
  </div>

  <!-- ASCII Fluid Particles Tuner Panel -->
  <div id="dev-panel-ascii" class="hidden flex-col gap-2 p-1 text-[11px] font-mono select-none">
    <div class="px-1 pt-0.5 pb-1 border-b border-neutral-200/60 dark:border-neutral-800/60 flex items-center justify-between text-[9px] uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
      <span>// ASCII FLUID ENGINE</span>
      <span class="text-emerald-500 font-semibold">LIVE</span>
    </div>

    <!-- Island Count -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">ISLAND_COUNT</span>
        <span id="dev-ascii-val-count" class="text-emerald-400 font-semibold">65</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-count" min="15" max="150" step="5" value="65" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Width (X) -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">WIDTH (X)</span>
        <span id="dev-ascii-val-rad-x" class="text-emerald-400 font-semibold">8px</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-rad-x" min="2" max="40" step="1" value="8" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Height (Y) -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">HEIGHT (Y)</span>
        <span id="dev-ascii-val-rad-y" class="text-emerald-400 font-semibold">28px</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-rad-y" min="2" max="50" step="1" value="28" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Dither Density -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">DITHER_DENSITY</span>
        <span id="dev-ascii-val-dither" class="text-emerald-400 font-semibold">1.7x</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-dither" min="0.6" max="2.6" step="0.1" value="1.7" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Breath Speed -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">BREATH_SPEED</span>
        <span id="dev-ascii-val-breath" class="text-emerald-400 font-semibold">1.0x</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-breath" min="0" max="3" step="0.1" value="1.0" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Slide Shear -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">SLIDE_SHEAR</span>
        <span id="dev-ascii-val-shear" class="text-emerald-400 font-semibold">35px</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-shear" min="0" max="100" step="5" value="35" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Opacity -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">GLYPH_OPACITY</span>
        <span id="dev-ascii-val-opacity" class="text-emerald-400 font-semibold">20%</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-opacity" min="0.05" max="1.0" step="0.05" value="0.20" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Ambient Dust -->
    <div class="space-y-0.5 px-1">
      <div class="flex justify-between text-[10px]">
        <span class="text-neutral-500 dark:text-neutral-400">AMBIENT_DUST</span>
        <span id="dev-ascii-val-dust" class="text-emerald-400 font-semibold">40</span>
      </div>
      <input type="range" id="dev-ascii-ctrl-dust" min="0" max="120" step="10" value="40" class="w-full accent-emerald-500 cursor-pointer h-1 bg-neutral-200 dark:bg-neutral-800 rounded appearance-none" />
    </div>

    <!-- Reset Button -->
    <div class="pt-1.5 border-t border-neutral-200/60 dark:border-neutral-800/60 flex items-center justify-between px-1">
      <button id="dev-ascii-btn-reset" class="px-2 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 hover:bg-neutral-300 dark:hover:bg-neutral-700 text-neutral-800 dark:text-neutral-200 text-[9px] cursor-pointer transition-colors border-0">
        RESET DEFAULTS
      </button>
    </div>
  </div>
</div>

<style is:global>
  /* Clean Leaflet Overrides */
  .leaflet-container {
    font-family: inherit;
    background: transparent !important;
    cursor: default !important;
  }
  .leaflet-control-attribution {
    display: none !important;
  }
</style>

<script>
  const initLeafletMap = () => {
    const mapEl = document.getElementById('hero-leaflet-map');
    if (!mapEl) return;

    const widget = mapEl.closest('.hero-map-background') as HTMLElement;
    if (!widget) return;

    const lat = parseFloat(widget.dataset.lat || '-6.5971');
    const lng = parseFloat(widget.dataset.lng || '106.7640');
    const zoom = parseInt(widget.dataset.zoom || '14', 10);

    const loadScript = (src: string): Promise<void> => {
      return new Promise((resolve, reject) => {
        if (document.querySelector(`script[src="${src}"]`)) {
          resolve();
          return;
        }
        const s = document.createElement('script');
        s.src = src;
        s.onload = () => resolve();
        s.onerror = reject;
        document.head.appendChild(s);
      });
    };

    const loadCSS = (href: string) => {
      if (document.querySelector(`link[href="${href}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      document.head.appendChild(link);
    };

    loadCSS('https://unpkg.com/leaflet@1.9.4/dist/leaflet.css');

    loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js').then(() => {
      const L = (window as any).L;
      if (!L) return;

      if ((mapEl as any)._leaflet_map) {
        (mapEl as any)._leaflet_map.remove();
      }

      const getBogorTarget = () => {
        const isMobile = window.innerWidth < 768;
        return {
          // Locked-in coordinates: [-6.6271, 106.7607] at zoom 13
          center: [-6.6271, 106.7607] as [number, number],
          zoom: 13,
        };
      };

      const getJabodetabekTarget = () => {
        const isMobile = window.innerWidth < 768;
        return {
          // Mobile: shifted north [-6.44, 106.8270] at zoom 10. Desktop: original offset [-6.22, 106.5270] at zoom 11
          center: (isMobile ? [-6.44, 106.8270] : [-6.22, 106.5270]) as [number, number],
          zoom: isMobile ? 10 : 11,
        };
      };

      const initialBogor = getBogorTarget();
      const isInteractive = widget.dataset.interactive === 'true';

      const map = L.map(mapEl, {
        center: initialBogor.center,
        zoom: initialBogor.zoom,
        zoomControl: false,
        attributionControl: false,
        dragging: isInteractive,
        touchZoom: isInteractive,
        doubleClickZoom: isInteractive,
        scrollWheelZoom: isInteractive,
        boxZoom: isInteractive,
        keyboard: isInteractive,
        fadeAnimation: false,
      });

      if (isInteractive) {
        mapEl.style.cursor = 'grab';
        map.on('dragstart', () => { mapEl.style.cursor = 'grabbing'; });
        map.on('dragend', () => { mapEl.style.cursor = 'grab'; });
        map.on('moveend', () => {
          const c = map.getCenter();
          const z = map.getZoom();
          const payload = JSON.stringify({ lat: Number(c.lat.toFixed(6)), lng: Number(c.lng.toFixed(6)), zoom: z });
          localStorage.setItem('hero_locked_map_loc', payload);
          console.log(`[LOCKED_MAP_COORDS] ${payload}`);
        });
      }

      // Check if user previously locked in location in localStorage
      const savedLoc = localStorage.getItem('hero_locked_map_loc');
      if (savedLoc) {
        try {
          const parsed = JSON.parse(savedLoc);
          if (parsed.lat && parsed.lng && parsed.zoom) {
            map.setView([parsed.lat, parsed.lng], parsed.zoom);
          }
        } catch (e) {}
      }

      (mapEl as any)._leaflet_map = map;

      const cartoKey = import.meta.env.PUBLIC_CARTO_KEY ?? '';
      const keyParam = cartoKey ? `?key=${cartoKey}` : '';
      const lightBaseUrl = `https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png${keyParam}`;
      const darkBaseUrl = `https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png${keyParam}`;

      let currentBaseLayer: any = null;

      const commonTileOpts = {
        subdomains: 'abcd',
        maxZoom: 19,
        keepBuffer: 8,
        updateWhenIdle: false,
        updateWhenZooming: false,
        crossOrigin: 'anonymous' as const,
      };

      const getThemeTileLayer = (theme: string) => {
        const isDark = document.documentElement.classList.contains('dark');
        switch (theme) {
          case 'voyager':
            return L.tileLayer(
              `https://{s}.basemaps.cartocdn.com/rastertiles/voyager_nolabels/{z}/{x}/{y}{r}.png${keyParam}`,
              commonTileOpts
            );
          case 'dark':
            return L.tileLayer(darkBaseUrl, commonTileOpts);
          case 'light':
            return L.tileLayer(lightBaseUrl, commonTileOpts);
          case 'osm':
            return L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              ...commonTileOpts,
              subdomains: 'abc',
            });
          case 'satellite':
            return L.tileLayer(
              'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
              { ...commonTileOpts, maxZoom: 19 }
            );
          case 'default':
          default:
            return L.tileLayer(isDark ? darkBaseUrl : lightBaseUrl, commonTileOpts);
        }
      };

      let lastThemeMode = '';
      const updateTileTheme = (force = false) => {
        const activeTheme = localStorage.getItem('hero_map_theme') || 'default';
        const isDark = document.documentElement.classList.contains('dark');
        const themeStateKey = `${activeTheme}_${isDark ? 'dark' : 'light'}`;

        if (!force && themeStateKey === lastThemeMode && currentBaseLayer) {
          return; // No change in theme or dark mode: keep tiles intact!
        }

        lastThemeMode = themeStateKey;
        if (currentBaseLayer) {
          map.removeLayer(currentBaseLayer);
        }
        currentBaseLayer = getThemeTileLayer(activeTheme).addTo(map);
      };

      updateTileTheme(true);
      window.addEventListener('portfolio:map-theme-change', () => updateTileTheme(true));

      // Location Toggle (Bogor <-> Jabodetabek) via City Button
      const badgeBox = document.getElementById('hero-map-badge');
      const cityBtn = document.getElementById('hero-map-city-btn');
      const locationTitle = document.getElementById('hero-map-location-title');
      const tzEl = document.getElementById('hero-map-timezone');
      let isJabodetabek = false;
      let isTransitioning = false;

      // Timezone adapter (Asia/Jakarta, UTC+7 / WIB) with live clock
      const updateLocalClock = () => {
        if (!tzEl) return;
        try {
          const isId = document.documentElement.lang === 'id';
          const tzLabel = isId ? 'WIB' : 'UTC+7';
          const now = new Date();

          let timeString = '';
          try {
            const formatter = new Intl.DateTimeFormat('en-GB', {
              timeZone: 'Asia/Jakarta',
              hour: '2-digit',
              minute: '2-digit',
              second: '2-digit',
              hour12: false,
            });
            timeString = formatter.format(now);
          } catch {
            const utcHours = now.getUTCHours();
            const utcMinutes = now.getUTCMinutes();
            const utcSeconds = now.getUTCSeconds();
            const jktHours = (utcHours + 7) % 24;
            timeString = `${String(jktHours).padStart(2, '0')}:${String(utcMinutes).padStart(2, '0')}:${String(utcSeconds).padStart(2, '0')}`;
          }

          const userOffsetMin = -now.getTimezoneOffset();
          const diffHours = (420 - userOffsetMin) / 60;

          if (diffHours === 0) {
            tzEl.textContent = `${timeString} ${tzLabel}`;
          } else {
            const sign = diffHours > 0 ? '+' : '';
            const diffFormatted = `${sign}${diffHours % 1 === 0 ? diffHours : diffHours.toFixed(1)}h`;
            tzEl.textContent = `${timeString} ${tzLabel} (${diffFormatted})`;
          }
        } catch {
          const isId = document.documentElement.lang === 'id';
          tzEl.textContent = isId ? 'WIB' : 'UTC+7';
        }
      };

      const updateMapLabels = () => {
        const isId = document.documentElement.lang === 'id';
        if (locationTitle) {
          locationTitle.textContent = isJabodetabek ? (isId ? 'JABODETABEK' : 'GREATER JAKARTA') : 'BOGOR';
        }
        updateLocalClock();
        
        if (cityBtn) {
          const ariaEn = isJabodetabek ? 'Focus map on Bogor' : 'Expand map view to Greater Jakarta';
          const ariaId = isJabodetabek ? 'Fokuskan peta ke Bogor' : 'Perluas tampilan peta ke Jabodetabek';
          const titleEn = isJabodetabek ? 'Click to focus on Bogor' : 'Click to expand view to Greater Jakarta';
          const titleId = isJabodetabek ? 'Klik untuk memfokuskan ke Bogor' : 'Klik untuk memperluas tampilan ke Jabodetabek';

          cityBtn.setAttribute('data-aria-en', ariaEn);
          cityBtn.setAttribute('data-aria-id', ariaId);
          cityBtn.setAttribute('data-title-en', titleEn);
          cityBtn.setAttribute('data-title-id', titleId);
          cityBtn.setAttribute('aria-label', isId ? ariaId : ariaEn);
          cityBtn.setAttribute('title', isId ? titleId : titleEn);
        }

        window.dispatchEvent(new CustomEvent('portfolio:map-view-change', {
          detail: {
            view: isJabodetabek ? 'jabodetabek' : 'bogor',
            location: isJabodetabek ? (isId ? 'Jabodetabek, Indonesia' : 'Greater Jakarta, Indonesia') : (isId ? 'Bogor, Jawa Barat' : 'Bogor, West Java'),
            coords: isJabodetabek ? '6°12′ S, 106°50′ E' : '6°35′ S, 106°47′ E',
          }
        }));
      };

      updateMapLabels();
      window.removeEventListener('portfolio:lang-change', updateMapLabels);
      window.addEventListener('portfolio:lang-change', updateMapLabels);

      if (cityBtn && badgeBox) {
        cityBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (isTransitioning) return;
          isTransitioning = true;
          isJabodetabek = !isJabodetabek;

          // 1. Fade out smoothly on click
          badgeBox.style.opacity = '0';
          badgeBox.style.pointerEvents = 'none';

          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const target = isJabodetabek ? getJabodetabekTarget() : getBogorTarget();
          const duration = prefersReducedMotion ? 0 : 1.4;

          // 2. Fly map to target
          if (prefersReducedMotion) {
            map.setView(target.center, target.zoom);
          } else {
            map.flyTo(target.center, target.zoom, { duration });
          }

          // 3. Update text & position while invisible
          setTimeout(() => {
            badgeBox.setAttribute('data-view', isJabodetabek ? 'jabodetabek' : 'bogor');
            cityBtn.setAttribute('aria-pressed', String(isJabodetabek));
            updateMapLabels();
          }, 250);

          // 4. Reintroduce smoothly once map finishes moving
          let reintroduced = false;
          const reintroduce = () => {
            if (reintroduced) return;
            reintroduced = true;
            badgeBox.style.opacity = '1';
            badgeBox.style.pointerEvents = 'auto';
            isTransitioning = false;
          };

          map.once('moveend', () => {
            setTimeout(reintroduce, 120);
          });

          // Safety fallback timeout
          setTimeout(reintroduce, (duration * 1000) + 300);
        });
      }

      // Recalculate size on window resize & adapt center
      let lastIsMobile = window.innerWidth < 768;
      const handleResize = () => {
        if (map) {
          map.invalidateSize();
          const isMobileNow = window.innerWidth < 768;
          if (isMobileNow !== lastIsMobile) {
            lastIsMobile = isMobileNow;
            const target = isJabodetabek ? getJabodetabekTarget() : getBogorTarget();
            map.setView(target.center, target.zoom);
          }
        }
      };
      window.addEventListener('resize', handleResize, { passive: true });

      // Staged invalidation to guarantee full tile grid coverage on initial paint
      setTimeout(() => map.invalidateSize(), 100);

      // Only reload tiles when dark mode actually toggles
      const observer = new MutationObserver(() => {
        updateTileTheme(false);
      });
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    });
  };

  let heroClockTimer: number | null = null;
  const startHeroClock = () => {
    const update = () => {
      const tzEl = document.getElementById('hero-map-timezone');
      if (!tzEl) return;
      try {
        const isId = document.documentElement.lang === 'id';
        const tzLabel = isId ? 'WIB' : 'UTC+7';
        const now = new Date();

        let timeString = '';
        try {
          const formatter = new Intl.DateTimeFormat('en-GB', {
            timeZone: 'Asia/Jakarta',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false,
          });
          timeString = formatter.format(now);
        } catch {
          const utcHours = now.getUTCHours();
          const utcMinutes = now.getUTCMinutes();
          const utcSeconds = now.getUTCSeconds();
          const jktHours = (utcHours + 7) % 24;
          timeString = `${String(jktHours).padStart(2, '0')}:${String(utcMinutes).padStart(2, '0')}:${String(utcSeconds).padStart(2, '0')}`;
        }

        const userOffsetMin = -now.getTimezoneOffset();
        const diffHours = (420 - userOffsetMin) / 60;

        if (diffHours === 0) {
          tzEl.textContent = `${timeString} ${tzLabel}`;
        } else {
          const sign = diffHours > 0 ? '+' : '';
          const diffFormatted = `${sign}${diffHours % 1 === 0 ? diffHours : diffHours.toFixed(1)}h`;
          tzEl.textContent = `${timeString} ${tzLabel} (${diffFormatted})`;
        }
      } catch {
        const isId = document.documentElement.lang === 'id';
        tzEl.textContent = isId ? 'WIB' : 'UTC+7';
      }
    };

    update();
    if (heroClockTimer) clearInterval(heroClockTimer);
    heroClockTimer = window.setInterval(update, 1000);
    window.removeEventListener('portfolio:lang-change', update);
    window.addEventListener('portfolio:lang-change', update);
  };

  const initDevMenu = () => {
    const devMenu = document.getElementById('hero-map-dev-menu');
    if (!devMenu) return;

    let isDevMenuOpen = false;
    const setDevMenuState = (open: boolean) => {
      isDevMenuOpen = open;
      if (open) {
        devMenu.classList.remove('opacity-0', '-translate-y-2', 'scale-95', 'pointer-events-none');
        devMenu.classList.add('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
      } else {
        devMenu.classList.remove('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
        devMenu.classList.add('opacity-0', '-translate-y-2', 'scale-95', 'pointer-events-none');
      }
    };

    devMenu.onclick = (e) => e.stopPropagation();

    // Tab switcher
    const tabMapBtn = document.getElementById('dev-tab-map-btn');
    const tabFontsBtn = document.getElementById('dev-tab-fonts-btn');
    const tabScrimBtn = document.getElementById('dev-tab-scrim-btn');
    const tabDitherBtn = document.getElementById('dev-tab-dither-btn');
    const tabAsciiBtn = document.getElementById('dev-tab-ascii-btn');
    const panelMap = document.getElementById('dev-panel-map');
    const panelFonts = document.getElementById('dev-panel-fonts');
    const panelScrim = document.getElementById('dev-panel-scrim');
    const panelDither = document.getElementById('dev-panel-dither');
    const panelAscii = document.getElementById('dev-panel-ascii');

    const switchDevTab = (tab: 'map' | 'fonts' | 'scrim' | 'dither' | 'ascii') => {
      const tabs = [
        { key: 'map', btn: tabMapBtn, panel: panelMap },
        { key: 'fonts', btn: tabFontsBtn, panel: panelFonts },
        { key: 'scrim', btn: tabScrimBtn, panel: panelScrim },
        { key: 'dither', btn: tabDitherBtn, panel: panelDither },
        { key: 'ascii', btn: tabAsciiBtn, panel: panelAscii },
      ];

      tabs.forEach((t) => {
        if (!t.btn || !t.panel) return;
        if (t.key === tab) {
          t.panel.classList.remove('hidden');
          t.panel.classList.add('flex');
          t.btn.classList.add('text-neutral-950', 'dark:text-white', 'bg-white', 'dark:bg-neutral-900', 'shadow-sm');
          t.btn.classList.remove('text-neutral-500');
        } else {
          t.panel.classList.add('hidden');
          t.panel.classList.remove('flex');
          t.btn.classList.remove('text-neutral-950', 'dark:text-white', 'bg-white', 'dark:bg-neutral-900', 'shadow-sm');
          t.btn.classList.add('text-neutral-500');
        }
      });
    };

    if (tabMapBtn) tabMapBtn.onclick = (e) => { e.stopPropagation(); switchDevTab('map'); };
    if (tabFontsBtn) tabFontsBtn.onclick = (e) => { e.stopPropagation(); switchDevTab('fonts'); };
    if (tabScrimBtn) tabScrimBtn.onclick = (e) => { e.stopPropagation(); switchDevTab('scrim'); };
    if (tabDitherBtn) tabDitherBtn.onclick = (e) => { e.stopPropagation(); switchDevTab('dither'); };
    if (tabAsciiBtn) tabAsciiBtn.onclick = (e) => { e.stopPropagation(); switchDevTab('ascii'); };

    // ASCII Controls Live Wiring
    const initAsciiDevControls = () => {
      const getP = (k: string, def: number) => {
        const v = localStorage.getItem('ascii_' + k);
        return v !== null ? parseFloat(v) : def;
      };

      const asciiState = {
        count: getP('count', 65),
        radiusX: getP('radiusX', 8),
        radiusY: getP('radiusY', 28),
        ditherDensity: getP('ditherDensity', 1.7),
        breathSpeed: getP('breathSpeed', 1.0),
        shearAmt: getP('shearAmt', 35),
        maxOpacity: getP('maxOpacity', 0.20),
        dustCount: getP('dustCount', 40),
      };

      const cCount = document.getElementById('dev-ascii-ctrl-count') as HTMLInputElement;
      const cRadX = document.getElementById('dev-ascii-ctrl-rad-x') as HTMLInputElement;
      const cRadY = document.getElementById('dev-ascii-ctrl-rad-y') as HTMLInputElement;
      const cDither = document.getElementById('dev-ascii-ctrl-dither') as HTMLInputElement;
      const cBreath = document.getElementById('dev-ascii-ctrl-breath') as HTMLInputElement;
      const cShear = document.getElementById('dev-ascii-ctrl-shear') as HTMLInputElement;
      const cOpacity = document.getElementById('dev-ascii-ctrl-opacity') as HTMLInputElement;
      const cDust = document.getElementById('dev-ascii-ctrl-dust') as HTMLInputElement;
      const btnReset = document.getElementById('dev-ascii-btn-reset');

      const syncUI = () => {
        if (cCount) cCount.value = String(asciiState.count);
        if (cRadX) cRadX.value = String(asciiState.radiusX);
        if (cRadY) cRadY.value = String(asciiState.radiusY);
        if (cDither) cDither.value = String(asciiState.ditherDensity);
        if (cBreath) cBreath.value = String(asciiState.breathSpeed);
        if (cShear) cShear.value = String(asciiState.shearAmt);
        if (cOpacity) cOpacity.value = String(asciiState.maxOpacity);
        if (cDust) cDust.value = String(asciiState.dustCount);

        const vC = document.getElementById('dev-ascii-val-count'); if (vC) vC.textContent = String(asciiState.count);
        const vX = document.getElementById('dev-ascii-val-rad-x'); if (vX) vX.textContent = asciiState.radiusX + 'px';
        const vY = document.getElementById('dev-ascii-val-rad-y'); if (vY) vY.textContent = asciiState.radiusY + 'px';
        const vD = document.getElementById('dev-ascii-val-dither'); if (vD) vD.textContent = asciiState.ditherDensity.toFixed(1) + 'x';
        const vB = document.getElementById('dev-ascii-val-breath'); if (vB) vB.textContent = asciiState.breathSpeed.toFixed(1) + 'x';
        const vS = document.getElementById('dev-ascii-val-shear'); if (vS) vS.textContent = asciiState.shearAmt + 'px';
        const vO = document.getElementById('dev-ascii-val-opacity'); if (vO) vO.textContent = Math.round(asciiState.maxOpacity * 100) + '%';
        const vDu = document.getElementById('dev-ascii-val-dust'); if (vDu) vDu.textContent = String(asciiState.dustCount);
      };

      const dispatch = () => {
        window.dispatchEvent(new CustomEvent('portfolio:ascii-params', { detail: { ...asciiState } }));
        try {
          localStorage.setItem('ascii_count', String(asciiState.count));
          localStorage.setItem('ascii_radiusX', String(asciiState.radiusX));
          localStorage.setItem('ascii_radiusY', String(asciiState.radiusY));
          localStorage.setItem('ascii_ditherDensity', String(asciiState.ditherDensity));
          localStorage.setItem('ascii_breathSpeed', String(asciiState.breathSpeed));
          localStorage.setItem('ascii_shearAmt', String(asciiState.shearAmt));
          localStorage.setItem('ascii_maxOpacity', String(asciiState.maxOpacity));
          localStorage.setItem('ascii_dustCount', String(asciiState.dustCount));
        } catch(e) {}
      };

      cCount?.addEventListener('input', (e) => { asciiState.count = parseInt((e.target as HTMLInputElement).value, 10); syncUI(); dispatch(); });
      cRadX?.addEventListener('input', (e) => { asciiState.radiusX = parseInt((e.target as HTMLInputElement).value, 10); syncUI(); dispatch(); });
      cRadY?.addEventListener('input', (e) => { asciiState.radiusY = parseInt((e.target as HTMLInputElement).value, 10); syncUI(); dispatch(); });
      cDither?.addEventListener('input', (e) => { asciiState.ditherDensity = parseFloat((e.target as HTMLInputElement).value); syncUI(); dispatch(); });
      cBreath?.addEventListener('input', (e) => { asciiState.breathSpeed = parseFloat((e.target as HTMLInputElement).value); syncUI(); dispatch(); });
      cShear?.addEventListener('input', (e) => { asciiState.shearAmt = parseInt((e.target as HTMLInputElement).value, 10); syncUI(); dispatch(); });
      cOpacity?.addEventListener('input', (e) => { asciiState.maxOpacity = parseFloat((e.target as HTMLInputElement).value); syncUI(); dispatch(); });
      cDust?.addEventListener('input', (e) => { asciiState.dustCount = parseInt((e.target as HTMLInputElement).value, 10); syncUI(); dispatch(); });

      btnReset?.addEventListener('click', () => {
        asciiState.count = 65;
        asciiState.radiusX = 8;
        asciiState.radiusY = 28;
        asciiState.ditherDensity = 1.7;
        asciiState.breathSpeed = 1.0;
        asciiState.shearAmt = 35;
        asciiState.maxOpacity = 0.20;
        asciiState.dustCount = 40;
        syncUI();
        dispatch();
      });

      syncUI();
    };
    initAsciiDevControls();

    // Dither UI update & button handling
    const updateDitherMenuUI = () => {
      const activeIdx = parseInt(localStorage.getItem('dither_palette_idx') || '0', 10);
      const activePattern = parseInt(localStorage.getItem('dither_pattern_idx') || '0', 10);
      const activeScale = parseInt(localStorage.getItem('dither_px_size') || '1', 10);

      const ditherPaletteBtns = devMenu.querySelectorAll<HTMLButtonElement>('.dither-palette-btn');
      ditherPaletteBtns.forEach((btn) => {
        const idx = parseInt(btn.getAttribute('data-dither-idx') || '0', 10);
        const indicator = btn.querySelector('.dither-palette-indicator');
        if (idx === activeIdx) {
          btn.classList.add('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.remove('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = '✓';
            indicator.classList.add('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        } else {
          btn.classList.remove('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.add('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = '';
            indicator.classList.remove('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        }
      });

      const ditherPatternBtns = devMenu.querySelectorAll<HTMLButtonElement>('.dither-pattern-btn');
      ditherPatternBtns.forEach((btn) => {
        const idx = parseInt(btn.getAttribute('data-pattern-idx') || '0', 10);
        const indicator = btn.querySelector('.dither-pattern-indicator');
        if (idx === activePattern) {
          btn.classList.add('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.remove('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = '✓';
            indicator.classList.add('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        } else {
          btn.classList.remove('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.add('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = '';
            indicator.classList.remove('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        }
      });

      const scaleValEl = document.getElementById('dither-scale-val');
      if (scaleValEl) scaleValEl.textContent = `${activeScale}PX`;

      const scaleBtns = devMenu.querySelectorAll<HTMLButtonElement>('.dither-scale-btn');
      scaleBtns.forEach((btn) => {
        const scale = parseInt(btn.getAttribute('data-dither-scale') || '2', 10);
        if (scale === activeScale) {
          btn.classList.add('bg-[var(--color-accent,#52FF1A)]', 'text-neutral-950', 'font-bold');
          btn.classList.remove('text-neutral-700', 'dark:text-neutral-300');
        } else {
          btn.classList.remove('bg-[var(--color-accent,#52FF1A)]', 'text-neutral-950', 'font-bold');
          btn.classList.add('text-neutral-700', 'dark:text-neutral-300');
        }
      });
    };

    const ditherPaletteBtns = devMenu.querySelectorAll<HTMLButtonElement>('.dither-palette-btn');
    ditherPaletteBtns.forEach((btn) => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.getAttribute('data-dither-idx') || '0', 10);
        localStorage.setItem('dither_palette_idx', idx.toString());
        window.dispatchEvent(new CustomEvent('dither:change-palette', { detail: { index: idx } }));
        updateDitherMenuUI();
      };
    });

    const ditherPatternBtns = devMenu.querySelectorAll<HTMLButtonElement>('.dither-pattern-btn');
    ditherPatternBtns.forEach((btn) => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.getAttribute('data-pattern-idx') || '0', 10);
        localStorage.setItem('dither_pattern_idx', idx.toString());
        window.dispatchEvent(new CustomEvent('dither:change-pattern', { detail: { index: idx } }));
        updateDitherMenuUI();
      };
    });

    const scaleBtns = devMenu.querySelectorAll<HTMLButtonElement>('.dither-scale-btn');
    scaleBtns.forEach((btn) => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const scale = parseInt(btn.getAttribute('data-dither-scale') || '2', 10);
        localStorage.setItem('dither_px_size', scale.toString());
        window.dispatchEvent(new CustomEvent('dither:change-scale', { detail: { pxSize: scale } }));
        updateDitherMenuUI();
      };
    });
    updateDitherMenuUI();

    // Map theme buttons
    const updateMapMenuUI = () => {
      const activeThemeKey = localStorage.getItem('hero_map_theme') || 'default';
      const mapButtons = devMenu.querySelectorAll<HTMLButtonElement>('.map-theme-btn');
      mapButtons.forEach((btn) => {
        const theme = btn.getAttribute('data-theme');
        const isSelected = theme === activeThemeKey;
        const indicator = btn.querySelector('.map-theme-indicator');
        if (isSelected) {
          btn.classList.add('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.remove('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = '✓';
            indicator.classList.add('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        } else {
          btn.classList.remove('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.add('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = btn.getAttribute('data-code') || '';
            indicator.classList.remove('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        }
      });
    };

    const mapButtons = devMenu.querySelectorAll<HTMLButtonElement>('.map-theme-btn');
    mapButtons.forEach((btn) => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const theme = btn.getAttribute('data-theme');
        if (theme) {
          localStorage.setItem('hero_map_theme', theme);
          window.dispatchEvent(new CustomEvent('portfolio:map-theme-change', { detail: { theme } }));
          updateMapMenuUI();
          setDevMenuState(false);
        }
      };
    });
    updateMapMenuUI();

    // Font preset buttons
    const updateFontMenuUI = () => {
      const currentFont = localStorage.getItem('portfolio_font_preset') || 'default';
      const fontButtons = devMenu.querySelectorAll<HTMLButtonElement>('.font-preset-btn');
      fontButtons.forEach((btn) => {
        const font = btn.getAttribute('data-font');
        const isSelected = font === currentFont;
        const indicator = btn.querySelector('.font-preset-indicator');
        if (isSelected) {
          btn.classList.add('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.remove('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = '✓';
            indicator.classList.add('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        } else {
          btn.classList.remove('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.add('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = btn.getAttribute('data-code') || '';
            indicator.classList.remove('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        }
      });
    };

    const fontButtons = devMenu.querySelectorAll<HTMLButtonElement>('.font-preset-btn');
    fontButtons.forEach((btn) => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const font = btn.getAttribute('data-font');
        if (font && (window as any).__setPortfolioFont) {
          (window as any).__setPortfolioFont(font);
          updateFontMenuUI();
          setDevMenuState(false);
        }
      };
    });
    updateFontMenuUI();
    window.removeEventListener('portfolio:font-change', updateFontMenuUI);
    window.addEventListener('portfolio:font-change', updateFontMenuUI);

    // Scrim overlay preset handlers
    const scrimSubtle = document.getElementById('scrim-subtle');
    const scrimFull = document.getElementById('scrim-full');

    const applyScrimMode = (mode: string) => {
      if (scrimSubtle && scrimFull) {
        if (mode === 'none') {
          scrimSubtle.classList.add('hidden');
          scrimFull.classList.add('hidden');
        } else if (mode === 'full') {
          scrimSubtle.classList.add('hidden');
          scrimFull.classList.remove('hidden');
        } else {
          // Default: 'subtle'
          scrimSubtle.classList.remove('hidden');
          scrimFull.classList.add('hidden');
        }
      }
      localStorage.setItem('hero_map_scrim', mode);
      updateScrimMenuUI();
    };

    const updateScrimMenuUI = () => {
      const activeScrim = localStorage.getItem('hero_map_scrim') || 'subtle';
      const scrimButtons = devMenu.querySelectorAll<HTMLButtonElement>('.scrim-preset-btn');
      scrimButtons.forEach((btn) => {
        const mode = btn.getAttribute('data-scrim');
        const isSelected = mode === activeScrim;
        const indicator = btn.querySelector('.scrim-preset-indicator');
        if (isSelected) {
          btn.classList.add('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.remove('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = '✓';
            indicator.classList.add('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        } else {
          btn.classList.remove('bg-neutral-100', 'dark:bg-neutral-900', 'text-neutral-950', 'dark:text-white');
          btn.classList.add('text-neutral-700', 'dark:text-neutral-300');
          if (indicator) {
            indicator.textContent = btn.getAttribute('data-code') || '';
            indicator.classList.remove('text-[var(--color-accent,#52FF1A)]', 'font-bold');
          }
        }
      });
    };

    const scrimButtons = devMenu.querySelectorAll<HTMLButtonElement>('.scrim-preset-btn');
    scrimButtons.forEach((btn) => {
      btn.onclick = (e) => {
        e.stopPropagation();
        const mode = btn.getAttribute('data-scrim');
        if (mode) {
          applyScrimMode(mode);
          setDevMenuState(false);
        }
      };
    });

    // Initialize scrim state from localStorage (defaults to 'subtle')
    const savedScrim = localStorage.getItem('hero_map_scrim') || 'subtle';
    applyScrimMode(savedScrim);

    // Keyboard & click outside listeners
    const handleDevMenuKeydown = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
        return;
      }

      if (e.key === '`' || e.code === 'Backquote') {
        e.preventDefault();
        setDevMenuState(!isDevMenuOpen);
      } else if (e.key === 'Escape' && isDevMenuOpen) {
        setDevMenuState(false);
      }
    };

    if ((window as any).__devMenuKeyHandler) {
      window.removeEventListener('keydown', (window as any).__devMenuKeyHandler);
    }
    (window as any).__devMenuKeyHandler = handleDevMenuKeydown;
    window.addEventListener('keydown', handleDevMenuKeydown);

    document.addEventListener('click', (e) => {
      if (isDevMenuOpen && devMenu && !devMenu.contains(e.target as Node)) {
        setDevMenuState(false);
      }
    });
  };

  const scheduleInit = () => {
    initDevMenu();
    startHeroClock();
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => initLeafletMap(), { timeout: 1500 });
    } else {
      setTimeout(initLeafletMap, 200);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit);
  } else {
    scheduleInit();
  }
  document.addEventListener('astro:page-load', scheduleInit);
</script>

---
// ActionButton.astro - Action Button Primitive
interface Props {
  variant?: 'primary' | 'primary-neutral' | 'cta' | 'secondary' | 'ghost' | 'danger';
  size?: 'micro' | 'sm' | 'md' | 'lg';
  rounded?: boolean;
  disabled?: boolean;
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  ariaLabel?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  rounded = false,
  disabled = false,
  href,
  class: className = '',
  type = 'button',
  id,
  ariaLabel,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const isMicro = size === 'micro';
const isRounded = rounded || isMicro;

const sizeStyles = {
  micro: 'w-8 h-8 min-w-[32px] min-h-[32px] p-0 text-xs shrink-0',
  sm: 'px-5 py-2.5 text-xs tracking-wider',
  md: 'px-7 py-3.5 text-sm sm:text-base tracking-wider',
  lg: 'px-9 py-4 text-base sm:text-lg tracking-widest',
};

const baseStyles = 'uppercase inline-flex items-center justify-center leading-none select-none no-underline cursor-pointer transition-[transform,background-color,color,border-color,opacity] duration-150 ease-out disabled:opacity-35 disabled:cursor-not-allowed disabled:pointer-events-none active:scale-[0.98] active:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950';

const variantStyles = {
  cta: "font-heading font-bold bg-[var(--color-accent,#52FF1A)] text-black animate-kiosk-pulse hover:bg-[var(--color-accent-hover,#42e012)] hover:shadow-[0_0_20px_color-mix(in_srgb,var(--color-accent,#52FF1A)_35%,transparent)] active:opacity-90 border-none",
  primary: "font-heading font-bold bg-neutral-950 text-white hover:bg-neutral-800 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200 active:scale-[0.98] border-none",
  'primary-neutral': "font-heading font-bold bg-neutral-200/80 text-neutral-950 hover:bg-neutral-300/80 border border-neutral-300 dark:bg-neutral-900 dark:text-neutral-100 dark:border-neutral-800 dark:hover:bg-neutral-800 dark:hover:border-neutral-700 active:scale-[0.98]",
  secondary: isMicro
    ? "font-heading font-bold bg-transparent text-neutral-900 dark:text-neutral-100 border border-neutral-300 dark:border-neutral-700 hover:border-neutral-950 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 active:scale-[0.98]"
    : "font-heading font-bold bg-transparent text-neutral-900 dark:text-neutral-100 border border-dashed border-neutral-400 dark:border-neutral-600 hover:border-solid hover:border-neutral-950 dark:hover:border-white hover:bg-neutral-900/5 dark:hover:bg-white/10 active:scale-[0.98]",
  ghost: "font-heading font-bold bg-transparent text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-200/60 dark:hover:bg-neutral-800/60 active:scale-[0.98] border border-transparent",
  danger: "font-heading font-bold bg-transparent text-red-600 dark:text-red-400 border border-red-300 dark:border-red-800/80 hover:bg-red-600 hover:text-white hover:border-red-600 active:scale-[0.98]"
};
---

<Tag
  id={id}
  href={href && !disabled ? href : (href && disabled ? undefined : href)}
  type={!href ? type : undefined}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  tabindex={href && disabled ? -1 : undefined}
  aria-label={ariaLabel || rest['aria-label']}
  class:list={[
    baseStyles,
    sizeStyles[size],
    variantStyles[variant],
    isRounded ? 'rounded-[8px]' : 'rounded-none',
    className,
    href && disabled ? 'opacity-35 cursor-not-allowed pointer-events-none' : ''
  ]}
  {...rest}
>
  <slot />
</Tag>

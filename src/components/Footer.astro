---
// Footer.astro - Global Systems Footer
import GithubContributionDivider from './GithubContributionDivider.astro';

const currentYear = new Date().getFullYear();
---

<GithubContributionDivider />
<footer
  class="w-full bg-[#fcfbf9] dark:bg-[#0e0e0e] text-neutral-600 dark:text-neutral-400 font-sans transition-colors duration-200 border-t border-neutral-200/60 dark:border-neutral-800/60"
>
  <div class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto">
    <!-- Layer 2: Closing Statement / Contact Hub -->
    <div
      id="contact"
      class="scroll-mt-24 py-10 sm:py-14 border-b border-neutral-200/60 dark:border-neutral-800/60 flex flex-col md:flex-row md:items-end justify-between gap-6"
    >
      <div class="space-y-3 max-w-xl">
        <h2
          id="heading-contact"
          class="font-heading text-3xl sm:text-4xl md:text-5xl text-neutral-950 dark:text-white tracking-tight leading-[1.08]"
          data-en="Have an idea? Let's build it."
          data-id="Punya ide? Mari kita bangun."
        >
          <span class="font-normal text-neutral-400 dark:text-neutral-500">Have an idea?</span><br />
          <span class="font-black text-neutral-950 dark:text-white">Let's build <span class="text-[var(--color-accent,#1b7f3b)] dark:text-[var(--color-accent,#52FF1A)]">it.</span></span>
        </h2>
        <p
          class="font-mono text-xs sm:text-[13px] text-neutral-500 dark:text-neutral-400"
          data-en="Available for select freelance contracts & full-time engineering roles."
          data-id="Tersedia untuk kontrak lepas pilihan & posisi engineering full-time."
        >
          Available for select freelance contracts &amp; full-time engineering roles.
        </p>
      </div>

      <!-- Contact & Coordinate Action Buttons -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 shrink-0">
        <!-- Email (Primary Transmission) -->
        <a
          href="mailto:yovangunardio@gmail.com"
          class="group inline-flex items-center gap-2 px-3.5 py-2 rounded-md border border-neutral-300 dark:border-neutral-700 bg-neutral-950 text-white dark:bg-white dark:text-neutral-950 hover:bg-neutral-800 dark:hover:bg-neutral-200 font-mono text-xs font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
          aria-label="Send email to Yovan"
          data-aria-en="Send email to Yovan"
          data-aria-id="Kirim email ke Yovan"
        >
          <i class="ti ti-mail text-sm" aria-hidden="true"></i>
          <span>yovangunardio@gmail.com</span>
          <span class="text-neutral-400 group-hover:text-white dark:group-hover:text-neutral-950 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/navoyovan"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-neutral-300 dark:border-neutral-800 bg-transparent hover:border-neutral-400 dark:hover:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white font-mono text-xs transition-[border-color,color] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
          aria-label="GitHub Profile (opens in new tab)"
          data-aria-en="GitHub Profile (opens in new tab)"
          data-aria-id="Profil GitHub (buka di tab baru)"
        >
          <i class="ti ti-brand-github text-sm text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white transition-colors" aria-hidden="true"></i>
          <span>GitHub</span>
          <span class="text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true">↗</span>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/in/yovan-g-d-22379ba7/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-neutral-300 dark:border-neutral-800 bg-transparent hover:border-neutral-400 dark:hover:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white font-mono text-xs transition-[border-color,color] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
          aria-label="LinkedIn Profile (opens in new tab)"
          data-aria-en="LinkedIn Profile (opens in new tab)"
          data-aria-id="Profil LinkedIn (buka di tab baru)"
        >
          <i class="ti ti-brand-linkedin text-sm text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white transition-colors" aria-hidden="true"></i>
          <span>LinkedIn</span>
          <span class="text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true">↗</span>
        </a>

        <!-- Resume / CV -->
        <a
          href="https://docs.google.com/document/d/1dlUKA5EGLI3qPxEOfJ3acjt4tA39oxKy_Fs1Z_JM0Pk/export?format=pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-neutral-300 dark:border-neutral-800 bg-transparent hover:border-neutral-400 dark:hover:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white font-mono text-xs transition-[border-color,color] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
          aria-label="Download Resume / CV as PDF (opens in new tab)"
          data-aria-en="Download Resume / CV as PDF (opens in new tab)"
          data-aria-id="Unduh Resume / CV (buka di tab baru)"
        >
          <i class="ti ti-file-text text-sm text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white transition-colors" aria-hidden="true"></i>
          <span data-en="Resume / CV" data-id="Resume / CV">Resume / CV</span>
          <span class="text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- Layer 3: Footer Utility Strip -->
    <div
      class="py-6 sm:py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-500"
    >
      <!-- Left: Copyright & Attribution -->
      <div
        class="flex flex-wrap items-center justify-center sm:justify-start gap-x-2 gap-y-1 text-center sm:text-left"
      >
        <span class="font-heading font-bold text-neutral-950 dark:text-white">
          &copy; {currentYear} Yovan Gunardio Darmawan
        </span>
        <span class="hidden sm:inline select-none text-neutral-400 dark:text-neutral-600" aria-hidden="true">•</span>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-600">
          Map tiles by <a
            href="https://carto.com/attributions"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CARTO map tile attribution (opens in new tab)"
            data-aria-en="CARTO map tile attribution (opens in new tab)"
            data-aria-id="Atribusi ubin peta CARTO (buka di tab baru)"
            class="hover:underline hover:text-neutral-600 dark:hover:text-neutral-300"
            >CARTO</a
          > &copy; <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="OpenStreetMap copyright notice (opens in new tab)"
            data-aria-en="OpenStreetMap copyright notice (opens in new tab)"
            data-aria-id="Pemberitahuan hak cipta OpenStreetMap (buka di tab baru)"
            class="hover:underline hover:text-neutral-600 dark:hover:text-neutral-300"
            >OpenStreetMap</a
          > contributors
        </span>
      </div>

      <!-- Right: Back-to-Top & Subdued Metadata (Zero Duplicates) -->
      <div class="flex items-center justify-center sm:justify-end gap-3 font-mono text-xs">
        <!-- Back to Top -->
        <button
          type="button"
          id="footer-back-to-top"
          aria-label="Back to top"
          class="group inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded px-1.5 py-0.5 cursor-pointer"
        >
          <span data-en="Top" data-id="Atas">Top</span>
          <svg
            class="w-3.5 h-3.5 text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white group-hover:-translate-y-0.5 transition-transform"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 19V5M5 12l7-7 7 7"></path>
          </svg>
        </button>

        <span class="select-none text-neutral-300 dark:text-neutral-700" aria-hidden="true">|</span>

        <!-- Subdued Secondary Metadata -->
        <div class="flex items-center gap-1.5 text-[10px] text-neutral-400 dark:text-neutral-600">
          <span>ASTRO v5</span>
          <span class="select-none">•</span>
          <span>TAILWIND v4</span>
          <span class="select-none">•</span>
          <span>GITHUB PAGES</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const initBackToTop = () => {
      const btn = document.getElementById('footer-back-to-top');
      if (!btn || btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBackToTop);
    } else {
      initBackToTop();
    }
    document.addEventListener('astro:page-load', initBackToTop);
  })();
</script>

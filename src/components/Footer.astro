---
// Footer.astro - Global Systems Footer
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full border-t border-neutral-200 dark:border-neutral-800 bg-[#fcfbf9] dark:bg-[#0e0e0e] text-neutral-600 dark:text-neutral-400 font-sans transition-colors duration-200"
>
  <div class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto py-12 sm:py-16 space-y-12">
    <!-- Top Grid: Brand & Link Groups -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
      <!-- Left Column: Identity -->
      <div class="md:col-span-5 space-y-4">
        <a
          href={`${base}/`}
          aria-label="Home"
          data-aria-en="Home"
          data-aria-id="Beranda"
          class="text-xl font-black tracking-[0.5px] text-neutral-950 dark:text-white font-heading hover:opacity-80 transition-opacity inline-flex items-baseline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
        >
          <span>yovan</span><span class="text-[var(--color-accent,#52FF1A)] ml-[2px]">;</span>
        </a>
        <p
          data-en="Software engineer & systems builder turning ideas into production web apps, touchscreen kiosk platforms, and hardware integrations."
          data-id="Software engineer & pembuat sistem yang mengubah ide menjadi aplikasi web produksi, platform kios layar sentuh, dan integrasi perangkat keras."
          class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 max-w-sm leading-relaxed font-normal"
        >
          Software engineer & systems builder turning ideas into production web
          apps, touchscreen kiosk platforms, and hardware integrations.
        </p>
        <div
          class="flex items-center gap-2 pt-1 text-xs text-neutral-500 dark:text-neutral-400"
        >
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent,#52FF1A)] animate-pulse"></span>
          <span class="font-mono text-[11px]" data-en="AVAILABLE FOR NEW PROJECTS" data-id="TERSEDIA UNTUK PROYEK BARU">AVAILABLE FOR NEW PROJECTS</span>
        </div>
      </div>

      <!-- Right Columns: Navigation & Connect -->
      <div class="md:col-span-7 grid grid-cols-2 gap-8 sm:gap-12">
        <!-- Navigation -->
        <nav aria-label="Footer Navigation" data-aria-en="Footer Navigation" data-aria-id="Navigasi Footer">
          <h3
            class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-950 dark:text-white block m-0 mb-5 sm:mb-6"
            data-en="Navigation"
            data-id="Navigasi"
          >
            Navigation
          </h3>
          <ul class="space-y-2 text-xs list-none p-0 m-0">
            <li>
              <a
                href={`${base}/`}
                data-en="Home"
                data-id="Beranda"
                class="hover:text-neutral-950 dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                Home
              </a>
            </li>
            <li>
              <a
                href={`${base}/#about`}
                data-en="About"
                data-id="Tentang"
                class="hover:text-neutral-950 dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                About
              </a>
            </li>
            <li>
              <a
                href={`${base}/#projects`}
                data-en="Featured Work"
                data-id="Karya Pilihan"
                class="hover:text-neutral-950 dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                Featured Work
              </a>
            </li>
            <li>
              <a
                href={`${base}/portfolio-index`}
                class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                <span data-en="Portfolio Index" data-id="Indeks Portofolio">Portfolio Index</span>
                <span
                  class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500"
                  aria-hidden="true">↗</span
                >
              </a>
            </li>
            <li>
              <a
                href={`${base}/component-library`}
                class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                <span data-en="Component Library" data-id="Pustaka Komponen">Component Library</span>
                <span
                  class="text-[10px] font-mono text-neutral-400 dark:text-neutral-500"
                  aria-hidden="true">↗</span
                >
              </a>
            </li>
          </ul>
        </nav>

        <!-- Connect -->
        <nav aria-label="Connect Links" data-aria-en="Connect Links" data-aria-id="Tautan Kontak">
          <h3
            class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-950 dark:text-white block m-0 mb-5 sm:mb-6"
            data-en="Connect"
            data-id="Kontak"
          >
            Connect
          </h3>
          <ul class="space-y-2 text-xs list-none p-0 m-0">
            <li>
              <a
                href="https://github.com/navoyovan"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub Profile (opens in new tab)"
                data-aria-en="GitHub Profile (opens in new tab)"
                data-aria-id="Profil GitHub (buka di tab baru)"
                class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                <i class="ti ti-brand-github text-sm" aria-hidden="true"></i>
                <span>GitHub</span>
              </a>
            </li>
            <li>
              <a
                href="https://linkedin.com/in/yovan-g-d-22379ba7/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn Profile (opens in new tab)"
                data-aria-en="LinkedIn Profile (opens in new tab)"
                data-aria-id="Profil LinkedIn (buka di tab baru)"
                class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                <i class="ti ti-brand-linkedin text-sm" aria-hidden="true"></i>
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              <a
                href="mailto:yovangunardio@gmail.com"
                aria-label="Send email to Yovan"
                data-aria-en="Send email to Yovan"
                data-aria-id="Kirim email ke Yovan"
                class="hover:text-neutral-950 dark:hover:text-white transition-colors flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                <i class="ti ti-mail text-sm" aria-hidden="true"></i>
                <span>Email</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- Bottom Strip: Copyright & Platform Stack -->
    <div
      class="pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-500"
    >
      <div
        class="flex flex-wrap items-center justify-center md:justify-start gap-x-2 gap-y-1"
      >
        <span class="font-heading font-bold text-neutral-950 dark:text-white">
          Yovan Gunardio Darmawan
        </span>
        <span class="select-none" aria-hidden="true">•</span>
        <span>&copy; {currentYear}</span>
        <span class="hidden sm:inline select-none" aria-hidden="true">•</span>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-600">
          Map tiles by <a
            href="https://carto.com/attributions"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CARTO map tile attribution (opens in new tab)"
            data-aria-en="CARTO map tile attribution (opens in new tab)"
            data-aria-id="Atribusi ubin peta CARTO (buka di tab baru)"
            class="hover:underline hover:text-neutral-600 dark:hover:text-neutral-300"
            >CARTO</a
          > &copy; <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="OpenStreetMap copyright notice (opens in new tab)"
            data-aria-en="OpenStreetMap copyright notice (opens in new tab)"
            data-aria-id="Pemberitahuan hak cipta OpenStreetMap (buka di tab baru)"
            class="hover:underline hover:text-neutral-600 dark:hover:text-neutral-300"
            >OpenStreetMap</a
          > contributors
        </span>
      </div>

      <div class="flex items-center gap-2 font-mono text-[11px]">
        <span>ASTRO v5</span>
        <span class="select-none">•</span>
        <span>TAILWIND v4</span>
        <span class="select-none">•</span>
        <span>GITHUB PAGES</span>
      </div>
    </div>
  </div>
</footer>

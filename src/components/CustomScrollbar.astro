---
// CustomScrollbar.astro - Ported from hype-box
---

<div
  id="custom-scrollbar-track"
  class="fixed right-1 top-20 sm:top-22 bottom-3 w-4 z-40 pointer-events-none md:pointer-events-auto flex justify-end transition-opacity duration-300 opacity-0 md:opacity-100 group cursor-pointer"
  aria-hidden="true"
>
  <div
    id="custom-scrollbar-thumb"
    class="w-1.5 group-hover:w-3.5 group-active:w-3.5 bg-neutral-900/30 dark:bg-white/30 hover:bg-neutral-900/60 dark:hover:bg-white/60 active:bg-neutral-900/80 dark:active:bg-white/80 rounded-full cursor-grab active:cursor-grabbing pointer-events-auto transition-[width,background-color] duration-200"
    style="transform: translateY(0px);"
  >
  </div>
</div>

<script>
  function setupScrollbar() {
    const track = document.getElementById('custom-scrollbar-track');
    const thumb = document.getElementById('custom-scrollbar-thumb');
    if (!track || !thumb) return;

    let isDragging = false;
    let startY = 0;
    let startThumbY = 0;
    let currentThumbY = 0;

    const updateThumb = () => {
      if (isDragging) return;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) {
        track.style.display = 'none';
        return;
      }
      track.style.display = 'flex';

      const trackHeight = track.clientHeight;
      const thumbHeight = Math.max(
        36,
        (window.innerHeight / document.documentElement.scrollHeight) * trackHeight
      );
      thumb.style.height = `${thumbHeight}px`;

      const maxThumbTravel = trackHeight - thumbHeight;
      const scrollY = window.scrollY || 0;
      const progress = Math.min(1, Math.max(0, scrollY / docHeight));
      currentThumbY = progress * maxThumbTravel;

      thumb.style.transform = `translateY(${currentThumbY}px)`;
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateThumb();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    requestAnimationFrame(updateThumb);
    setTimeout(updateThumb, 500);

    // Dragging interaction
    thumb.addEventListener('mousedown', (e) => {
      isDragging = true;
      startY = e.clientY;
      startThumbY = currentThumbY;
      document.documentElement.style.scrollBehavior = 'auto';
      document.body.classList.add('select-none', 'cursor-grabbing');
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const trackHeight = track.clientHeight;
      const thumbHeight = thumb.clientHeight;
      const maxThumbTravel = trackHeight - thumbHeight;
      if (maxThumbTravel <= 0 || docHeight <= 0) return;

      const deltaY = e.clientY - startY;
      const targetThumbY = Math.min(maxThumbTravel, Math.max(0, startThumbY + deltaY));
      currentThumbY = targetThumbY;

      thumb.style.transform = `translateY(${targetThumbY}px)`;
      const progress = targetThumbY / maxThumbTravel;
      const targetScroll = progress * docHeight;

      const lenis = (window as any).__lenis;
      if (lenis) {
        lenis.scrollTo(targetScroll, { immediate: true });
      } else {
        window.scrollTo(0, targetScroll);
      }
    });

    const stopDragging = () => {
      if (isDragging) {
        isDragging = false;
        document.documentElement.style.scrollBehavior = '';
        document.body.classList.remove('select-none', 'cursor-grabbing');
        updateThumb();
      }
    };

    window.addEventListener('mouseup', stopDragging);
    window.addEventListener('blur', stopDragging);

    // Track click to jump
    track.addEventListener('click', (e) => {
      if (e.target === thumb) return;
      const rect = track.getBoundingClientRect();
      const clickY = e.clientY - rect.top;
      const trackHeight = track.clientHeight;
      const thumbHeight = thumb.clientHeight;
      const maxThumbTravel = trackHeight - thumbHeight;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (maxThumbTravel <= 0 || docHeight <= 0) return;

      const targetThumbY = Math.min(maxThumbTravel, Math.max(0, clickY - thumbHeight / 2));
      const targetProgress = targetThumbY / maxThumbTravel;
      const targetScroll = targetProgress * docHeight;

      const lenis = (window as any).__lenis;
      if (lenis) {
        lenis.scrollTo(targetScroll, { duration: 1.0 });
      } else {
        window.scrollTo({ top: targetScroll, behavior: 'smooth' });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupScrollbar);
  } else {
    setupScrollbar();
  }
  document.addEventListener('astro:page-load', setupScrollbar);
</script>

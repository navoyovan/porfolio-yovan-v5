---
import MediaModal from './MediaModal.astro';

interface Props {
  title: string;
  category?: string;
  categoryId?: string;
  description?: string;
  descriptionId?: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  videoSrc?: string;
  iframeSrc?: string;
  iframeScale?: number;
  previewBg?: string;
  status?: string;
  statusId?: string;
  statusVariant?: 'accent' | 'neon' | 'neutral' | 'warning' | 'danger' | 'info';
  tags?: string[];
  actionText?: string;
  actionTextId?: string;
  actionVariant?: 'dashed' | 'solid' | 'cta' | 'danger';
  metaText?: string;
  brand?: 'mctextureghost' | 'hypebox' | string;
  fileName?: string;
  footerName?: string;
  date?: string;
  dateLabel?: string;
  aspect?: string;
  class?: string;
  [key: string]: any;
}

import StatusBadge from './StatusBadge.astro';
import HoverExpandButton from './HoverExpandButton.astro';

const {
  title,
  category = 'FEATURED SYSTEM',
  categoryId,
  description,
  descriptionId,
  href,
  imageSrc,
  imageAlt = title,
  videoSrc,
  iframeSrc,
  iframeScale = 0.28,
  previewBg,
  status,
  statusId,
  statusVariant = 'accent',
  tags = [],
  actionText,
  actionTextId,
  actionVariant = 'solid',
  metaText,
  brand,
  fileName,
  footerName,
  date,
  dateLabel,
  aspect = 'aspect-video',
  class: className = '',
  ...rest
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const displayFooterName = footerName || fileName || metaText;
const displayDate = date || dateLabel;
const isExternal = typeof href === 'string' && href.startsWith('http');
const titleId = `tile-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article
  aria-labelledby={titleId}
  class:list={[
    'group relative flex flex-col bg-[#f6f4ee] dark:bg-[#141414] rounded-md transition-all duration-200 overflow-hidden shadow-sm',
    className
  ]}
  {...rest}
>
  <!-- Media / Viewfinder Container (Adapted from Easter Egg Modal) -->
  <div
    class:list={[
      'tile-media relative w-full overflow-hidden select-none flex items-center justify-center group/media rounded-t-md',
      aspect,
      previewBg ? previewBg : 'bg-neutral-200/60 dark:bg-neutral-900'
    ]}
  >
    {iframeSrc ? (
      <iframe
        src={iframeSrc}
        title={title}
        class="border-0 pointer-events-none select-none shrink-0"
        style={`width: 1440px; height: 855px; transform: scale(${iframeScale}); transform-origin: center center;`}
        loading="lazy"
      />
    ) : videoSrc ? (
      <video
        src={videoSrc}
        loop
        muted
        playsinline
        preload="metadata"
        class="tile-video w-full h-full object-cover"
      />
    ) : imageSrc ? (
      <img
        src={imageSrc}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center relative select-none overflow-hidden" aria-hidden="true">
        <svg class="absolute inset-0 w-full h-full text-neutral-300 dark:text-neutral-800/80" preserveAspectRatio="none" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <line x1="0" y1="100" x2="100" y2="0" stroke="currentColor" stroke-width="0.5" />
        </svg>
      </div>
    )}

    <!-- Fullscreen Button (Bottom Right Square Corners, Top Layer) -->
    {(iframeSrc || videoSrc || imageSrc) && (
      <button
        type="button"
        class="tile-scale-btn absolute bottom-2.5 right-2.5 z-30 p-2 rounded-none bg-neutral-950/85 dark:bg-black/90 backdrop-blur-sm text-white/80 hover:text-[var(--color-accent,#52FF1A)] hover:bg-neutral-900 border border-white/20 dark:border-neutral-700/80 shadow-lg opacity-0 group-hover/media:opacity-100 transition-all duration-200 cursor-pointer flex items-center justify-center select-none"
        aria-label={`View full scale media for ${title}`}
        data-modal-target={`modal-${titleId}`}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M3 8V3h5" />
          <path d="M21 8V3h-5" />
          <path d="M3 16v5h5" />
          <path d="M21 16v5h-5" />
        </svg>
      </button>
    )}

    <!-- Floating Top Status Badge -->
    {status && (
      <div class="absolute top-2.5 left-2.5 z-10">
        <StatusBadge variant={statusVariant} size="sm">
          <span data-en={status} data-id={statusId || status}>{status}</span>
        </StatusBadge>
      </div>
    )}

    <!-- Hovering Holographic Brand Logo Overlay -->
    {brand === 'mctextureghost' ? (
      <div class="tile-hologram-overlay absolute inset-0 z-20 flex items-center justify-center bg-black/45 backdrop-blur-[1.5px] opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none select-none">
        <div class="hologram-content flex items-center gap-2 transform scale-90 group-hover:scale-100 transition-transform duration-300">
          <div class="w-8 h-8 relative shrink-0">
            <img
              src={`${base}/mctextureghost-icon.png`}
              alt=""
              class="absolute -top-2 -left-1 w-14 h-14 max-w-none object-contain pixelated [image-rendering:pixelated] drop-shadow-[0_0_12px_rgba(82,255,26,0.95)] drop-shadow-[0_0_28px_rgba(82,255,26,0.6)]"
            />
          </div>
          <div class="text-xl sm:text-2xl font-bold tracking-[-0.02em] text-white leading-none font-heading inline-flex items-center pl-4 drop-shadow-[0_0_16px_rgba(0,0,0,0.8)]">
            <span>mc</span>
            <span
              class="!text-[#52FF1A]"
              style="color: #52FF1A !important; font-family: 'Press Start 2P', monospace; font-size: 0.74em; margin: 0 3px; transform: translateY(1px); display: inline-block; text-shadow: 0 0 16px rgba(82,255,26,0.85);"
            >Texture</span>
            <span>Ghost</span>
          </div>
        </div>
      </div>
    ) : brand === 'hypebox' ? (
      <div class="tile-hologram-overlay absolute inset-0 z-20 flex items-center justify-center bg-black/45 backdrop-blur-[1.5px] opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none select-none">
        <div class="hologram-content transform scale-90 group-hover:scale-100 transition-transform duration-300">
          <span class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-none font-heading drop-shadow-[0_0_16px_rgba(255,255,255,0.95)] drop-shadow-[0_0_36px_rgba(255,255,255,0.7)]">
            HYPE-BOX
          </span>
        </div>
      </div>
    ) : (brand === 'hero' || brand === 'portfolio' || brand === 'yovan') ? (
      <div class="tile-hologram-overlay absolute inset-0 z-20 flex items-center justify-center bg-black/55 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none select-none">
        <div class="hologram-content hologram-hero select-none flex flex-col leading-none font-heading transform scale-90 group-hover:scale-100 -translate-x-3 sm:-translate-x-4 transition-transform duration-300 pl-4">
          <!-- Row 1: < yovan -->
          <div
            class="relative inline-flex items-baseline whitespace-nowrap leading-[0.9] text-white/95 font-black text-2xl sm:text-3xl"
            style="letter-spacing: -0.04em;"
          >
            <span
              class="absolute right-full mr-1 text-white/50 select-none text-xs sm:text-sm font-black"
              style="bottom: 0.15em;"
            >&lt;</span>
            <span>yovan</span>
          </div>

          <!-- Row 2: gunardio; -->
          <div
            class="inline-flex items-baseline whitespace-nowrap leading-[0.95] text-white/90 font-black text-xl sm:text-2xl"
            style="letter-spacing: -0.03em; margin-top: -0.1rem;"
          >
            <span>gunardio</span>
            <span
              class="text-white/50 text-sm sm:text-base font-black ml-0.5"
            >;</span>
          </div>

          <!-- Row 3: // darmawan /> -->
          <div
            class="relative inline-flex items-baseline whitespace-nowrap leading-none font-normal text-xs sm:text-sm mt-1"
            style="letter-spacing: 0.06em;"
          >
            <span
              class="text-[var(--color-accent,#52FF1A)] opacity-75 mr-1 text-[10px] sm:text-xs font-normal"
            >//</span>
            <span class="text-neutral-300">darmawan</span>
            <span
              class="text-white/50 text-xs sm:text-sm font-black ml-1 select-none"
            >/&gt;</span>
          </div>
        </div>
      </div>
    ) : (
      <slot name="brand" />
    )}
  </div>

  <!-- Content Section (Compact Easter Egg Card Format) -->
  <div class="p-4 sm:p-5 flex flex-col flex-1 gap-3">
    <!-- Category Tag -->
    <p
      data-en={category}
      data-id={categoryId || category}
      class="font-sans text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold m-0"
    >
      {category}
    </p>

    <!-- Newsreader Title -->
    <h3
      id={titleId}
      class:list={[
        "text-xl sm:text-2xl font-semibold text-neutral-950 dark:text-white tracking-tight leading-tight transition-colors font-subheading m-0 flex items-center gap-1.5",
        (brand === 'mctextureghost' || title.toLowerCase().includes('mctextureghost'))
          ? "group-hover:text-[#52FF1A]"
          : "group-hover:text-[var(--color-accent,#52FF1A)]"
      ]}
    >
      <slot name="title">
        {title}
      </slot>
    </h3>

    <!-- Outfit Description -->
    {description && (
      <p
        data-en={description}
        data-id={descriptionId || description}
        class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal m-0 line-clamp-5 h-[calc(1.625em*5)]"
      >
        {description}
      </p>
    )}

    <!-- Tags Row -->
    {tags.length > 0 && (
      <div class="tile-marquee-wrapper relative overflow-hidden min-w-0 pt-1">
        <div class="tile-marquee-track inline-flex items-center">
          <ul class="tile-marquee-content inline-flex items-center gap-1.5 sm:gap-2 list-none p-0 m-0 shrink-0" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <span class="font-sans text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded inline-block">
                  {tag}
                </span>
              </li>
            ))}
            <li class="tile-dot-trailing" aria-hidden="true"></li>
          </ul>
        </div>
      </div>
    )}

    <!-- Action Link / Metadata Footer -->
    <div class="mt-auto pt-3.5 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between gap-3 min-w-0">
      {displayFooterName ? (
        <div class="tile-marquee-wrapper relative overflow-hidden min-w-0 flex-1">
          <div class="tile-marquee-track inline-flex items-center">
            <div class="tile-marquee-content inline-flex items-center text-neutral-400 dark:text-neutral-500 whitespace-nowrap shrink-0 font-mono text-[11px]">
              <span>{displayFooterName}</span>
              <span class="tile-dot-trailing text-neutral-400 dark:text-neutral-600 select-none text-[8px] mx-2.5" aria-hidden="true">
                •
              </span>
            </div>
          </div>
        </div>
      ) : (
        <span></span>
      )}

      {displayDate && (
        <span class="font-mono text-[10px] sm:text-[11px] text-neutral-400 dark:text-neutral-500 whitespace-nowrap shrink-0">
          {displayDate}
        </span>
      )}

      {actionText && (
        <HoverExpandButton
          href={href}
          label={actionText}
          labelEn={actionText}
          labelId={actionTextId || (actionText === 'VIEW CASE STUDY' ? 'LIHAT STUDI KASUS' : actionText === 'VISIT SITE' ? 'KUNJUNGI SITUS' : actionText === 'LAUNCH DEMO' ? 'BUKA DEMO' : actionText === 'VIEW REPO' ? 'LIHAT REPO' : actionText)}
          size="micro"
          variant={actionVariant}
          expandDirection="left"
          rotateIcon={false}
          ariaLabel={`${actionText}: ${title}${isExternal ? ' (opens in new tab)' : ''}`}
          data-aria-en={`${actionText}: ${title}${isExternal ? ' (opens in new tab)' : ''}`}
          data-aria-id={`${actionTextId || actionText}: ${title}${isExternal ? ' (buka di tab baru)' : ''}`}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class="shrink-0 ml-auto z-10"
        >
          <svg
            slot="icon"
            class="w-3.5 h-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {isExternal ? (
              <>
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M17 7l-10 10" />
                <path d="M8 7l9 0l0 9" />
              </>
            ) : (
              <>
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </>
            )}
          </svg>
        </HoverExpandButton>
      )}
    </div>
  </div>
</article>

<MediaModal
  id={`modal-${titleId}`}
  title={title}
  videoSrc={videoSrc}
  imageSrc={imageSrc}
  imageAlt={imageAlt}
  iframeSrc={iframeSrc}
/>

<style is:global>

  @keyframes tile-marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .tile-marquee-wrapper:not(.is-overflowing) .tile-dot-trailing {
    display: none !important;
  }

  .tile-marquee-wrapper.is-overflowing {
    mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 24px, black calc(100% - 24px), transparent 100%);
  }

  .tile-marquee-track {
    display: inline-flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-marquee-track {
      animation: none !important;
      transform: none !important;
    }
    .tile-marquee-wrapper {
      mask-image: none !important;
      -webkit-mask-image: none !important;
      overflow-x: auto !important;
    }
  }

  /* Touch Interaction for Mobile Viewfinder */
  .tile-media.is-touch-active .tile-hologram-overlay {
    opacity: 1 !important;
  }
  .tile-media.is-touch-active .tile-hologram-overlay .hologram-content {
    transform: scale(1) !important;
  }
  .tile-media.is-touch-active .tile-hologram-overlay .hologram-hero {
    transform: scale(1) translateX(-0.75rem) !important;
  }
  @media (min-width: 640px) {
    .tile-media.is-touch-active .tile-hologram-overlay .hologram-hero {
      transform: scale(1) translateX(-1rem) !important;
    }
  }
  .tile-media.is-touch-active .tile-scale-btn {
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>

<script>
  function initTileMarquees(targetContainer?: HTMLElement | Document) {
    const root = targetContainer || document;
    const wrappers = root.querySelectorAll<HTMLElement>(".tile-marquee-wrapper");

    wrappers.forEach((wrapper) => {
      const track = wrapper.querySelector<HTMLElement>(".tile-marquee-track");
      const content = wrapper.querySelector<HTMLElement>(".tile-marquee-content");

      if (!track || !content) return;

      const containerWidth = wrapper.clientWidth;
      if (containerWidth === 0) return;

      const existingClone = track.querySelector(".tile-marquee-clone");
      if (existingClone) {
        existingClone.remove();
      }
      wrapper.classList.remove("is-overflowing");
      track.style.animation = "none";

      const contentWidth = content.scrollWidth;

      if (contentWidth > containerWidth + 2) {
        wrapper.classList.add("is-overflowing");

        const clone = content.cloneNode(true) as HTMLElement;
        clone.classList.add("tile-marquee-clone");
        clone.setAttribute("aria-hidden", "true");
        track.appendChild(clone);

        const duration = Math.max(8, contentWidth / 26);
        track.style.animationName = "tile-marquee-scroll";
        track.style.animationDuration = `${duration}s`;
        track.style.animationTimingFunction = "linear";
        track.style.animationIterationCount = "infinite";

        const trigger = wrapper.closest(".group") || wrapper;
        if (!(trigger as any)._hasTileMarqueeHover) {
          (trigger as any)._hasTileMarqueeHover = true;
          const slowDown = () => easeMarqueeRate(track, 0.22, 600);
          const speedUp = () => easeMarqueeRate(track, 1.0, 600);
          trigger.addEventListener("mouseenter", slowDown);
          trigger.addEventListener("mouseleave", speedUp);
          trigger.addEventListener("focusin", slowDown);
          trigger.addEventListener("focusout", speedUp);
        }
      }
    });
  }

  function easeMarqueeRate(track: HTMLElement, targetRate: number, durationMs = 600) {
    const anims = track.getAnimations();
    if (!anims.length) return;
    const anim = anims[0];
    const startRate = anim.playbackRate;
    const startTime = performance.now();
    const trackAny = track as any;
    if (trackAny._rateRaf) cancelAnimationFrame(trackAny._rateRaf);

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / durationMs, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      anim.playbackRate = startRate + (targetRate - startRate) * eased;
      if (progress < 1) {
        trackAny._rateRaf = requestAnimationFrame(step);
      } else {
        trackAny._rateRaf = null;
      }
    }
    trackAny._rateRaf = requestAnimationFrame(step);
  }

  let tileVideoObserver: IntersectionObserver | null = null;

  function initTileVideoAutoplay() {
    if (tileVideoObserver) {
      tileVideoObserver.disconnect();
      tileVideoObserver = null;
    }

    const videos = document.querySelectorAll<HTMLVideoElement>('video.tile-video');
    if (!videos.length) return;

    if (!('IntersectionObserver' in window)) {
      videos.forEach(v => v.play().catch(() => {}));
      return;
    }

    tileVideoObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        // Only autoplay when visible within screen and containing scroll boundaries
        if (entry.isIntersecting && entry.intersectionRatio >= 0.15) {
          if (video.paused) {
            video.play().catch(() => {});
          }
        } else {
          if (!video.paused) {
            video.pause();
          }
        }
      });
    }, {
      root: null, // Viewport (automatically handles window scroll + horizontal container overflow)
      threshold: [0, 0.15, 0.5]
    });

    videos.forEach(video => {
      tileVideoObserver?.observe(video);
    });
  }

  function initTileModals() {
    document.querySelectorAll('.tile-scale-btn').forEach(btn => {
      // Remove old listeners to prevent duplicates on navigation
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetId = (newBtn as HTMLElement).getAttribute('data-modal-target');
        if (!targetId) return;
        const dialog = document.getElementById(targetId) as HTMLDialogElement;
        if (dialog) {
          dialog.showModal();
          dialog.style.transform = 'none';

          const modalVideo = dialog.querySelector<HTMLVideoElement>('video.tile-modal-video');
          if (modalVideo) {
            modalVideo.currentTime = 0;
            modalVideo.play().catch(() => {});
          }
        }
      });
    });

    document.querySelectorAll('.tile-modal').forEach(dialog => {
      const d = dialog as HTMLDialogElement;
      const closeModal = (modal: HTMLDialogElement) => {
        if (!modal.hasAttribute('open')) return;
        modal.classList.add('is-closing');

        const modalVideo = modal.querySelector<HTMLVideoElement>('video.tile-modal-video');
        if (modalVideo) {
          modalVideo.pause();
        }

        setTimeout(() => {
          modal.close();
          modal.classList.remove('is-closing');
          modal.style.transition = 'none';
          modal.style.transform = 'none';
          setTimeout(() => {
            modal.style.transition = '';
          }, 50);
        }, 200);
      };

      const closeBtn = d.querySelector('.tile-modal-close');
      if (closeBtn) {
        const newCloseBtn = closeBtn.cloneNode(true);
        closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);
        newCloseBtn.addEventListener('click', () => closeModal(d));
      }

      d.addEventListener('click', (e) => {
        if (e.target === d) {
          closeModal(d);
        }
      });
      
      d.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeModal(d);
      });

      let touchStartY = 0;
      let currentY = 0;
      
      d.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
        d.classList.remove('is-closing');
      }, { passive: false });

      d.addEventListener('touchmove', (e) => {
        if (touchStartY === 0) return;
        currentY = e.touches[0].clientY;
        const diff = currentY - touchStartY;
        if (diff > 0) {
          e.preventDefault(); // Stop page scrolling / pull-to-refresh
          d.classList.add('is-dragging');
          d.style.transition = 'none';
          d.style.transform = `translateY(${diff}px) scale(1)`;

          // Progress scales down from 1 (at 0px) to 0 (at 220px drag)
          const maxDrag = Math.min(window.innerHeight * 0.4, 220);
          const progress = Math.max(0, Math.min(1, 1 - (diff / maxDrag)));
          d.style.setProperty('--backdrop-progress', progress.toFixed(3));
        }
      }, { passive: false });

      const handleTouchEnd = () => {
        if (touchStartY === 0) return;
        const diff = currentY - touchStartY;
        d.classList.remove('is-dragging');

        if (diff > 100) {
          d.style.transition = 'transform 0.2s ease-out, opacity 0.2s ease-out';
          d.style.transform = 'translateY(100vh) scale(0.95)';
          d.style.opacity = '0';
          d.style.setProperty('--backdrop-progress', '0');

          const modalVideo = d.querySelector<HTMLVideoElement>('video.tile-modal-video');
          if (modalVideo) {
            modalVideo.pause();
          }

          setTimeout(() => {
            d.close();
            d.style.transition = '';
            d.style.transform = '';
            d.style.opacity = '';
            d.style.removeProperty('--backdrop-progress');
          }, 200);
        } else {
          d.style.transition = 'transform 0.2s cubic-bezier(0.16, 1, 0.3, 1)';
          d.style.transform = 'translateY(0) scale(1)';
          d.style.setProperty('--backdrop-progress', '1');
          setTimeout(() => {
            d.style.transition = '';
            d.style.removeProperty('--backdrop-progress');
          }, 200);
        }
        touchStartY = 0;
        currentY = 0;
      };

      d.addEventListener('touchend', handleTouchEnd);
      d.addEventListener('touchcancel', handleTouchEnd);
    });
  }

  function initTileTouchInteraction() {
    const mediaContainers = document.querySelectorAll<HTMLElement>('.tile-media');

    mediaContainers.forEach((media) => {
      if (media.dataset.touchInit === 'true') return;
      media.dataset.touchInit = 'true';

      let touchTimer: number | null = null;

      media.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest('.tile-scale-btn')) {
          return;
        }

        const isCurrentlyActive = media.classList.contains('is-touch-active');

        document.querySelectorAll<HTMLElement>('.tile-media.is-touch-active').forEach((other) => {
          if (other !== media) {
            other.classList.remove('is-touch-active');
          }
        });

        if (isCurrentlyActive) {
          media.classList.remove('is-touch-active');
          if (touchTimer) clearTimeout(touchTimer);
        } else {
          media.classList.add('is-touch-active');
          if (touchTimer) clearTimeout(touchTimer);
          touchTimer = window.setTimeout(() => {
            media.classList.remove('is-touch-active');
          }, 4500);
        }
      });
    });

    if (!(window as any).__tileTouchDocInit) {
      (window as any).__tileTouchDocInit = true;
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target?.closest('.tile-media')) {
          document.querySelectorAll<HTMLElement>('.tile-media.is-touch-active').forEach((media) => {
            media.classList.remove('is-touch-active');
          });
        }
      });
    }
  }

  if (typeof window !== "undefined") {
    let resizeTimer: number | null = null;
    let lastWidth = window.innerWidth;

    const onResize = () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        initTileMarquees();
        initTileVideoAutoplay();
      }, 150);
    };

    const initAll = () => {
      initTileMarquees();
      initTileModals();
      initTileVideoAutoplay();
      initTileTouchInteraction();
    };

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        document.querySelectorAll<HTMLVideoElement>('video.tile-video, video.tile-modal-video').forEach(v => {
          if (!v.paused) v.pause();
        });
      } else {
        initTileVideoAutoplay();
      }
    });

    document.addEventListener("DOMContentLoaded", initAll);
    window.addEventListener("resize", onResize, { passive: true });
    document.addEventListener("astro:page-load", initAll);
    initAll();
  }
</script>

---
// LangSwitcher.astro - Navbar-matched Language Switcher Dropdown (EN / ID)
// Matches the exact typography (Syne font-heading) & backdrop structure of the Navbar dropdown.
interface Props {
  id?: string;
  dropDirection?: 'down' | 'up';
  class?: string;
}

const {
  id = `ls-${Math.random().toString(36).substring(2, 9)}`,
  dropDirection = 'down',
  class: className = '',
} = Astro.props;

const isUp = dropDirection === 'up';
---

<div
  id={id}
  class:list={['lang-switcher-wrapper relative inline-block text-left select-none', className]}
  data-lang-switcher-wrapper
  data-direction={dropDirection}
>
  <!-- Trigger Button: Pure text button without bordered pill outline or button frame -->
  <button
    type="button"
    id={`${id}-trigger`}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Select language"
    class="lang-trigger group/nav-lang relative inline-flex items-center text-xs tracking-wider font-medium transition-colors text-neutral-500 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white cursor-pointer select-none gap-1 bg-transparent border-0 p-0 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-950 dark:focus-visible:ring-white"
  >
    <!-- Current Code in Satoshi / Sans -->
    <span class="lang-current-label font-sans font-medium tracking-wider">EN</span>

    <!-- Arrow Indicator -->
    <span
      class:list={[
        'lang-arrow inline-flex items-center justify-center text-[10px] text-neutral-500 dark:text-neutral-400 group-hover/nav-lang:text-neutral-950 dark:group-hover/nav-lang:text-white transition-[opacity,transform] duration-200 ease-out',
        isUp ? 'rotate-180' : ''
      ]}
      aria-hidden="true"
    >
      ↓
    </span>
  </button>

  <!-- Dropdown Menu -->
  <div
    id={`${id}-menu`}
    role="menu"
    aria-label="Language Options"
    class:list={[
      'lang-menu absolute right-0 min-w-[140px] bg-[#fcfbf9]/98 dark:bg-[#141414]/98 backdrop-blur-xl border border-neutral-200/80 dark:border-neutral-800 rounded-xl shadow-xl dark:shadow-2xl p-1 z-50 opacity-0 pointer-events-none transition-[opacity,transform] duration-150 ease-out will-change-[transform,opacity] flex flex-col gap-0.5',
      isUp
        ? 'bottom-full mb-2 origin-bottom translate-y-1'
        : 'top-full mt-2 origin-top -translate-y-1'
    ]}
  >
    <ul class="flex flex-col gap-0.5 list-none m-0 p-0" role="none">
      <!-- English Option -->
      <li role="none">
        <button
          type="button"
          role="menuitem"
          data-lang-option="en"
          class="lang-item flex items-center justify-between px-3 py-2 text-xs font-sans text-neutral-600 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/60 rounded-lg transition-colors text-left w-full cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-950 dark:focus-visible:ring-white border-0 bg-transparent"
        >
          <span>English</span>
          <span class="text-[11px] text-neutral-400 dark:text-neutral-500">EN</span>
        </button>
      </li>

      <!-- Indonesian Option -->
      <li role="none">
        <button
          type="button"
          role="menuitem"
          data-lang-option="id"
          class="lang-item flex items-center justify-between px-3 py-2 text-xs font-sans text-neutral-600 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800/60 rounded-lg transition-colors text-left w-full cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-950 dark:focus-visible:ring-white border-0 bg-transparent"
        >
          <span>Indonesia</span>
          <span class="text-[11px] text-neutral-400 dark:text-neutral-500">ID</span>
        </button>
      </li>
    </ul>
  </div>
</div>

<script>
  function setupLangDropdowns() {
    document.querySelectorAll<HTMLElement>('[data-lang-switcher-wrapper]').forEach((wrapper) => {
      if (wrapper.dataset.initialized === 'true') return;
      wrapper.dataset.initialized = 'true';

      const isUp = wrapper.dataset.direction === 'up';
      const trigger = wrapper.querySelector<HTMLButtonElement>('.lang-trigger');
      const menu = wrapper.querySelector<HTMLElement>('.lang-menu');
      const arrow = wrapper.querySelector<HTMLElement>('.lang-arrow');
      const items = wrapper.querySelectorAll<HTMLButtonElement>('.lang-item');

      if (!trigger || !menu) return;

      const setOpen = (open: boolean) => {
        if (open) {
          // Close other open menus
          document.querySelectorAll('.lang-menu.is-open').forEach((m) => {
            if (m !== menu) {
              const otherUp = (m.closest('[data-direction]') as HTMLElement)?.dataset?.direction === 'up';
              (m as HTMLElement).style.transitionDuration = '100ms';
              m.classList.remove('is-open', 'opacity-100', 'translate-y-0', 'pointer-events-auto');
              m.classList.add('opacity-0', 'pointer-events-none', otherUp ? 'translate-y-1' : '-translate-y-1');
              const otherTrigger = m.closest('.lang-switcher-wrapper')?.querySelector<HTMLButtonElement>('.lang-trigger');
              if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
            }
          });

          menu.style.transitionDuration = '160ms';
          menu.style.transitionTimingFunction = 'cubic-bezier(0.16, 1, 0.3, 1)';
          menu.classList.remove('opacity-0', 'pointer-events-none', isUp ? 'translate-y-1' : '-translate-y-1');
          menu.classList.add('is-open', 'opacity-100', 'translate-y-0', 'pointer-events-auto');
          trigger.setAttribute('aria-expanded', 'true');
          if (arrow) {
            arrow.classList.add(isUp ? 'rotate-0' : 'rotate-180');
          }
          items.forEach((item) => item.removeAttribute('tabindex'));
        } else {
          menu.style.transitionDuration = '100ms';
          menu.style.transitionTimingFunction = 'cubic-bezier(0.4, 0, 1, 1)';
          menu.classList.remove('is-open', 'opacity-100', 'translate-y-0', 'pointer-events-auto');
          menu.classList.add('opacity-0', 'pointer-events-none', isUp ? 'translate-y-1' : '-translate-y-1');
          trigger.setAttribute('aria-expanded', 'false');
          if (arrow) {
            arrow.classList.remove(isUp ? 'rotate-0' : 'rotate-180');
          }
          items.forEach((item) => item.setAttribute('tabindex', '-1'));
        }
      };

      // Initial state
      setOpen(false);

      trigger.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = menu.classList.contains('is-open');
        setOpen(!isOpen);
      };

      items.forEach((item) => {
        item.onclick = (e) => {
          e.stopPropagation();
          const targetLang = item.getAttribute('data-lang-option');
          if (targetLang && (window as any).__setPortfolioLang) {
            (window as any).__setPortfolioLang(targetLang);
          }
          setOpen(false);
          trigger.focus();
        };
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.lang-menu.is-open').forEach((menu) => {
        const wrapper = menu.closest<HTMLElement>('.lang-switcher-wrapper');
        const isUp = wrapper?.dataset.direction === 'up';
        menu.classList.remove('is-open', 'opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
        menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none', isUp ? 'translate-y-2' : '-translate-y-2');
        const trigger = wrapper?.querySelector<HTMLButtonElement>('.lang-trigger');
        const arrow = wrapper?.querySelector<HTMLElement>('.lang-arrow');
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        if (arrow) arrow.classList.remove(isUp ? 'rotate-0' : 'rotate-180');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll<HTMLElement>('.lang-menu.is-open').forEach((menu) => {
          const wrapper = menu.closest<HTMLElement>('.lang-switcher-wrapper');
          const isUp = wrapper?.dataset.direction === 'up';
          menu.classList.remove('is-open', 'opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
          menu.classList.add('opacity-0', 'scale-95', 'pointer-events-none', isUp ? 'translate-y-2' : '-translate-y-2');
          const trigger = wrapper?.querySelector<HTMLButtonElement>('.lang-trigger');
          const arrow = wrapper?.querySelector<HTMLElement>('.lang-arrow');
          if (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
            trigger.focus();
          }
          if (arrow) arrow.classList.remove(isUp ? 'rotate-0' : 'rotate-180');
        });
      }
    });

    // Sync initial state
    const currentLang = document.documentElement.lang || 'en';
    if ((window as any).__setPortfolioLang) {
      (window as any).__setPortfolioLang(currentLang);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLangDropdowns);
  } else {
    setupLangDropdowns();
  }
  document.addEventListener('astro:page-load', setupLangDropdowns);
</script>

---
import ActionButton from './ActionButton.astro';
import LangSwitcher from './LangSwitcher.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const homeHref = `${base}/` || '/';
const pathname = Astro.url.pathname.replace(/\/$/, '') || homeHref;

const navItems = [
  { label: 'Home', href: homeHref },
  { label: 'Component Library', href: `${base}/component-library` },
  { label: 'Portfolio Index', href: `${base}/portfolio-index` },
];

const homeNavItems = [
  { label: 'Overview', href: `${base}/#intro`, number: '01' },
  { label: 'Featured Work', href: `${base}/#projects`, number: '02' },
  { label: 'What I Can Build', href: `${base}/#capabilities`, number: '03' },
  { label: 'Philosophy', href: `${base}/#philosophy`, number: '04' },
  { label: 'About', href: `${base}/#about`, number: '05' },
  { label: 'Contact', href: `${base}/#contact`, number: '06' },
];

const componentLibraryNavItems = [
  { label: 'Foundations', href: `${base}/component-library#foundations`, number: '01' },
  { label: 'Interaction Primitives', href: `${base}/component-library#interaction-primitives`, number: '02' },
  { label: 'Feedback & Status', href: `${base}/component-library#feedback-status`, number: '03' },
  { label: 'System & Data Viz', href: `${base}/component-library#system-data-viz`, number: '04' },
];

const portfolioIndexNavItems = [
  { label: 'HYPE-BOX Ecosystem', href: `${base}/portfolio-index#hypebox-ecosystem`, number: '01' },
  { label: 'mcTextureGhost Suite', href: `${base}/portfolio-index#mctextureghost-suite`, number: '02' },
  { label: 'Other Systems', href: `${base}/portfolio-index#other-systems`, number: '03' },
];

const secondaryNavItems = [
  { label: 'Home', href: homeHref },
  { label: 'Component Library', href: `${base}/component-library` },
  { label: 'Portfolio Index', href: `${base}/portfolio-index` },
];

const isComponentLibrary = pathname.includes('/component-library');
const isPortfolioIndex = pathname.includes('/portfolio-index');

let currentPageTitle = '// Home';
let currentSectionItems = homeNavItems;

if (isComponentLibrary) {
  currentPageTitle = '// Component Library';
  currentSectionItems = componentLibraryNavItems;
} else if (isPortfolioIndex) {
  currentPageTitle = '// Portfolio Index';
  currentSectionItems = portfolioIndexNavItems;
}
---

<header
  class="w-full border-b border-neutral-200/80 bg-[#fcfbf9]/90 dark:border-neutral-800/80 dark:bg-[#0e0e0e]/90 sticky top-0 z-50 transition-colors duration-200"
  style="-webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);"
>
  <div class="w-full px-4 sm:px-6 md:px-8 lg:px-10 h-16 sm:h-18 flex items-center justify-between">
    <div class="flex items-center">
      <!-- Logo -->
      <a
        id="navbar-logo"
        href={homeHref}
        aria-label="Home"
        class="text-base sm:text-lg md:text-xl font-black tracking-[0.5px] text-neutral-950 dark:text-white hover:opacity-80 transition-opacity font-heading cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded inline-flex items-baseline"
      >
        <span>yovan</span><span class="text-[var(--color-accent,#52FF1A)] ml-[2px]">;</span>
      </a>
    </div>

    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Desktop Navigation -->
      <nav aria-label="Main Navigation" class="hidden md:block">
        <ul class="flex items-center gap-1.5 sm:gap-2">
          {navItems.map((item) => {
            const itemPath = item.href.replace(/\/$/, '');
            const normalizedPathname = pathname.replace(/\/$/, '');
            const isActive = normalizedPathname === itemPath || (item.href !== homeHref && normalizedPathname.startsWith(itemPath));
            return (
              <li class={isActive ? 'relative' : undefined}>
                {isActive ? (
                  <>
                    <button
                      type="button"
                      id="desktop-active-nav-btn"
                      aria-label={`${item.label} navigation menu, currently active. Click to view sections`}
                      aria-expanded="false"
                      aria-haspopup="true"
                      aria-controls="desktop-sections-dropdown"
                      class="group/nav-active relative inline-flex items-center justify-center text-xs sm:text-sm font-medium px-3.5 py-2 rounded-md transition-[background-color,color,border-color] duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] text-neutral-950 dark:text-white bg-neutral-100 dark:bg-neutral-900 font-semibold cursor-pointer select-none overflow-hidden"
                      aria-current="page"
                    >
                      <div
                        id="desktop-nav-content"
                        class="inline-flex items-center translate-x-[10px] group-hover/nav-active:translate-x-0 transition-transform duration-200 ease-out"
                      >
                        <span>{item.label}</span>
                        <span
                          id="desktop-nav-arrow"
                          class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover/nav-active:opacity-100 transition-[opacity,transform] duration-200 ease-out text-neutral-500 dark:text-neutral-400 group-hover/nav-active:text-neutral-950 dark:group-hover/nav-active:text-white"
                          aria-hidden="true"
                        >
                          ↓
                        </span>
                      </div>
                    </button>

                    <!-- Desktop Sections Dropdown Menu -->
                    <div
                      id="desktop-sections-dropdown"
                      role="menu"
                      aria-label={`${item.label} Sections`}
                      class="absolute top-full left-0 mt-2 min-w-[270px] sm:min-w-[290px] bg-[#fcfbf9]/95 dark:bg-[#0e0e0e]/95 backdrop-blur-xl border border-neutral-200/90 dark:border-neutral-800/90 rounded-lg shadow-xl dark:shadow-2xl p-1.5 z-50 opacity-0 -translate-y-2 scale-95 pointer-events-none transition-[opacity,transform] duration-200 ease-out origin-top flex flex-col gap-1"
                    >
                      <div class="px-3 pt-2 pb-1 text-[10px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-semibold border-b border-neutral-200/60 dark:border-neutral-800/60 select-none">
                        {currentPageTitle}
                      </div>
                      <ul class="flex flex-col gap-0.5 list-none m-0 p-0" role="none">
                        {currentSectionItems.map((section) => (
                          <li role="none">
                            <a
                              href={section.href}
                              role="menuitem"
                              class="desktop-section-link group flex items-center justify-between px-3 py-2 text-xs font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 rounded transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] whitespace-nowrap gap-4"
                            >
                              <span>{section.label}</span>
                              <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-600 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors">
                                {section.number}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                ) : (
                  <a
                    href={item.href}
                    class="text-xs sm:text-sm font-medium px-3.5 py-2 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white hover:bg-neutral-50 dark:hover:bg-neutral-900/50"
                  >
                    {item.label}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="hidden md:block h-4 w-px bg-neutral-200 dark:bg-neutral-800 mx-1"></div>

      <!-- Theme Toggle Button -->
      <ActionButton
        id="theme-toggle"
        variant="ghost"
        size="micro"
        ariaLabel="Toggle light/dark theme"
      >
        <!-- Sun Icon (shown in dark mode to switch to light) -->
        <svg
          id="theme-toggle-sun"
          aria-hidden="true"
          class="w-4 h-4 hidden dark:block"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon Icon (shown in light mode to switch to dark) -->
        <svg
          id="theme-toggle-moon"
          aria-hidden="true"
          class="w-4 h-4 block dark:hidden"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </ActionButton>

      <!-- Language Switcher (Desktop / Tablet) -->
      <LangSwitcher id="desktop-lang-switcher" class="hidden sm:inline-flex" />

      <!-- Mobile Menu Button (Positioned on the RIGHT) -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Toggle Mobile Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 cursor-pointer relative z-50 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
      >
        <span
          id="mobile-bar-1"
          class="w-6 h-[2px] bg-neutral-950 dark:bg-white transition-transform duration-300 origin-center"
        ></span>
        <span
          id="mobile-bar-2"
          class="w-6 h-[2px] bg-neutral-950 dark:bg-white transition-transform duration-300 origin-center"
        ></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Alpha transparency matching navbar header) -->
  <div
    id="mobile-menu-drawer"
    aria-hidden="true"
    class="md:hidden absolute top-full left-0 w-full bg-[#fcfbf9]/95 dark:bg-[#0e0e0e]/95 border-b border-neutral-300/80 dark:border-neutral-800/80 shadow-2xl transition-all duration-300 ease-out -translate-y-4 opacity-0 pointer-events-none z-50 max-h-[calc(100dvh-4.5rem)] overflow-y-auto"
  >
    <nav aria-label="Mobile Navigation" class="px-6 py-6 sm:py-8 flex flex-col gap-5 text-left items-start">
      <!-- Current Page Navigation Sections -->
      <div class="w-full flex flex-col gap-2">
        <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none">
          {currentPageTitle}
        </span>
        <ul class="w-full flex flex-col gap-1 list-none m-0 p-0" aria-label="Page Sections">
          {currentSectionItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile-nav-link group flex items-center justify-between py-1.5 text-sm sm:text-base font-heading font-bold uppercase tracking-tight text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white transition-colors text-left w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              >
                <span>{item.label}</span>
                <span class="text-[10px] font-mono text-neutral-400 dark:text-neutral-600 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors">
                  {item.number}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Divider -->
      <div class="w-full h-px bg-neutral-200/80 dark:bg-neutral-800/80 my-0.5"></div>

      <!-- Pages Section -->
      <div class="w-full flex flex-col gap-2">
        <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 select-none">
          // Pages
        </span>
        <ul class="w-full flex flex-col gap-1 list-none m-0 p-0" aria-label="Additional Pages">
          {secondaryNavItems.map((item) => {
            const itemPath = item.href.replace(/\/$/, '');
            const normalizedPathname = pathname.replace(/\/$/, '');
            const isActive = normalizedPathname === itemPath || (item.href !== homeHref && normalizedPathname.startsWith(itemPath));
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'mobile-nav-link group flex items-center justify-between py-1.5 text-sm sm:text-base font-heading font-bold uppercase tracking-tight transition-colors text-left w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded',
                    isActive
                      ? 'text-neutral-950 dark:text-white font-black'
                      : 'text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                  <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors">
                    →
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Contact Links (Left) & Fullscreen Toggle (Right) -->
      <div class="w-full mt-6 pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400 font-mono">
        <div class="flex items-center gap-6 sm:gap-8">
          <a
            href="https://github.com/navoyovan"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-neutral-950 dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded py-0.5"
            aria-label="GitHub Profile (opens in new tab)"
            data-aria-en="GitHub Profile (opens in new tab)"
            data-aria-id="Profil GitHub (buka di tab baru)"
          >
            GitHub
          </a>
          <a
            href="https://linkedin.com/in/yovan-g-d-22379ba7/"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-neutral-950 dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded py-0.5"
            aria-label="LinkedIn Profile (opens in new tab)"
            data-aria-en="LinkedIn Profile (opens in new tab)"
            data-aria-id="Profil LinkedIn (buka di tab baru)"
          >
            LinkedIn
          </a>
        </div>

        <div class="flex items-center gap-3">
          <LangSwitcher id="mobile-lang-switcher" dropDirection="up" />
          <button
            id="mobile-fullscreen-toggle"
            type="button"
            aria-label="Toggle Fullscreen Mode"
            data-aria-en="Toggle Fullscreen Mode"
            data-aria-id="Mode Layar Penuh"
            aria-pressed="false"
            class="px-2 py-1 -mr-1 rounded hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-200/50 dark:hover:bg-neutral-800/50 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
          >
            <span id="fullscreen-text" data-en="Fullscreen" data-id="Layar Penuh" class="text-xs uppercase tracking-wider">Fullscreen</span>
          </button>
        </div>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu Dark Backdrop Overlay -->
  <div
    id="mobile-menu-backdrop"
    aria-hidden="true"
    class="md:hidden fixed inset-0 bg-black/75 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none z-40"
    style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;"
  ></div>
</header>

<script>
  const setupLogoScroll = () => {
    const logo = document.getElementById('navbar-logo');
    if (!logo) return;

    logo.addEventListener('click', (e) => {
      const rawBase = import.meta.env.BASE_URL;
      const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
      const homePath = (base || '').replace(/\/$/, '');
      const currentPath = window.location.pathname.replace(/\/$/, '');

      if (currentPath === homePath || currentPath === '') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  };

  const setupThemeToggle = () => {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    const updateAria = () => {
      const isDark = document.documentElement.classList.contains('dark');
      const isId = document.documentElement.lang === 'id';
      toggleBtn.setAttribute('aria-pressed', String(isDark));
      
      const ariaEn = isDark ? 'Switch to light theme' : 'Switch to dark theme';
      const ariaId = isDark ? 'Beralih ke mode terang' : 'Beralih ke mode gelap';
      toggleBtn.setAttribute('data-aria-en', ariaEn);
      toggleBtn.setAttribute('data-aria-id', ariaId);
      toggleBtn.setAttribute('aria-label', isId ? ariaId : ariaEn);
    };

    updateAria();
    window.addEventListener('portfolio:lang-change', updateAria);

    toggleBtn.onclick = () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      updateAria();
    };
  };

  const setupMobileMenu = () => {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const bar1 = document.getElementById('mobile-bar-1');
    const bar2 = document.getElementById('mobile-bar-2');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !drawer || !bar1 || !bar2) return;

    // Attach backdrop directly to body to escape any header containing block clipping
    if (backdrop && backdrop.parentElement !== document.body) {
      document.body.appendChild(backdrop);
    }

    let isOpen = false;

    const updateToggleAria = () => {
      const isId = document.documentElement.lang === 'id';
      const ariaEn = isOpen ? 'Close Navigation Menu' : 'Open Navigation Menu';
      const ariaId = isOpen ? 'Tutup Menu Navigasi' : 'Buka Menu Navigasi';
      toggleBtn.setAttribute('data-aria-en', ariaEn);
      toggleBtn.setAttribute('data-aria-id', ariaId);
      toggleBtn.setAttribute('aria-label', isId ? ariaId : ariaEn);
    };

    const getFocusableInDrawer = (): HTMLElement[] => {
      return Array.from(
        drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter(el => !el.hasAttribute('disabled') && el.offsetParent !== null);
    };

    const updateDrawerTabIndex = (open: boolean) => {
      const focusables = drawer.querySelectorAll<HTMLElement>('a, button');
      focusables.forEach((el) => {
        if (open) {
          el.removeAttribute('tabindex');
        } else {
          el.setAttribute('tabindex', '-1');
        }
      });
    };

    // Initial state: drawer elements are not focusable
    updateDrawerTabIndex(false);

    const setMenuState = (open: boolean) => {
      isOpen = open;
      toggleBtn.setAttribute('aria-expanded', open.toString());
      updateToggleAria();
      drawer.setAttribute('aria-hidden', (!open).toString());
      updateDrawerTabIndex(open);

      if (open) {
        drawer.classList.remove('-translate-y-4', 'opacity-0', 'pointer-events-none');
        drawer.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        if (backdrop) {
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100', 'pointer-events-auto');
        }
        bar1.style.transform = 'translateY(4px) rotate(45deg)';
        bar2.style.transform = 'translateY(-4px) rotate(-45deg)';

        requestAnimationFrame(() => {
          const focusables = getFocusableInDrawer();
          if (focusables.length > 0) {
            focusables[0].focus();
          }
        });
      } else {
        drawer.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        drawer.classList.add('-translate-y-4', 'opacity-0', 'pointer-events-none');
        if (backdrop) {
          backdrop.classList.remove('opacity-100', 'pointer-events-auto');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
        }
        bar1.style.transform = 'none';
        bar2.style.transform = 'none';
      }
    };

    toggleBtn.onclick = (e) => {
      e.stopPropagation();
      setMenuState(!isOpen);
    };

    // Close when clicking backdrop
    if (backdrop) {
      backdrop.onclick = (e) => {
        e.stopPropagation();
        setMenuState(false);
        toggleBtn.focus();
      };
    }

    // Close when clicking links and handle same-page smooth scroll
    mobileLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href) {
          const hashIndex = href.indexOf('#');
          if (hashIndex !== -1) {
            const hash = href.slice(hashIndex);
            const targetEl = document.querySelector(hash);
            if (targetEl) {
              e.preventDefault();
              targetEl.scrollIntoView({ behavior: 'smooth' });
              history.pushState(null, '', hash);
            }
          }
        }
        setMenuState(false);
      });
    });

    // Keyboard navigation & Focus Trap
    const onKeyDown = (e: KeyboardEvent) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        setMenuState(false);
        toggleBtn.focus();
        return;
      }

      if (e.key === 'Tab') {
        const focusables = getFocusableInDrawer();
        if (focusables.length === 0) return;

        const firstEl = focusables[0];
        const lastEl = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstEl || document.activeElement === toggleBtn) {
            e.preventDefault();
            lastEl.focus();
          }
        } else {
          if (document.activeElement === lastEl) {
            e.preventDefault();
            firstEl.focus();
          }
        }
      }
    };
    document.removeEventListener('keydown', onKeyDown);
    document.addEventListener('keydown', onKeyDown);

    // Close when clicking outside
    const onDocClick = (e: MouseEvent) => {
      if (isOpen && !drawer.contains(e.target as Node) && !toggleBtn.contains(e.target as Node)) {
        setMenuState(false);
        toggleBtn.focus();
      }
    };
    document.removeEventListener('click', onDocClick);
    document.addEventListener('click', onDocClick);

    // Auto-close on resize to md screen size (768px+)
    const onResize = () => {
      if (window.innerWidth >= 768 && isOpen) {
        setMenuState(false);
      }
    };
    window.removeEventListener('resize', onResize);
    window.addEventListener('resize', onResize);
  };

  const setupDesktopNavDropdown = () => {
    const toggleBtn = document.getElementById('desktop-active-nav-btn');
    const dropdown = document.getElementById('desktop-sections-dropdown');
    const arrow = document.getElementById('desktop-nav-arrow');
    const content = document.getElementById('desktop-nav-content');
    const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-section-link');

    if (!toggleBtn || !dropdown) return;

    let isOpen = false;

    const setDropdownState = (open: boolean) => {
      isOpen = open;
      toggleBtn.setAttribute('aria-expanded', open.toString());
      dropdown.setAttribute('aria-hidden', (!open).toString());

      if (open) {
        dropdown.classList.remove('opacity-0', '-translate-y-2', 'scale-95', 'pointer-events-none');
        dropdown.classList.add('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
        if (arrow) {
          arrow.classList.add('!opacity-100', 'rotate-180');
        }
        if (content) {
          content.classList.add('!translate-x-0');
        }
        sectionLinks.forEach((link) => link.removeAttribute('tabindex'));
      } else {
        dropdown.classList.remove('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
        dropdown.classList.add('opacity-0', '-translate-y-2', 'scale-95', 'pointer-events-none');
        if (arrow) {
          arrow.classList.remove('!opacity-100', 'rotate-180');
        }
        if (content) {
          content.classList.remove('!translate-x-0');
        }
        sectionLinks.forEach((link) => link.setAttribute('tabindex', '-1'));
      }
    };

    // Initial state: not focusable when closed
    setDropdownState(false);

    toggleBtn.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();
      setDropdownState(!isOpen);
    };

    sectionLinks.forEach((link) => {
      link.onclick = (e) => {
        const href = link.getAttribute('href');
        if (href) {
          const hashIndex = href.indexOf('#');
          if (hashIndex !== -1) {
            const hash = href.slice(hashIndex);
            const targetEl = document.querySelector(hash);
            if (targetEl) {
              e.preventDefault();
              targetEl.scrollIntoView({ behavior: 'smooth' });
              history.pushState(null, '', hash);
            }
          }
        }
        setDropdownState(false);
      };
    });

    const onDocClick = (e: MouseEvent) => {
      if (isOpen && !dropdown.contains(e.target as Node) && !toggleBtn.contains(e.target as Node)) {
        setDropdownState(false);
      }
    };
    document.removeEventListener('click', onDocClick);
    document.addEventListener('click', onDocClick);

    const onKeyDown = (e: KeyboardEvent) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        setDropdownState(false);
        toggleBtn.focus();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        const focusables = Array.from(sectionLinks);
        const currentIndex = focusables.indexOf(document.activeElement as HTMLAnchorElement);
        const nextIndex = (currentIndex + 1) % focusables.length;
        focusables[nextIndex]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        const focusables = Array.from(sectionLinks);
        const currentIndex = focusables.indexOf(document.activeElement as HTMLAnchorElement);
        const prevIndex = (currentIndex - 1 + focusables.length) % focusables.length;
        focusables[prevIndex]?.focus();
      }
    };
    document.removeEventListener('keydown', onKeyDown);
    document.addEventListener('keydown', onKeyDown);

    const onResize = () => {
      if (window.innerWidth < 768 && isOpen) {
        setDropdownState(false);
      }
    };
    window.removeEventListener('resize', onResize);
    window.addEventListener('resize', onResize);
  };

  const setupFullscreenToggle = () => {
    const toggleBtn = document.getElementById('mobile-fullscreen-toggle');
    const textSpan = document.getElementById('fullscreen-text');
    if (!toggleBtn) return;

    const isFullscreen = () => {
      const doc = document as any;
      return !!(
        doc.fullscreenElement ||
        doc.webkitFullscreenElement ||
        doc.mozFullScreenElement ||
        doc.msFullscreenElement
      );
    };

    const updateUI = () => {
      const active = isFullscreen();
      const isId = document.documentElement.lang === 'id';
      toggleBtn.setAttribute('aria-pressed', String(active));
      
      const ariaEn = active ? 'Exit Fullscreen Mode' : 'Toggle Fullscreen Mode';
      const ariaId = active ? 'Keluar Mode Layar Penuh' : 'Mode Layar Penuh';
      toggleBtn.setAttribute('data-aria-en', ariaEn);
      toggleBtn.setAttribute('data-aria-id', ariaId);
      toggleBtn.setAttribute('aria-label', isId ? ariaId : ariaEn);
      
      if (textSpan) {
        if (active) {
          textSpan.textContent = isId ? 'Keluar' : 'Exit';
        } else {
          textSpan.textContent = isId ? 'Layar Penuh' : 'Fullscreen';
        }
      }
    };

    updateUI();
    window.addEventListener('portfolio:lang-change', updateUI);

    toggleBtn.onclick = async (e) => {
      e.stopPropagation();
      try {
        if (!isFullscreen()) {
          const docEl = document.documentElement as any;
          if (docEl.requestFullscreen) {
            await docEl.requestFullscreen();
          } else if (docEl.webkitRequestFullscreen) {
            await docEl.webkitRequestFullscreen();
          } else if (docEl.mozRequestFullScreen) {
            await docEl.mozRequestFullScreen();
          } else if (docEl.msRequestFullscreen) {
            await docEl.msRequestFullscreen();
          }
        } else {
          const doc = document as any;
          if (doc.exitFullscreen) {
            await doc.exitFullscreen();
          } else if (doc.webkitExitFullscreen) {
            await doc.webkitExitFullscreen();
          } else if (doc.mozCancelFullScreen) {
            await doc.mozCancelFullScreen();
          } else if (doc.msExitFullscreen) {
            await doc.msExitFullscreen();
          }
        }
      } catch (err) {
        console.warn('Fullscreen toggle failed:', err);
      }
      updateUI();
    };

    const onFullscreenChange = () => {
      updateUI();
    };

    document.removeEventListener('fullscreenchange', onFullscreenChange);
    document.addEventListener('fullscreenchange', onFullscreenChange);
    document.removeEventListener('webkitfullscreenchange', onFullscreenChange);
    document.addEventListener('webkitfullscreenchange', onFullscreenChange);
    document.removeEventListener('mozfullscreenchange', onFullscreenChange);
    document.addEventListener('mozfullscreenchange', onFullscreenChange);
    document.removeEventListener('MSFullscreenChange', onFullscreenChange);
    document.addEventListener('MSFullscreenChange', onFullscreenChange);
  };

  const initNavbar = () => {
    setupLogoScroll();
    setupThemeToggle();
    setupMobileMenu();
    setupDesktopNavDropdown();
    setupFullscreenToggle();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar);
  } else {
    initNavbar();
  }
  document.addEventListener('astro:page-load', initNavbar);
</script>

---
import StatusBadge from './StatusBadge.astro';
import ActionButton from './ActionButton.astro';

interface Props {
  index: string | number;
  title: string;
  category?: string;
  categoryId?: string;
  description?: string;
  descriptionId?: string;
  href?: string;
  imageSrc?: string;
  videoSrc?: string;
  status?: string;
  statusId?: string;
  statusVariant?: 'accent' | 'neon' | 'neutral' | 'warning' | 'danger' | 'info';
  tags?: string[];
  actionText?: string;
  actionTextId?: string;
  metaText?: string;
  brand?: string;
  class?: string;
}

const {
  index,
  title,
  category = 'FEATURED SYSTEM',
  categoryId,
  description = '',
  descriptionId = '',
  href = '#',
  imageSrc,
  videoSrc,
  status,
  statusId,
  statusVariant = 'accent',
  tags = [],
  actionText = 'View Repo',
  actionTextId = 'Lihat Repo',
  metaText = '',
  brand = '',
  class: className = '',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const formattedIndex = typeof index === 'number' ? String(index).padStart(2, '0') : index;
const titleId = `tile-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<!-- Fixed-dimension slot: NEVER shifts or pushes neighboring cards -->
<div
  class:list={[
    'project-slot relative shrink-0 w-[360px] sm:w-[440px] md:w-[480px] lg:w-[calc((100vw-5rem)/3.15)] lg:min-w-[460px] h-[295px] sm:h-[335px] lg:h-[375px]',
    className
  ]}
  data-project-slot
  data-title={title}
>
  <!-- The Real Morphing Card: physically animates width, height, top, left, and shadow -->
  <div
    class="morph-card group/card absolute top-0 left-0 w-full h-full z-10 flex flex-col bg-transparent rounded-none cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)]"
    data-morph-card
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-label={`Open ${title} project card`}
  >
    <!-- Viewfinder Media Bay: 16:9 widescreen horizontal, flush top -->
    <div
      class="morph-media group/media relative w-full aspect-video shrink-0 bg-neutral-200/70 dark:bg-neutral-900/90 flex items-center justify-center rounded-none"
      data-morph-media
    >
      {videoSrc ? (
        <video
          src={videoSrc}
          muted
          loop
          playsinline
          preload="metadata"
          class="morph-video w-full h-full object-cover"
        />
      ) : imageSrc ? (
        <img
          src={imageSrc}
          alt={title}
          loading="lazy"
          decoding="async"
          class="morph-img w-full h-full object-cover"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center relative select-none overflow-hidden bg-neutral-100/80 dark:bg-neutral-950">
          <svg class="absolute inset-0 w-full h-full text-neutral-300/70 dark:text-neutral-800/80 pointer-events-none" xmlns="http://www.w3.org/2000/svg">
            <line x1="0" y1="100%" x2="100%" y2="0" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
            <line x1="0" y1="0" x2="100%" y2="100%" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
      )}
      <!-- Fullscreen Media Button (Standardized ActionButton micro, Bottom Right) -->
      {(videoSrc || imageSrc) && (
        <div class="absolute bottom-2.5 right-2.5 z-30 opacity-0 group-hover/media:opacity-100 transition-opacity duration-200 pointer-events-auto">
          <ActionButton
            size="micro"
            variant="primary-neutral"
            ariaLabel={`View full scale media for ${title}`}
            data-modal-target={`modal-${titleId}`}
            class="tile-scale-btn"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
              <path d="M3 8V3h5" />
              <path d="M21 8V3h-5" />
              <path d="M3 16v5h5" />
              <path d="M21 16v5h-5" />
            </svg>
          </ActionButton>
        </div>
      )}

      <!-- Hovering Holographic Brand Logo Overlay (Active strictly on media hover, including morph media) -->
      {brand === 'mctextureghost' ? (
        <div class="tile-hologram-overlay absolute inset-0 z-20 flex items-center justify-center bg-black/45 backdrop-blur-[1.5px] opacity-0 group-hover/media:opacity-100 transition-all duration-300 pointer-events-none select-none">
          <div class="hologram-content flex items-center gap-2 transform scale-90 group-hover/media:scale-100 transition-transform duration-300">
            <div class="w-8 h-8 relative shrink-0">
              <img
                src={`${base}/mctextureghost-icon.png`}
                alt=""
                class="absolute -top-2 -left-1 w-14 h-14 max-w-none object-contain pixelated [image-rendering:pixelated] drop-shadow-[0_0_12px_rgba(82,255,26,0.95)] drop-shadow-[0_0_28px_rgba(82,255,26,0.6)]"
              />
            </div>
            <div class="text-xl sm:text-2xl font-bold tracking-[-0.02em] text-white leading-none font-heading inline-flex items-center pl-4 drop-shadow-[0_0_16px_rgba(0,0,0,0.8)]">
              <span>mc</span>
              <span
                class="!text-[#52FF1A]"
                style="color: #52FF1A !important; font-family: 'Press Start 2P', monospace; font-size: 0.74em; margin: 0 3px; transform: translateY(1px); display: inline-block; text-shadow: 0 0 16px rgba(82,255,26,0.85);"
              >Texture</span>
              <span>Ghost</span>
            </div>
          </div>
        </div>
      ) : brand === 'hypebox' ? (
        <div class="tile-hologram-overlay absolute inset-0 z-20 flex items-center justify-center bg-black/45 backdrop-blur-[1.5px] opacity-0 group-hover/media:opacity-100 transition-all duration-300 pointer-events-none select-none">
          <div class="hologram-content transform scale-90 group-hover/media:scale-100 transition-transform duration-300">
            <span class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-none font-heading drop-shadow-[0_0_16px_rgba(255,255,255,0.95)] drop-shadow-[0_0_36px_rgba(255,255,255,0.7)]">
              HYPE-BOX
            </span>
          </div>
        </div>
      ) : (brand === 'hero' || brand === 'portfolio' || brand === 'yovan') ? (
        <div class="tile-hologram-overlay absolute inset-0 z-20 flex items-center justify-center bg-black/55 backdrop-blur-[2px] opacity-0 group-hover/media:opacity-100 transition-all duration-300 pointer-events-none select-none">
          <div class="hologram-content hologram-hero select-none flex flex-col leading-none font-heading transform scale-90 -translate-x-3 sm:-translate-x-4 group-hover/media:scale-100 transition-transform duration-300 pl-4">
            <div
              class="relative inline-flex items-baseline whitespace-nowrap leading-[0.9] text-white/95 font-black text-2xl sm:text-3xl"
              style="letter-spacing: -0.04em;"
            >
              <span
                class="absolute right-full mr-1 text-white/50 select-none text-xs sm:text-sm font-black"
                style="bottom: 0.15em;"
              >&lt;</span>
              <span>yovan</span>
            </div>

            <div
              class="inline-flex items-baseline whitespace-nowrap leading-[0.95] text-white/90 font-black text-xl sm:text-2xl"
              style="letter-spacing: -0.03em; margin-top: -0.1rem;"
            >
              <span>gunardio</span>
              <span
                class="text-white/50 text-sm sm:text-base font-black ml-0.5"
              >;</span>
            </div>

            <div
              class="relative inline-flex items-baseline whitespace-nowrap leading-none font-normal text-xs sm:text-sm mt-1"
              style="letter-spacing: 0.06em;"
            >
              <span
                class="text-[var(--color-accent,#52FF1A)] opacity-75 mr-1 text-[10px] sm:text-xs font-normal"
              >//</span>
              <span class="text-neutral-300">darmawan</span>
              <span
                class="text-white/50 text-xs sm:text-sm font-black ml-1 select-none"
              >/&gt;</span>
            </div>
          </div>
        </div>
      ) : null}

      <!-- Top Overlay Status Badge -->
      {status && (
        <div class="absolute top-2 left-2.5 z-40 pointer-events-none">
          <div class="morph-status-badge">
            <StatusBadge variant={statusVariant} size="sm">
              <span data-en={status} data-id={statusId || status}>{status}</span>
            </StatusBadge>
          </div>
        </div>
      )}
    </div>

    <!-- Category Header: Always positioned BELOW the media -->
    <div class="morph-header pt-4 pb-2.5 px-3.5 sm:px-4 flex flex-col gap-2 select-none">
      <div class="flex items-center justify-between gap-3">
        <span
          class="font-sans text-xs tracking-wider font-normal text-neutral-500 dark:text-neutral-400 uppercase truncate"
          data-en={category}
          data-id={categoryId || category}
        >
          {category}
        </span>
        {metaText && (
          <span class="morph-meta-label font-mono text-[11px] font-normal text-neutral-400 dark:text-neutral-500 shrink-0 opacity-0 group-hover/card:opacity-100 transition-opacity duration-200">
            {metaText}
          </span>
        )}
      </div>
    </div>

    <!-- Morphed Expanded Details: title, description, tags, action dock -->
    <div
      class="morph-details flex flex-col px-3.5 sm:px-4 pb-5 gap-4 flex-1 opacity-0 pointer-events-none transition-opacity duration-250 ease-out overflow-visible"
      data-morph-details
      data-morph-content
      aria-hidden="true"
    >
      <!-- Title: Revealed ONLY on expanded active morph (NEVER on inactive) -->
      <h4 class:list={[
        "font-sans font-semibold text-lg sm:text-xl text-neutral-950 dark:text-white tracking-tight leading-snug truncate m-0 transition-colors",
        (brand === 'mctextureghost' || title.toLowerCase().includes('mctextureghost'))
          ? "group-hover/card:text-[#52FF1A]"
          : "group-hover/card:text-[var(--color-accent,#52FF1A)]"
      ]}>
        {title}
      </h4>
      <!-- Description -->
      <p
        class="font-sans text-xs sm:text-[13px] text-neutral-600 dark:text-neutral-300 leading-relaxed m-0"
        data-en={description}
        data-id={descriptionId || description}
      >
        {description}
      </p>

      <!-- Tech Stack Tags -->
      {tags && tags.length > 0 && (
        <div class="space-y-2 pt-1">
          <span class="font-sans text-[10.5px] font-normal text-neutral-400 dark:text-neutral-500 uppercase tracking-widest block">
            Tech Stack
          </span>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="font-sans text-xs px-2.5 py-1 rounded-sm bg-neutral-200/80 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 font-normal">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Action Dock -->
      {href && href !== '#' && (
        <div class="pt-4 flex items-center mt-auto">
          <ActionButton
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            variant="cta-white"
            size="sm"
            font="sans"
            uppercase={false}
            rounded="rounded-md"
            class="group overflow-hidden text-[13px]"
            aria-label={`${actionText}: ${title}`}
            data-aria-en={`${actionText}: ${title}`}
            data-aria-id={`${actionTextId || actionText}: ${title}`}
          >
            <div class="inline-flex items-center translate-x-[10px] group-hover:translate-x-0 transition-transform duration-200 ease-out">
              <span data-en={actionText} data-id={actionTextId || actionText}>{actionText}</span>
              <span class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-out text-neutral-400 group-hover:text-white dark:group-hover:text-neutral-950" aria-hidden="true">↗</span>
            </div>
          </ActionButton>
        </div>
      )}
    </div>
  </div>
</div>

{(videoSrc || imageSrc) && (
  <dialog
    id={`modal-${titleId}`}
    class="tile-modal backdrop:bg-black/80 backdrop:backdrop-blur-md bg-transparent p-0 m-auto w-[95vw] max-w-5xl overflow-visible border-0"
  >
    <div class="flex flex-col items-center justify-center w-full h-full max-h-[90vh]">
      <!-- Dismiss Label -->
      <div class="w-full flex justify-end mb-2 px-1">
        <button
          type="button"
          class="tile-modal-close font-mono text-xs text-red-500 hover:text-red-400 hover:underline cursor-pointer select-none transition-colors p-0 bg-transparent border-0 flex items-center gap-1"
        >
          <span class="sm:hidden" data-en="↓ Swipe down to dismiss" data-id="↓ Usap ke bawah untuk menutup">↓ Swipe down to dismiss</span>
          <span class="hidden sm:inline" data-en="Dismiss x [esc]" data-id="Tutup x [esc]">Dismiss x [esc]</span>
        </button>
      </div>

      <!-- Scaled Media Card -->
      <div class="w-full bg-[#fcfbf9] dark:bg-[#0e0e0e] shadow-2xl rounded-sm overflow-hidden aspect-video flex items-center justify-center relative">
        {videoSrc ? (
          <video
            src={videoSrc}
            loop
            muted
            playsinline
            controls
            class="tile-modal-video w-full h-full object-contain bg-black"
          />
        ) : imageSrc ? (
          <img
            src={imageSrc}
            alt={title}
            loading="lazy"
            class="w-full h-full object-contain bg-neutral-100 dark:bg-neutral-900"
          />
        ) : null}
      </div>
    </div>
  </dialog>
)}

<script>
  let isModalDelegated = false;

  function initMorphCardModals() {
    if (isModalDelegated) return;
    isModalDelegated = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;

      // 1. Open Modal Trigger
      const trigger = target.closest<HTMLElement>('.tile-scale-btn');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        const targetId = trigger.getAttribute('data-modal-target');
        if (!targetId) return;
        const dialog = document.getElementById(targetId) as HTMLDialogElement | null;
        if (dialog) {
          dialog.showModal();
          dialog.style.transform = 'none';
          const modalVideo = dialog.querySelector<HTMLVideoElement>('video.tile-modal-video');
          if (modalVideo) {
            modalVideo.currentTime = 0;
            modalVideo.play().catch(() => {});
          }
        }
        return;
      }

      // 2. Dismiss Button
      const closeBtn = target.closest<HTMLElement>('.tile-modal-close');
      if (closeBtn) {
        e.preventDefault();
        e.stopPropagation();
        const dialog = closeBtn.closest<HTMLDialogElement>('.tile-modal');
        if (dialog) closeModal(dialog);
        return;
      }

      // 3. Backdrop Click
      if (target.classList.contains('tile-modal') && target.tagName === 'DIALOG') {
        closeModal(target as HTMLDialogElement);
      }
    });

    document.addEventListener('cancel', (e) => {
      const target = e.target as HTMLElement;
      if (target && target.classList.contains('tile-modal') && target.tagName === 'DIALOG') {
        e.preventDefault();
        closeModal(target as HTMLDialogElement);
      }
    });

    function closeModal(dialog: HTMLDialogElement) {
      if (!dialog.hasAttribute('open')) return;
      dialog.classList.add('is-closing');
      const modalVideo = dialog.querySelector<HTMLVideoElement>('video.tile-modal-video');
      if (modalVideo) modalVideo.pause();

      setTimeout(() => {
        dialog.close();
        dialog.classList.remove('is-closing');
      }, 200);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMorphCardModals);
  } else {
    initMorphCardModals();
  }
  document.addEventListener('astro:page-load', initMorphCardModals);
</script>

<style>
  .morph-card {
    transition:
      transform 240ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 280ms ease;
    will-change: width, height, top, left, transform;
  }

  .morph-media {
    transition: box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Card shell: strictly NO ugly elevation shadows on inactive or active cards */
  .morph-card {
    box-shadow: none !important;
  }

  .morph-card:not([aria-expanded="true"]):hover {
    transform: scale(1.025) !important;
    z-index: 30;
    box-shadow: none !important;
  }

  /* Media hover shadow strictly on the media viewfinder itself */
  .morph-media:hover {
    box-shadow: 0 10px 25px -8px rgba(0, 0, 0, 0.55);
  }

  /* Active: crisp morph layout at z-60, no ugly card drop shadow */
  .morph-card[aria-expanded="true"] {
    transform: none !important;
    z-index: 60 !important;
    cursor: default;
    box-shadow: none !important;
  }

  .morph-status-badge {
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1), filter 380ms ease;
  }

  .morph-card[aria-expanded="true"] .morph-status-badge {
    transform: translateY(-26px);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.65));
  }

  /* STRICT: Zero title, zero details on inactive cards */
  .morph-card:not([aria-expanded="true"]) .morph-details {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>

<style is:global>
  .tile-modal {
    opacity: 0;
    transform: translateY(15px) scale(0.98);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .tile-modal[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  
  .tile-modal.is-closing {
    opacity: 0;
    transform: translateY(15px) scale(0.98);
  }
</style>

---
// DevMenu.astro - Direct GitHub edit shortcuts for active blog post and related project
// Opened solely via keypress ` (Backquote).

interface Props {
  currentPost: any;
  relatedProject?: any;
}

const { currentPost, relatedProject } = Astro.props;

const repoBase = 'https://github.com/navoyovan/portfolio-yovan';
const postFile = currentPost?.id
  ? (currentPost.id.endsWith('.md') ? currentPost.id : `${currentPost.id}.md`)
  : '';
const postPath = `src/content/blog/${postFile}`;
const postEditUrl = `${repoBase}/edit/master/${postPath}`;

const projectFile = relatedProject?.id ? `${relatedProject.id}.json` : '';
const projectPath = projectFile ? `src/content/projects/${projectFile}` : '';
const projectEditUrl = projectFile ? `${repoBase}/edit/master/${projectPath}` : '';
const projectRepoUrl = relatedProject?.data?.github || null;
---

<div
  id="blog-dev-hud"
  role="dialog"
  aria-modal="true"
  aria-label="Edit in GitHub"
  aria-hidden="true"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 font-sans select-none"
>
  <div
    id="blog-dev-hud-backdrop"
    class="fixed inset-0 bg-black/70 backdrop-blur-xs transition-opacity duration-150"
    aria-hidden="true"
  ></div>

  <div
    id="blog-dev-hud-panel"
    class="relative z-10 w-full max-w-md bg-[#fcfbf9] dark:bg-[#121212] border border-neutral-300 dark:border-neutral-800 rounded-xl shadow-2xl p-4 flex flex-col gap-3 transform scale-95 opacity-0 transition-[transform,opacity] duration-150 font-sans"
  >
    <div class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-neutral-800 dark:text-neutral-200 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent,#52FF1A)]"></span>
        GitHub Edit Shortcuts
      </span>
      <span class="font-mono text-[10px] text-neutral-400">
        Press <kbd class="px-1 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 font-semibold text-neutral-700 dark:text-neutral-300">`</kbd> or <kbd class="px-1 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 font-semibold text-neutral-700 dark:text-neutral-300">ESC</kbd>
      </span>
    </div>

    <div class="flex flex-col gap-2">
      <!-- 1. Blog Post -->
      <a
        id="hud-edit-blog"
        href={postEditUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-3 rounded-lg bg-neutral-100 hover:bg-[var(--color-accent,#52FF1A)] dark:bg-neutral-900 dark:hover:bg-[var(--color-accent,#52FF1A)] text-neutral-900 dark:text-white hover:text-neutral-950 dark:hover:text-neutral-950 transition-colors"
      >
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-6 h-6 rounded flex items-center justify-center font-mono text-xs font-bold bg-neutral-200 dark:bg-neutral-800 group-hover:bg-black/10 text-neutral-700 dark:text-neutral-300 group-hover:text-neutral-950 shrink-0">
            1
          </span>
          <div class="min-w-0">
            <div class="font-heading font-bold text-xs uppercase tracking-wide">
              Edit Blog Post
            </div>
            <div class="font-mono text-[11px] opacity-75 truncate">
              {postPath}
            </div>
          </div>
        </div>
        <svg class="w-4 h-4 opacity-60 group-hover:opacity-100 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- 2. Related Project -->
      {relatedProject && (
        <a
          id="hud-edit-project"
          href={projectEditUrl || projectRepoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between p-3 rounded-lg bg-neutral-100 hover:bg-[var(--color-accent,#52FF1A)] dark:bg-neutral-900 dark:hover:bg-[var(--color-accent,#52FF1A)] text-neutral-900 dark:text-white hover:text-neutral-950 dark:hover:text-neutral-950 transition-colors"
        >
          <div class="flex items-center gap-3 min-w-0">
            <span class="w-6 h-6 rounded flex items-center justify-center font-mono text-xs font-bold bg-neutral-200 dark:bg-neutral-800 group-hover:bg-black/10 text-neutral-700 dark:text-neutral-300 group-hover:text-neutral-950 shrink-0">
              2
            </span>
            <div class="min-w-0">
              <div class="font-heading font-bold text-xs uppercase tracking-wide">
                Edit Related Project
              </div>
              <div class="font-mono text-[11px] opacity-75 truncate">
                {projectPath || (projectRepoUrl ? projectRepoUrl.replace('https://github.com/', '') : 'Project')}
              </div>
            </div>
          </div>
          <svg class="w-4 h-4 opacity-60 group-hover:opacity-100 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>

    <div class="flex items-center justify-between pt-1 text-[11px] font-mono text-neutral-400">
      <span>Press <kbd class="px-1 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 font-semibold text-neutral-700 dark:text-neutral-300">1</kbd> to open Blog</span>
      {relatedProject && (
        <span>Press <kbd class="px-1 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 font-semibold text-neutral-700 dark:text-neutral-300">2</kbd> to open Project</span>
      )}
    </div>
  </div>
</div>

<script>
  function setupDevShortcuts() {
    const container = document.getElementById('blog-dev-hud');
    const panel = document.getElementById('blog-dev-hud-panel');
    const backdrop = document.getElementById('blog-dev-hud-backdrop');
    const blogLink = document.getElementById('hud-edit-blog') as HTMLAnchorElement | null;
    const projectLink = document.getElementById('hud-edit-project') as HTMLAnchorElement | null;

    let isOpen = false;

    function openHud() {
      if (!container || !panel) return;
      isOpen = true;
      container.classList.remove('hidden');
      container.classList.add('flex');
      container.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        panel.classList.remove('scale-95', 'opacity-0');
        panel.classList.add('scale-100', 'opacity-100');
        if (blogLink) blogLink.focus();
      });
      document.body.style.overflow = 'hidden';
    }

    function closeHud() {
      if (!container || !panel) return;
      isOpen = false;
      panel.classList.remove('scale-100', 'opacity-100');
      panel.classList.add('scale-95', 'opacity-0');
      container.setAttribute('aria-hidden', 'true');
      setTimeout(() => {
        if (!isOpen) {
          container.classList.remove('flex');
          container.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }, 150);
    }

    function toggleHud() {
      if (isOpen) {
        closeHud();
      } else {
        openHud();
      }
    }

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      const isTyping =
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.isContentEditable;

      if (e.key === '`' || e.code === 'Backquote') {
        if (isTyping) return;
        e.preventDefault();
        toggleHud();
        return;
      }

      if (!isOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeHud();
      } else if (e.key === '1' && blogLink) {
        e.preventDefault();
        window.open(blogLink.href, '_blank', 'noopener,noreferrer');
        closeHud();
      } else if (e.key === '2' && projectLink) {
        e.preventDefault();
        window.open(projectLink.href, '_blank', 'noopener,noreferrer');
        closeHud();
      }
    });

    if (backdrop) backdrop.addEventListener('click', closeHud);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDevShortcuts);
  } else {
    setupDevShortcuts();
  }
  document.addEventListener('astro:page-load', setupDevShortcuts);
</script>

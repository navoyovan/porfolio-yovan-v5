---
// DevMenu.astro - Quick access to edit the 2 files on GitHub: Blog & Project
// Triggered exclusively by keypress ` (Backquote). No corner button.

interface Props {
  currentPost: any;
  relatedProject?: any;
}

const { currentPost, relatedProject } = Astro.props;

const repoBase = 'https://github.com/navoyovan/portfolio-yovan';
const postFile = currentPost?.id
  ? (currentPost.id.endsWith('.md') ? currentPost.id : `${currentPost.id}.md`)
  : '';
const postEditUrl = `${repoBase}/edit/master/src/content/blog/${postFile}`;

const projectFile = relatedProject?.id ? `${relatedProject.id}.json` : '';
const projectEditUrl = projectFile
  ? `${repoBase}/edit/master/src/content/projects/${projectFile}`
  : null;
---

<div
  id="blog-dev-menu"
  role="dialog"
  aria-label="Edit in GitHub"
  class="hidden fixed top-4 right-4 z-[100] bg-neutral-950 text-white border border-neutral-800 rounded-lg p-3 shadow-2xl font-mono text-xs select-none min-w-[280px]"
>
  <div class="flex items-center justify-between gap-4 pb-1.5 mb-2 border-b border-neutral-800 text-[10px] text-neutral-500 uppercase tracking-wider font-semibold">
    <span>Edit on GitHub</span>
    <span>[` / ESC]</span>
  </div>

  <div class="flex flex-col gap-1.5">
    <a
      id="dev-blog-link"
      href={postEditUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-between gap-2 text-[var(--color-accent,#52FF1A)] hover:underline"
    >
      <span class="truncate">[Blog] {postFile}</span>
      <span class="text-[10px] opacity-70 shrink-0">&nearr;</span>
    </a>

    {projectEditUrl && (
      <a
        id="dev-project-link"
        href={projectEditUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between gap-2 text-neutral-300 hover:text-white hover:underline"
      >
        <span class="truncate">[Project] {projectFile}</span>
        <span class="text-[10px] opacity-70 shrink-0">&nearr;</span>
      </a>
    )}
  </div>
</div>

<script>
  function setupDevMenu() {
    const menu = document.getElementById('blog-dev-menu');
    const blogLink = document.getElementById('dev-blog-link') as HTMLAnchorElement | null;
    const projectLink = document.getElementById('dev-project-link') as HTMLAnchorElement | null;
    if (!menu) return;

    window.addEventListener('keydown', (e: KeyboardEvent) => {
      const target = e.target as HTMLElement | null;
      const isTyping =
        target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable);

      if (e.key === '`' || e.code === 'Backquote') {
        if (isTyping) return;
        e.preventDefault();
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          blogLink?.focus();
        } else {
          menu.classList.add('hidden');
        }
      } else if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        e.preventDefault();
        menu.classList.add('hidden');
      } else if (!menu.classList.contains('hidden')) {
        if (e.key === '1' && blogLink) {
          e.preventDefault();
          window.open(blogLink.href, '_blank', 'noopener,noreferrer');
          menu.classList.add('hidden');
        } else if (e.key === '2' && projectLink) {
          e.preventDefault();
          window.open(projectLink.href, '_blank', 'noopener,noreferrer');
          menu.classList.add('hidden');
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDevMenu);
  } else {
    setupDevMenu();
  }
  document.addEventListener('astro:page-load', setupDevMenu);
</script>

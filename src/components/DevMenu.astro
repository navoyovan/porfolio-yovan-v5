---
// DevMenu.astro - Minimalist developer quick-access HUD for blog posts
// Opened exclusively via keypress ` (Backquote / Tilde). No floating corner buttons.

interface Props {
  currentPost: any;
  relatedProject?: any;
}

const { currentPost, relatedProject } = Astro.props;

const repoBase = 'https://github.com/navoyovan/portfolio-yovan';
const postFile = currentPost?.id
  ? (currentPost.id.endsWith('.md') ? currentPost.id : `${currentPost.id}.md`)
  : '';
const postRelativePath = `src/content/blog/${postFile}`;
const postEditUrl = `${repoBase}/edit/master/${postRelativePath}`;
const postBlobUrl = `${repoBase}/blob/master/${postRelativePath}`;

const projectFile = relatedProject?.id ? `${relatedProject.id}.json` : '';
const projectRelativePath = projectFile ? `src/content/projects/${projectFile}` : '';
const projectEditUrl = projectFile ? `${repoBase}/edit/master/${projectRelativePath}` : '';
const projectRepoUrl = relatedProject?.data?.github || null;

const templateRelativePath = 'src/pages/blog/[slug].astro';
const templateEditUrl = `${repoBase}/edit/master/${templateRelativePath}`;
---

<!-- Dev Menu HUD (No corner button, triggered only via keypress `) -->
<div
  id="blog-dev-hud"
  role="dialog"
  aria-modal="true"
  aria-label="Developer Quick Access"
  aria-hidden="true"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 font-sans select-none"
>
  <!-- Backdrop -->
  <div
    id="blog-dev-hud-backdrop"
    class="fixed inset-0 bg-neutral-950/60 dark:bg-black/80 backdrop-blur-sm transition-opacity duration-150"
    aria-hidden="true"
  ></div>

  <!-- HUD Card -->
  <div
    id="blog-dev-hud-panel"
    class="relative z-10 w-full max-w-lg bg-[#fcfbf9] dark:bg-[#121212] border border-neutral-300 dark:border-neutral-800 rounded-xl shadow-2xl shadow-black/50 overflow-hidden transform scale-95 opacity-0 transition-[transform,opacity] duration-150 font-sans"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/70">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent,#52FF1A)] animate-pulse shrink-0"></span>
        <span class="font-mono text-xs font-bold text-neutral-800 dark:text-neutral-200 uppercase tracking-wider truncate">
          DEV QUICK ACCESS
        </span>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="font-mono text-[11px] text-neutral-400">
          <kbd class="px-1.5 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-[10px] font-semibold">`</kbd> or <kbd class="px-1.5 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-[10px] font-semibold">ESC</kbd>
        </span>
        <button
          type="button"
          id="blog-dev-hud-close"
          aria-label="Close"
          class="p-1 rounded text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Active Article Context Info -->
    <div class="px-4 py-3 border-b border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-50 dark:bg-neutral-900/30">
      <div class="text-[11px] font-mono text-neutral-400 uppercase tracking-wider mb-1">
        Target Article Source
      </div>
      <div class="font-heading font-bold text-sm text-neutral-900 dark:text-white truncate">
        {currentPost?.data?.title || 'Current Article'}
      </div>
      <div class="flex items-center gap-2 mt-1">
        <code class="font-mono text-[11px] text-neutral-600 dark:text-neutral-400 truncate">
          {postRelativePath}
        </code>
        <button
          type="button"
          id="hud-copy-post-path"
          data-path={postRelativePath}
          class="px-1.5 py-0.5 rounded bg-neutral-200 hover:bg-neutral-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 font-mono text-[10px] text-neutral-700 dark:text-neutral-300 transition-colors cursor-pointer shrink-0"
        >
          Copy Path
        </button>
      </div>
    </div>

    <!-- Quick Actions List -->
    <div class="p-3 flex flex-col gap-1.5">
      <!-- 1. Edit Post on GitHub (Primary) -->
      <a
        id="hud-primary-action"
        href={postEditUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-2.5 rounded-lg bg-neutral-100 hover:bg-[var(--color-accent,#52FF1A)] dark:bg-neutral-900 dark:hover:bg-[var(--color-accent,#52FF1A)] text-neutral-900 dark:text-white hover:text-neutral-950 dark:hover:text-neutral-950 transition-colors cursor-pointer"
      >
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 rounded flex items-center justify-center font-mono text-xs font-bold bg-neutral-200 dark:bg-neutral-800 group-hover:bg-black/10 text-neutral-700 dark:text-neutral-300 group-hover:text-neutral-950 shrink-0">
            1
          </span>
          <div>
            <div class="font-heading font-bold text-xs uppercase tracking-wide">
              Edit Article in GitHub
            </div>
            <div class="font-mono text-[11px] opacity-75 truncate max-w-[280px] sm:max-w-sm">
              Opens web editor for {postFile}
            </div>
          </div>
        </div>
        <svg class="w-4 h-4 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-[transform,opacity]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- 2. View Post on GitHub -->
      <a
        id="hud-view-action"
        href={postBlobUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
      >
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 rounded flex items-center justify-center font-mono text-xs font-semibold bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 shrink-0">
            2
          </span>
          <div>
            <div class="font-heading font-semibold text-xs uppercase tracking-wide">
              View Markdown Source on GitHub
            </div>
            <div class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500">
              blob/master/{postRelativePath}
            </div>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- 3. Related Project Actions (if available) -->
      {relatedProject && (
        <>
          <a
            id="hud-project-edit-action"
            href={projectEditUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between p-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded flex items-center justify-center font-mono text-xs font-semibold bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 shrink-0">
                3
              </span>
              <div>
                <div class="font-heading font-semibold text-xs uppercase tracking-wide">
                  Edit Related Project Data ({projectFile})
                </div>
                <div class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500">
                  {relatedProject.data?.title || 'Project'} metadata JSON
                </div>
              </div>
            </div>
            <svg class="w-4 h-4 text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          {projectRepoUrl && (
            <a
              id="hud-project-repo-action"
              href={projectRepoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between p-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
            >
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded flex items-center justify-center font-mono text-xs font-semibold bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 shrink-0">
                  4
                </span>
                <div>
                  <div class="font-heading font-semibold text-xs uppercase tracking-wide">
                    Open Project GitHub Repository
                  </div>
                  <div class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500 truncate max-w-[280px]">
                    {projectRepoUrl.replace('https://github.com/', '')}
                  </div>
                </div>
              </div>
              <svg class="w-4 h-4 text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </>
      )}

      <!-- Edit Reader Page Template -->
      <a
        href={templateEditUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-2.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-900 text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer"
      >
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 rounded flex items-center justify-center font-mono text-xs font-semibold bg-neutral-200 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 shrink-0">
            T
          </span>
          <div>
            <div class="font-heading font-semibold text-xs uppercase tracking-wide">
              Edit Reader Page Template
            </div>
            <div class="font-mono text-[11px] text-neutral-400 dark:text-neutral-500">
              {templateRelativePath}
            </div>
          </div>
        </div>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- Footer Shortcuts -->
    <div class="flex items-center justify-between px-4 py-2.5 border-t border-neutral-200 dark:border-neutral-800 bg-neutral-100/70 dark:bg-neutral-900/70 text-[11px] font-mono text-neutral-500">
      <span>Press <kbd class="px-1 py-0.5 rounded bg-neutral-200 dark:bg-neutral-800 font-semibold text-neutral-700 dark:text-neutral-300">1</kbd> to edit in GitHub</span>
      <span id="hud-copy-status" class="text-[var(--color-accent,#52FF1A)] font-bold opacity-0 transition-opacity duration-150">
        Path copied!
      </span>
    </div>
  </div>
</div>

<script>
  function setupBlogDevHud() {
    const container = document.getElementById('blog-dev-hud');
    const panel = document.getElementById('blog-dev-hud-panel');
    const backdrop = document.getElementById('blog-dev-hud-backdrop');
    const closeBtn = document.getElementById('blog-dev-hud-close');
    const primaryAction = document.getElementById('hud-primary-action') as HTMLAnchorElement | null;
    const viewAction = document.getElementById('hud-view-action') as HTMLAnchorElement | null;
    const projectEditAction = document.getElementById('hud-project-edit-action') as HTMLAnchorElement | null;
    const copyBtn = document.getElementById('hud-copy-post-path');
    const copyStatus = document.getElementById('hud-copy-status');

    let isOpen = false;

    function openHud() {
      if (!container || !panel) return;
      isOpen = true;
      container.classList.remove('hidden');
      container.classList.add('flex');
      container.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        panel.classList.remove('scale-95', 'opacity-0');
        panel.classList.add('scale-100', 'opacity-100');
        if (primaryAction) primaryAction.focus();
      });
      document.body.style.overflow = 'hidden';
    }

    function closeHud() {
      if (!container || !panel) return;
      isOpen = false;
      panel.classList.remove('scale-100', 'opacity-100');
      panel.classList.add('scale-95', 'opacity-0');
      container.setAttribute('aria-hidden', 'true');
      setTimeout(() => {
        if (!isOpen) {
          container.classList.remove('flex');
          container.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }, 150);
    }

    function toggleHud() {
      if (isOpen) {
        closeHud();
      } else {
        openHud();
      }
    }

    // Global Keypress Listener for ` (Backquote)
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      const isTyping =
        target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.isContentEditable;

      if (e.key === '`' || e.code === 'Backquote') {
        if (isTyping) return;
        e.preventDefault();
        toggleHud();
        return;
      }

      if (!isOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeHud();
      } else if (e.key === '1' && primaryAction) {
        e.preventDefault();
        window.open(primaryAction.href, '_blank', 'noopener,noreferrer');
        closeHud();
      } else if (e.key === '2' && viewAction) {
        e.preventDefault();
        window.open(viewAction.href, '_blank', 'noopener,noreferrer');
        closeHud();
      } else if (e.key === '3' && projectEditAction) {
        e.preventDefault();
        window.open(projectEditAction.href, '_blank', 'noopener,noreferrer');
        closeHud();
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeHud);
    if (backdrop) backdrop.addEventListener('click', closeHud);

    // Copy path action
    if (copyBtn && copyStatus) {
      copyBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const path = copyBtn.getAttribute('data-path');
        if (!path) return;
        try {
          await navigator.clipboard.writeText(path);
          copyBtn.textContent = 'Copied!';
          copyStatus.classList.remove('opacity-0');
          copyStatus.classList.add('opacity-100');
          setTimeout(() => {
            copyBtn.textContent = 'Copy Path';
            copyStatus.classList.remove('opacity-100');
            copyStatus.classList.add('opacity-0');
          }, 1500);
        } catch (err) {
          console.error('Failed to copy', err);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBlogDevHud);
  } else {
    setupBlogDevHud();
  }
  document.addEventListener('astro:page-load', setupBlogDevHud);
</script>

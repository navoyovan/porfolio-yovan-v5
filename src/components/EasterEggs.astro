---
// EasterEggs.astro - Standalone Easter Egg Overlay, Popups, and Background Visual Markers
import HoverExpandButton from "./HoverExpandButton.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
---

<!-- Easter Egg Backdrop (Mobile only: locks and dims background touch/scroll when active) -->
<div
  id="egg-backdrop"
  aria-hidden="true"
  class="sm:hidden fixed inset-0 z-40 bg-black/40 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none"
>
</div>

<!-- 01: JAM Digital Clock Floating Popup -->
<div
  id="egg-popup-clock"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  inert
  aria-labelledby="egg-clock-title"
  class="egg-popup-modal popup-hidden fixed bottom-4 inset-x-0 mx-auto sm:inset-x-auto sm:right-6 sm:mx-0 sm:bottom-6 z-50 w-[92vw] max-w-[390px] sm:max-w-[420px] flex flex-col font-sans"
>
  <!-- Floating Dismiss Text Above Popup (Centered on mobile) -->
  <div class="flex items-center justify-center sm:justify-end mb-1 px-1">
    <button
      type="button"
      aria-label="Dismiss Jam Digital popup"
      data-aria-en="Dismiss Jam Digital popup"
      data-aria-id="Tutup pop-up Jam Digital"
      class="egg-popup-close font-mono text-xs text-red-500 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300 hover:underline cursor-pointer select-none transition-colors p-0 bg-transparent border-0 flex items-center justify-center gap-1 w-full sm:w-auto text-center"
    >
      <span
        class="sm:hidden"
        data-en="↓ Swipe down to dismiss"
        data-id="↓ Usap ke bawah untuk menutup">↓ Swipe down to dismiss</span
      >
      <span
        class="hidden sm:inline"
        data-en="Dismiss x [esc]"
        data-id="Tutup x [esc]">Dismiss x [esc]</span
      >
    </button>
  </div>

  <!-- Popup Card -->
  <div
    class="w-full bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300/80 dark:border-neutral-800 shadow-2xl shadow-black/40 overflow-hidden flex flex-col"
  >
    <!-- Media / Viewfinder Container (Exact Original Jam Digital HTML via Iframe) -->
    <div
      class="relative w-full aspect-[16/9.5] bg-[#17D4FE] overflow-hidden border-b border-neutral-300/80 dark:border-neutral-800/80 select-none flex items-center justify-center"
    >
      <iframe
        data-src={`${base}/whatisthis/jAM_jAvaSCriPt.html`}
        title="Jam Digital Clock Interactive Display"
        class="border-0 pointer-events-none select-none shrink-0"
        style="width: 1440px; height: 855px; transform: scale(0.28); transform-origin: center center;"
        loading="lazy"></iframe>
    </div>

    <!-- Content Section (Project Tile Format) -->
    <div class="p-4 sm:p-5 flex flex-col flex-1 gap-3">
      <!-- Category Tag -->
      <span
        class="font-sans text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold"
      >
        00 // COOL STUFF &bull; WEB EXPERIMENT
      </span>

      <!-- Title -->
      <h3
        id="egg-clock-title"
        class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight leading-tight font-heading"
      >
        Jam Digital
      </h3>

      <!-- Description -->
      <p
        class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal"
      >
        An early standalone digital clock project built with vanilla JavaScript,
        CSS text-shadow layering, and DOM timer manipulation.
      </p>

      <!-- Tags Row -->
      <ul
        class="flex flex-wrap gap-1.5 sm:gap-2 pt-1 list-none p-0 m-0"
        aria-label="Tags"
      >
        <li>
          <span
            class="font-sans text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded inline-block"
          >
            VANILLA JS
          </span>
        </li>
        <li>
          <span
            class="font-sans text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded inline-block"
          >
            CSS3 SHADOWS
          </span>
        </li>
        <li>
          <span
            class="font-sans text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded inline-block"
          >
            SETTIMEOUT
          </span>
        </li>
      </ul>

      <!-- Metadata Footer -->
      <div
        class="mt-auto pt-3 border-t border-neutral-200/80 dark:border-neutral-800/80 flex items-center justify-between gap-3 min-w-0"
      >
        <!-- File Name Marquee Container (Loops on Overflow) -->
        <div
          class="egg-marquee-wrapper relative overflow-hidden min-w-0 flex-1"
        >
          <div class="egg-marquee-track inline-flex items-center">
            <div
              class="egg-marquee-content inline-flex items-center text-neutral-400 dark:text-neutral-500 whitespace-nowrap shrink-0 font-mono text-[11px]"
            >
              <span>JAM_jAvaSCriPt.html</span>
              <span
                class="egg-dot-trailing text-neutral-400 dark:text-neutral-600 select-none text-[8px] mx-2.5"
                aria-hidden="true"
              >
                •
              </span>
            </div>
          </div>
        </div>
        <span
          class="font-mono text-[10px] text-neutral-400 dark:text-neutral-500 whitespace-nowrap shrink-0"
        >
          OCT 15, 2019
        </span>
      </div>
    </div>
  </div>
</div>

<!-- 01: First Landing Page (Hello-ween! ASP.NET) Floating Popup -->
<div
  id="egg-popup-first-landing"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"

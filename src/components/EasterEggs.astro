<script>
  (function () {
    let lastFocusedElement: HTMLElement | null = null;

    function initEggMarquees(targetContainer?: HTMLElement | Document) {
      const root = targetContainer || document;
      const wrappers = root.querySelectorAll<HTMLElement>(
        ".egg-marquee-wrapper",
      );
      wrappers.forEach((wrapper) => {
        const track = wrapper.querySelector<HTMLElement>(".egg-marquee-track");
        const content = wrapper.querySelector<HTMLElement>(
          ".egg-marquee-content",
        );
        if (!track || !content) return;

        const wrapperWidth = wrapper.clientWidth;
        if (wrapperWidth === 0) return;

        // Reset styles for clean measurement
        const existingClone = track.querySelector(".egg-marquee-clone");
        if (existingClone) {
          existingClone.remove();
        }
        wrapper.classList.remove("is-overflowing");
        track.style.animation = "none";

        // Measure natural width (trailing dot is hidden when not overflowing)
        const naturalWidth = content.scrollWidth;

        if (naturalWidth > wrapperWidth + 2) {
          // Enable overflowing mode (which reveals trailing dot divider)
          wrapper.classList.add("is-overflowing");

          // Clone with trailing dot included
          const clone = content.cloneNode(true) as HTMLElement;
          clone.classList.add("egg-marquee-clone");
          clone.setAttribute("aria-hidden", "true");
          track.appendChild(clone);

          // Measured unit width includes all items and the trailing divider dot
          const unitWidth = content.scrollWidth;
          // Consistent calm reading pace (~22px/s)
          const duration = Math.max(10, unitWidth / 22);

          track.style.animationName = "marquee-scroll";
          track.style.animationDuration = `${duration}s`;
          track.style.animationTimingFunction = "linear";
          track.style.animationIterationCount = "infinite";
        }
      });
    }

    function closeAllPopups() {
      // 1. Move or blur focus out of any active popup BEFORE setting aria-hidden/inert
      if (
        document.activeElement &&
        document.activeElement.closest(".egg-popup-modal")
      ) {
        if (lastFocusedElement && document.contains(lastFocusedElement)) {
          lastFocusedElement.focus();
        } else {
          (document.activeElement as HTMLElement).blur();
        }
      }

      document.querySelectorAll(".egg-popup-modal").forEach((p) => {
        const el = p as HTMLElement;
        el.style.transform = "";
        el.style.opacity = "";
        el.style.transition = "";
        el.classList.remove("popup-visible", "is-dragging");
        el.classList.add("popup-hidden");
        el.setAttribute("aria-hidden", "true");
        el.setAttribute("inert", "");
      });
      document.querySelectorAll(".egg-popup-modal video").forEach((v) => {
        const video = v as HTMLVideoElement;
        video.pause();
        video.currentTime = 0;
      });
      const backdrop = document.getElementById("egg-backdrop");
      if (backdrop) {
        backdrop.style.opacity = "";
        backdrop.style.transition = "";
        backdrop.classList.remove("opacity-100", "pointer-events-auto");
        backdrop.classList.add("opacity-0", "pointer-events-none");
      }
      document.documentElement.style.overflow = "";
      document.body.style.overflow = "";

      lastFocusedElement = null;
    }

    function openPopup(id: string) {
      const currentActive = document.activeElement as HTMLElement | null;
      if (currentActive && !currentActive.closest(".egg-popup-modal")) {
        lastFocusedElement = currentActive;
      }
      closeAllPopups();
      const popup = document.getElementById(id);
      if (!popup) return;
      popup.removeAttribute("inert");
      popup.setAttribute("aria-hidden", "false");
      const iframe = popup.querySelector(
        "iframe[data-src]",
      ) as HTMLIFrameElement | null;
      if (iframe && !iframe.src) {
        iframe.src = iframe.dataset.src || "";
      }
      const video = popup.querySelector(
        "video[data-src]",
      ) as HTMLVideoElement | null;
      if (video) {
        if (!video.src) {
          video.src = video.dataset.src || "";
        }
        video.play().catch(() => {});
      }
      popup.style.transform = "";
      popup.style.opacity = "";
      popup.style.transition = "";
      popup.classList.remove("popup-hidden");
      popup.classList.add("popup-visible");

      // Focus close button inside popup for screen readers & keyboard users
      requestAnimationFrame(() => {
        const closeBtn = popup.querySelector<HTMLElement>(".egg-popup-close");
        closeBtn?.focus();
        initEggMarquees(popup);
      });

      // Only lock background scroll and activate backdrop overlay on mobile screens (< 640px)
      if (window.innerWidth < 640) {
        const backdrop = document.getElementById("egg-backdrop");
        if (backdrop) {
          backdrop.classList.remove("opacity-0", "pointer-events-none");
          backdrop.classList.add("opacity-100", "pointer-events-auto");
        }
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
      }
    }

    function togglePopup(id: string) {
      const popup = document.getElementById(id);
      if (popup && popup.classList.contains("popup-visible")) {
        closeAllPopups();
      } else {
        openPopup(id);
      }
    }

    // Ensure desktop resize cleanly clears any mobile scroll locks and recalculates marquees
    let lastWidth = typeof window !== "undefined" ? window.innerWidth : 0;
    let resizeTimer: number | null = null;
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 640) {
        document.documentElement.style.overflow = "";
        document.body.style.overflow = "";
        const backdrop = document.getElementById("egg-backdrop");
        if (backdrop) {
          backdrop.classList.remove("opacity-100", "pointer-events-auto");
          backdrop.classList.add("opacity-0", "pointer-events-none");
        }
      }
      if (window.innerWidth !== lastWidth) {
        lastWidth = window.innerWidth;
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          initEggMarquees();
        }, 150);
      }
    });

    // Backdrop dismiss click and touchmove block
    const backdrop = document.getElementById("egg-backdrop");
    if (backdrop) {
      backdrop.addEventListener("click", () => {
        closeAllPopups();
      });
      backdrop.addEventListener(
        "touchmove",
        (e) => {
          if (e.cancelable) e.preventDefault();
        },
        { passive: false },
      );
    }

    // Touch swipe-down to dismiss on mobile
    document.querySelectorAll(".egg-popup-modal").forEach((popupEl) => {
      const popup = popupEl as HTMLElement;
      let touchStartY = 0;
      let currentY = 0;

      popup.addEventListener(
        "touchstart",
        (e) => {
          if (!popup.classList.contains("popup-visible")) return;
          if ((e.target as HTMLElement)?.closest(".egg-popup-close")) return;
          touchStartY = e.touches[0].clientY;
          currentY = touchStartY;
        },
        { passive: false },
      );

      popup.addEventListener(
        "touchmove",
        (e) => {
          if (touchStartY === 0) return;
          if (!popup.classList.contains("popup-visible")) return;
          currentY = e.touches[0].clientY;
          const diff = currentY - touchStartY;
          if (diff > 0) {
            e.preventDefault(); // Stop page scrolling / pull-to-refresh
            popup.classList.add("is-dragging");
            popup.style.transition = "none";
            popup.style.transform = `translateY(${diff}px) scale(1)`;

            // Progress scales down from 1 (at 0px) to 0 (at 220px drag)
            const maxDrag = Math.min(window.innerHeight * 0.4, 220);
            const progress = Math.max(0, Math.min(1, 1 - diff / maxDrag));
            popup.style.opacity = Math.max(0.1, progress).toFixed(3);

            const backdrop = document.getElementById("egg-backdrop");
            if (backdrop) {
              backdrop.style.transition = "none";
              backdrop.style.opacity = progress.toFixed(3);
            }
          }
        },
        { passive: false },
      );

      const handleTouchEnd = () => {
        if (touchStartY === 0) return;
        const diff = currentY - touchStartY;
        popup.classList.remove("is-dragging");

        const backdrop = document.getElementById("egg-backdrop");

        if (diff > 80) {
          popup.style.transition =
            "transform 0.2s ease-out, opacity 0.2s ease-out";
          popup.style.transform = "translateY(100vh) scale(0.95)";
          popup.style.opacity = "0";
          if (backdrop) {
            backdrop.style.transition = "opacity 0.2s ease-out";
            backdrop.style.opacity = "0";
          }
          setTimeout(() => {
            closeAllPopups();
            popup.style.transition = "";
            popup.style.transform = "";
            popup.style.opacity = "";
            if (backdrop) {
              backdrop.style.transition = "";
              backdrop.style.opacity = "";
            }
          }, 200);
        } else {
          popup.style.transition =
            "transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1)";
          popup.style.transform = "translateY(0) scale(1)";
          popup.style.opacity = "1";
          if (backdrop) {
            backdrop.style.transition =
              "opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1)";
            backdrop.style.opacity = "1";
          }
          setTimeout(() => {
            popup.style.transition = "";
            if (backdrop) {
              backdrop.style.transition = "";
            }
          }, 200);
        }
        touchStartY = 0;
        currentY = 0;
      };

      popup.addEventListener("touchend", handleTouchEnd, { passive: true });
      popup.addEventListener("touchcancel", handleTouchEnd, { passive: true });
    });

    // Event delegation on document to guarantee clicks are captured
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const eggBtn = target.closest("[data-easter]");
      if (eggBtn) {
        e.preventDefault();
        e.stopPropagation();
        const easterType = eggBtn.getAttribute("data-easter");
        if (easterType === "jam-clock") {
          togglePopup("egg-popup-clock");
        } else if (easterType === "modpe") {
          togglePopup("egg-popup-modpe");
        } else if (easterType === "ws2812b" || easterType === "gpio") {
          togglePopup("egg-popup-ws2812b");
        } else if (easterType === "brght") {
          togglePopup("egg-popup-brght");
        } else if (easterType === "first-landing" || easterType === "page1") {
          togglePopup("egg-popup-first-landing");
        } else if (easterType === "pertemuan7" || easterType === "formlogin") {
          togglePopup("egg-popup-formlogin");
        }
        return;
      }

      const closeBtn = target.closest(".egg-popup-close");
      if (closeBtn) {
        e.preventDefault();
        closeAllPopups();
        return;
      }
    });

    // Keyboard Trap & Escape Handling for Dialog Modals
    document.addEventListener("keydown", (e) => {
      const activePopup = document.querySelector<HTMLElement>(
        ".egg-popup-modal.popup-visible",
      );
      if (!activePopup) return;

      if (e.key === "Escape") {
        e.preventDefault();
        closeAllPopups();
        return;
      }

      if (e.key === "Tab") {
        const focusables = Array.from(
          activePopup.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        ).filter(
          (el) => !el.hasAttribute("disabled") && el.offsetParent !== null,
        );

        if (focusables.length === 0) return;
        const firstEl = focusables[0];
        const lastEl = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstEl) {
            e.preventDefault();
            lastEl.focus();
          }
        } else {
          if (document.activeElement === lastEl) {
            e.preventDefault();
            firstEl.focus();
          }
        }
      }
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => initEggMarquees());
    } else {
      initEggMarquees();
    }
    document.addEventListener("astro:page-load", () => initEggMarquees());
  })();
</script>

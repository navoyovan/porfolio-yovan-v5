---
// Overview.astro - Curated 01 // Overview Section

interface Props {
  base?: string;
}

const rawBase = Astro.props.base ?? import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;

const coreStack = [
  {
    name: "Laravel",
    category: "Backend Architecture",
    icon: "ti-brand-laravel",
  },
  { name: "React", category: "UI Engineering", icon: "ti-brand-react" },
  {
    name: "Electron",
    category: "Desktop & Kiosk OS",
    icon: "ti-atom-2",
  },
  { name: "Astro", category: "Static & Content Web", icon: "ti-brand-astro" },
  {
    name: "Google Cloud Platform",
    category: "Cloud Infrastructure",
    icon: "ti-cloud",
  },
  { name: "Docker", category: "Containerization", icon: "ti-brand-docker" },
];

const supportingStack = [
  { name: "TypeScript", icon: "ti-brand-typescript" },
  { name: "JavaScript", icon: "ti-brand-javascript" },
  { name: "PHP", icon: "ti-brand-php" },
  { name: "C# / .NET", icon: "ti-brand-c-sharp" },
  { name: "Node.js", icon: "ti-brand-nodejs" },
  { name: "Vite", icon: "ti-brand-vite" },
  { name: "WPF & WebView2", icon: "ti-app-window" },
  { name: "Tailwind CSS", icon: "ti-brand-tailwind" },
  { name: "CSS Modules", icon: "ti-brand-css3" },
  { name: "Zustand", icon: "ti-database-cog" },
  { name: "WebSockets", icon: "ti-broadcast" },
  { name: "RESTful APIs", icon: "ti-api" },
  { name: "IPC Architecture", icon: "ti-arrows-exchange" },
  { name: "ESP32 & IoT", icon: "ti-cpu" },
  { name: "Filament", icon: "ti-layout-dashboard" },
  { name: "SQLite", icon: "ti-database" },
  { name: "MySQL", icon: "ti-brand-mysql" },
  { name: "Google Cloud Storage", icon: "ti-cloud-upload" },
  { name: "SNAP API", icon: "ti-credit-card" },
  { name: "Three.js", icon: "ti-brand-threejs" },
  { name: "Framer Motion", icon: "ti-brand-framer-motion" },
  { name: "GSAP", icon: "ti-keyframes" },
  { name: "Anime.js", icon: "ti-sparkles" },
  { name: "Leaflet.js", icon: "ti-map-2" },
  { name: "Chart.js", icon: "ti-chart-line" },
  { name: "Git & GitHub", icon: "ti-brand-github" },
  { name: "GitHub Pages", icon: "ti-brand-git" },
  { name: "OWASP Guidelines", icon: "ti-shield-check" },
  { name: "SEO & Metadata", icon: "ti-search" },
  { name: "Accessibility (a11y)", icon: "ti-accessible" },
];
---

<!-- 01 // OVERVIEW SECTION (Magazine Spread with Side Core Stack) -->
<section
  id="intro"
  aria-labelledby="heading-intro"
  class="scroll-mt-24 pt-0 space-y-12 overview-section"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pt-0">
    <!-- Left Column: Portrait Photo with Studio Frame -->
    <div
      class="lg:col-span-5 xl:col-span-5 lg:sticky lg:top-24 flex flex-col items-center justify-center pt-0"
      style="transform: translateZ(0);"
    >
      <div
        class="relative w-full max-w-md sm:max-w-lg flex flex-col items-center justify-center border-b border-neutral-300/80 dark:border-neutral-800 overflow-hidden"
        style="transform: translateZ(0); contain: paint;"
      >
        <img
          src={`${base}/images/v.png`}
          alt="Portrait of Yovan Gunardio Darmawan"
          width="540"
          height="540"
          class="relative z-10 w-full max-h-[500px] sm:max-h-[540px] object-contain object-bottom select-none pt-4"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="w-full pt-3 flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500 font-sans px-1">
        <span>Bogor, West Java</span>
        <span class="font-mono text-[11px]">6°35′ S, 106°47′ E</span>
      </div>
    </div>

    <!-- Right Column: Editorial Narrative & Stack -->
    <div class="lg:col-span-7 xl:col-span-7 space-y-8">
      <!-- Headline: Satoshi, 36px, line-height: 1.25, normal weight with thin 'world wide web' -->
      <h2
        class="font-sans font-normal text-2xl sm:text-3xl lg:text-[36px] text-neutral-950 dark:text-white leading-[1.25] tracking-tight m-0"
      >
        <span data-en="Hello, I'm Yovan. I build things for the " data-id="Halo, aku Yovan. Aku bikin ini dan itu buat di ">Hello, I'm Yovan. I build things for the </span><span class="font-light text-neutral-500 dark:text-neutral-400" data-en="world wide web" data-id="internet">world wide web</span><span data-en=" and occasionally things that " data-id=" dan sesekali yang "> and occasionally things that </span><span data-en="talk to machines" data-id="nyambung ke hardware">talk to machines</span>.
      </h2>

      <!-- Unboxed Two Columns -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-4 border-t border-neutral-200/80 dark:border-neutral-800/80">
        <div class="space-y-2">
          <h3 class="font-heading font-bold text-xs uppercase tracking-widest text-neutral-400 dark:text-neutral-500 m-0">
            The Digital Realm
          </h3>
          <p
            class="font-sans text-[14px] leading-relaxed text-neutral-600 dark:text-neutral-400 m-0"
            data-en="Full-stack web applications, interactive dashboards, accessible client portals, and performance-first landing pages built with clean semantic structure."
            data-id="Aplikasi web full-stack, dashboard interaktif, portal klien yang aksesibel, dan landing page berkinerja tinggi dengan struktur semantik rapi."
          >
            Full-stack web applications, interactive dashboards, accessible client portals, and performance-first landing pages built with clean semantic structure.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="font-heading font-bold text-xs uppercase tracking-widest text-neutral-400 dark:text-neutral-500 m-0">
            The Physical Layer
          </h3>
          <p
            class="font-sans text-[14px] leading-relaxed text-neutral-600 dark:text-neutral-400 m-0"
            data-en="Touchscreen kiosks, connected hardware, microcontrollers (ESP32), payment gateway integrations, and direct serial/IPC protocols."
            data-id="Touchscreen kiosk, hardware terhubung, mikrokontroler (ESP32), integrasi payment gateway, dan protokol serial/IPC."
          >
            Touchscreen kiosks, connected hardware, microcontrollers (ESP32), payment gateway integrations, and direct serial/IPC protocols.
          </p>
        </div>
      </div>

      <!-- Lyrical Footnote -->
      <div class="pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80">
        <blockquote class="font-serif italic text-sm sm:text-[15px] text-neutral-500 dark:text-neutral-400 leading-relaxed m-0">
          “A little bit of webapp in my life, a little bit of solder all night long...”
        </blockquote>
        <span class="font-sans text-xs text-neutral-400 dark:text-neutral-500 block pt-1.5">
          — Personal cadence & systems craft
        </span>
      </div>

      <!-- Tech Stack Layout (Original unboxed breathing grid down below) -->
      <div
        class="pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80"
      >
        <!-- Core Stack Header -->
        <div class="flex items-center justify-between pb-6">
          <h3
            class="font-heading font-bold text-xs sm:text-sm uppercase tracking-wider text-neutral-500 dark:text-neutral-400 m-0"
          >
            Core Stack
          </h3>
          <span
            class="font-sans text-[11px] text-neutral-400 dark:text-neutral-500 font-medium"
          >
            {coreStack.length} core • {supportingStack.length} supporting
          </span>
        </div>

        <!-- Core Stack (Icon-as-Object: Unboxed, Breathing Grid) -->
        <ul
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-6 sm:gap-8 list-none m-0 p-0"
          aria-label="Core Technologies"
        >
          {
            coreStack.map((tech) => (
              <li class="flex flex-col space-y-2.5 group cursor-default">
                <div class="text-3xl sm:text-4xl text-neutral-800 dark:text-neutral-200 group-hover:text-[var(--color-accent,#52FF1A)] transition-[transform,color] duration-200 group-hover:-translate-y-1 group-hover:scale-105 inline-flex items-center">
                  <i class={`ti ${tech.icon}`} aria-hidden="true" />
                </div>
                <div class="space-y-0.5">
                  <div class="font-heading font-bold text-sm sm:text-base text-neutral-950 dark:text-white tracking-tight m-0">
                    {tech.name}
                  </div>
                  <div class="font-sans text-[11px] sm:text-xs text-neutral-500 dark:text-neutral-400 leading-tight group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors m-0">
                    {tech.category}
                  </div>
                </div>
              </li>
            ))
          }
        </ul>

        <!-- Ecosystem & Supporting Tools (Magazine Layout) -->
        <div
          class="mt-10 pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80 space-y-3"
        >
          <div class="flex items-center justify-between">
            <h3
              class="font-heading font-bold text-xs uppercase tracking-widest text-neutral-400 dark:text-neutral-500 m-0"
            >
              Ecosystem & Supporting Tools
            </h3>
            <span class="font-sans text-[11px] text-neutral-400 dark:text-neutral-500 font-medium">
              {supportingStack.length} tools
            </span>
          </div>
          <ul
            class="flex flex-wrap items-center gap-x-4 sm:gap-x-5 gap-y-2.5 list-none m-0 p-0"
            aria-label="Ecosystem and Supporting Technologies"
          >
            {
              supportingStack.map((tech) => (
                <li class="inline-flex items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors group">
                  <i
                    class={`ti ${tech.icon} text-sm text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors`}
                    aria-hidden="true"
                  />
                  <span class="font-sans font-medium">{tech.name}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

---
// Concept 1: Large Central Morphing Metaball Field with Organic Noise Surface
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`relative w-full h-full overflow-hidden select-none pointer-events-auto bg-[#121214] ${className}`} id="concept-metaball-container">
  <canvas id="concept-metaball-canvas" class="w-full h-full block" style="display: block; width: 100%; height: 100%;"></canvas>
</div>

<script is:inline>
  (function () {
    function init() {
      const canvas = document.getElementById('concept-metaball-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let w = (canvas.width = canvas.parentElement?.clientWidth || window.innerWidth);
      let h = (canvas.height = canvas.parentElement?.clientHeight || window.innerHeight);

      window.addEventListener('resize', () => {
        w = canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;
        h = canvas.height = canvas.parentElement?.clientHeight || window.innerHeight;
      });

      const metaballs = [
        { x: w * 0.5, y: h * 0.5, r: 160, baseAngle: 0 },
        { x: w * 0.45, y: h * 0.52, r: 130, baseAngle: 1.2 },
        { x: w * 0.55, y: h * 0.48, r: 140, baseAngle: 2.4 },
        { x: w * 0.52, y: h * 0.55, r: 110, baseAngle: 3.6 },
        { x: w * 0.48, y: h * 0.45, r: 125, baseAngle: 4.8 }
      ];

      const stepX = 14;
      const stepY = 18;
      const DENSITY_RAMP = [' ', ' ', ' ', '.', ':', ';', '!', 'i', '1', 'o', 'x', 'X', 'h', 'A', 'M', '%', '#'];

      function pseudoNoise(x, y, t) {
        return (
          Math.sin(x * 0.015 + t * 0.8) * 0.35 +
          Math.cos(y * 0.018 - t * 0.7) * 0.35 +
          Math.sin((x + y) * 0.012 + t * 0.5) * 0.3
        );
      }

      let last = performance.now();

      function animate(t) {
        const nowSec = t * 0.001;
        const dt = Math.min((t - last) / 1000, 0.1);
        last = t;

        ctx.fillStyle = '#121214';
        ctx.fillRect(0, 0, w, h);

        const centerOrigX = w * 0.5;
        const centerOrigY = h * 0.5;

        for (let i = 0; i < metaballs.length; i++) {
          const m = metaballs[i];
          m.baseAngle += 0.4 * dt;
          const wanderX = Math.cos(m.baseAngle * 1.1 + i) * 140;
          const wanderY = Math.sin(m.baseAngle * 0.8 + i) * 110;
          const targetX = centerOrigX + wanderX;
          const targetY = centerOrigY + wanderY;
          m.x += (targetX - m.x) * 0.08;
          m.y += (targetY - m.y) * 0.08;
        }

        ctx.font = '12px "Consolas", monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        const cols = Math.floor(w / stepX);
        const rows = Math.floor(h / stepY);

        for (let r = 0; r <= rows; r++) {
          const py = r * stepY;
          for (let c = 0; c <= cols; c++) {
            const px = c * stepX;
            let field = 0;
            for (let i = 0; i < metaballs.length; i++) {
              const mb = metaballs[i];
              const dx = px - mb.x;
              const dy = py - mb.y;
              const d2 = dx * dx + dy * dy;
              field += (mb.r * mb.r) / (d2 + 1200);
            }

            const n = pseudoNoise(px, py, nowSec);
            const totalVal = field + n * 0.28;

            if (totalVal > 0.45) {
              const norm = Math.min(1, Math.max(0, (totalVal - 0.45) / 1.3));
              const glyphIdx = Math.floor(norm * (DENSITY_RAMP.length - 1));
              const ch = DENSITY_RAMP[glyphIdx];
              if (ch !== ' ') {
                const alpha = 0.2 + norm * 0.75;
                ctx.fillStyle = `rgba(235, 235, 245, ${alpha.toFixed(2)})`;
                ctx.fillText(ch, px, py);
              }
            }
          }
        }

        requestAnimationFrame(animate);
      }

      requestAnimationFrame(animate);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>

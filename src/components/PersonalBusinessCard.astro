---
// PersonalBusinessCard.astro - Skeuomorphic 3D Parallax Digital Calling Card
interface Props {
  latinMode?: boolean;
  id?: string;
}

const { latinMode = false, id = 'skeuo-card-1' } = Astro.props;

const cardTitle = latinMode ? 'IOVAN GUNARDIO DARMAWAN' : 'Yovan Gunardio Darmawan';
const cardRole = latinMode ? 'ARCHITECTUS SYSTEMATUM' : 'Systems & Software Engineer';
const cardStatus = latinMode ? 'STATUS_VIVUS' : 'AVAILABLE';
const cardSys = latinMode ? 'CHARTA_IDENTITATIS_v5.2' : 'SYS // CARD_v5.2';
const cardResume = latinMode ? 'CURRICULUM VITAE ↗' : 'Resume ↗';
---

<div
  id={`${id}-container`}
  class="skeuo-card-container relative w-full max-w-[440px] select-none cursor-pointer py-2"
  style="perspective: 1200px;"
>
  <!-- 3D Transformable Card Body -->
  <div
    id={`${id}-card`}
    class="skeuo-card-body relative w-full aspect-[1.72/1] min-h-[240px] rounded-2xl p-6 sm:p-7 flex flex-col justify-between overflow-hidden transition-transform duration-100 ease-out will-change-transform"
    style="
      transform-style: preserve-3d;
      background: radial-gradient(130% 130% at 20% 15%, #1e1e24 0%, #121215 55%, #0a0a0d 100%);
      box-shadow:
        0 1px 0 1px rgba(255, 255, 255, 0.12) inset,
        0 -1px 0 1px rgba(0, 0, 0, 0.7) inset,
        0 20px 40px -15px rgba(0, 0, 0, 0.8),
        0 0 0 1px rgba(255, 255, 255, 0.08);
    "
  >
    <!-- Card Surface Textures: Micro-grain & Fine Carbon Edge -->
    <div
      class="absolute inset-0 pointer-events-none opacity-40 mix-blend-overlay rounded-2xl"
      style="background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 8px 8px;"
      aria-hidden="true"
    ></div>

    <!-- Dynamic Specular Glare Layer (Follows Mouse Cursor in Parallax) -->
    <div
      class="skeuo-card-glare absolute inset-0 pointer-events-none rounded-2xl opacity-0 transition-opacity duration-300 mix-blend-color-dodge z-30"
      style="background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.05) 45%, transparent 75%);"
      aria-hidden="true"
    ></div>

    <!-- Holographic Rainbow Foil Reflection Strip -->
    <div
      class="skeuo-card-foil absolute inset-0 pointer-events-none rounded-2xl opacity-15 mix-blend-color-dodge transition-opacity duration-300 z-20"
      style="background: linear-gradient(115deg, transparent 20%, rgba(82,255,26,0.3) 40%, rgba(0,210,255,0.35) 50%, rgba(255,0,128,0.25) 60%, transparent 80%); background-size: 200% 200%; background-position: 50% 50%;"
      aria-hidden="true"
    ></div>

    <!-- TOP SECTION: EMV Smart Chip + Contactless NFC Waves + Status Beacon -->
    <div class="relative z-10 flex items-center justify-between" style="transform: translateZ(24px);">
      <!-- Gold EMV Microchip Specimen -->
      <div class="flex items-center gap-3">
        <div
          class="relative w-11 h-8.5 rounded-md p-0.5 overflow-hidden shadow-sm"
          style="
            background: linear-gradient(135deg, #d6ae5c 0%, #fae29c 35%, #b38938 70%, #f0d58a 100%);
            box-shadow: inset 0 1px 1px rgba(255,255,255,0.6), 0 2px 5px rgba(0,0,0,0.5);
            border: 1px solid rgba(138, 100, 29, 0.8);
          "
          aria-hidden="true"
        >
          <!-- Smart Chip Circuit Etching Lines -->
          <div class="w-full h-full border border-black/30 rounded-[3px] grid grid-cols-3 grid-rows-2 gap-[2px] p-[2px] opacity-75">
            <div class="border-r border-b border-black/40"></div>
            <div class="border-r border-b border-black/40"></div>
            <div class="border-b border-black/40"></div>
            <div class="border-r border-black/40"></div>
            <div class="border-r border-black/40"></div>
            <div></div>
          </div>
        </div>

        <!-- Contactless NFC Wave Icon -->
        <svg
          class="w-5 h-5 text-neutral-400/80 drop-shadow-sm rotate-90"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12.55a11 11 0 0 1 14.08 0"></path>
          <path d="M1.42 9a16 16 0 0 1 21.16 0"></path>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
          <line x1="12" y1="20" x2="12.01" y2="20"></line>
        </svg>
      </div>

      <!-- Live Status Diode Lens -->
      <div
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/60 border border-neutral-700/60 backdrop-blur-xs font-mono text-[9.5px] text-neutral-300 shadow-inner"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent,#52FF1A)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent,#52FF1A)] shadow-[0_0_8px_var(--color-accent,#52FF1A)]"></span>
        </span>
        <span class="tracking-wider uppercase font-semibold text-neutral-200">{cardStatus}</span>
      </div>
    </div>

    <!-- MIDDLE SECTION: Letterpress Foil-Debossed Typography -->
    <div class="relative z-10 pt-2 space-y-1" style="transform: translateZ(30px);">
      <h3
        class="font-heading font-black text-xl sm:text-2xl text-white tracking-tight leading-none drop-shadow-[0_1px_2px_rgba(0,0,0,0.9)]"
        style="text-shadow: 0 1px 1px rgba(0,0,0,0.9), 0 -1px 1px rgba(255,255,255,0.12);"
      >
        {cardTitle}
      </h3>
      <div class="flex items-center gap-2">
        <p class="font-sans text-xs sm:text-sm text-neutral-300 font-semibold tracking-wide">
          {cardRole}
        </p>
        <span class="text-neutral-500 font-mono text-xs">•</span>
        <span class="font-mono text-[10px] text-[var(--color-accent,#52FF1A)] tracking-widest uppercase">
          DEV // 0x59
        </span>
      </div>
    </div>

    <!-- BOTTOM TRANSMISSION ROW: Recessed Email Bar + Physical Action Chips -->
    <div class="relative z-10 space-y-3" style="transform: translateZ(26px);">
      <!-- Recessed Matte Email Strip -->
      <div
        class="flex items-center justify-between gap-2 px-3 py-2 rounded-lg bg-black/70 border border-white/10 shadow-[inset_0_2px_4px_rgba(0,0,0,0.8)]"
      >
        <a
          href="mailto:yovangunardio@gmail.com"
          class="font-mono text-xs sm:text-[12.5px] text-neutral-200 hover:text-[var(--color-accent,#52FF1A)] transition-colors truncate focus-visible:outline-none focus-visible:underline"
          aria-label="Email yovangunardio@gmail.com"
        >
          yovangunardio@gmail.com
        </a>

        <button
          type="button"
          class="copy-card-email-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10.5px] font-mono font-semibold uppercase tracking-wider text-neutral-300 hover:text-white bg-neutral-800/80 hover:bg-neutral-700 border border-white/15 shadow-xs transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[var(--color-accent,#52FF1A)] shrink-0"
          data-email="yovangunardio@gmail.com"
          aria-label="Copy email address"
        >
          <span class="copy-text">Copy</span>
        </button>
      </div>

      <!-- Embossed Action Badges -->
      <div class="flex items-center justify-between gap-2 pt-0.5 text-xs font-mono">
        <div class="flex items-center gap-2">
          <a
            href="https://github.com/navoyovan"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[11px] text-neutral-400 hover:text-white transition-colors py-0.5 px-1.5 rounded hover:bg-white/5"
            aria-label="GitHub Profile (opens in new tab)"
          >
            <i class="ti ti-brand-github text-xs" aria-hidden="true"></i>
            <span>GitHub ↗</span>
          </a>
          <a
            href="https://linkedin.com/in/yovan-g-d-22379ba7/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[11px] text-neutral-400 hover:text-white transition-colors py-0.5 px-1.5 rounded hover:bg-white/5"
            aria-label="LinkedIn Profile (opens in new tab)"
          >
            <i class="ti ti-brand-linkedin text-xs" aria-hidden="true"></i>
            <span>LinkedIn ↗</span>
          </a>
        </div>

        <a
          href="https://docs.google.com/document/d/1dlUKA5EGLI3qPxEOfJ3acjt4tA39oxKy_Fs1Z_JM0Pk/export?format=pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[10.5px] text-white hover:text-white font-semibold py-1 px-2.5 rounded-md bg-white/10 hover:bg-white/20 border border-white/15 shadow-sm transition-colors"
          aria-label="Download Resume / CV as PDF"
        >
          <span>{cardResume}</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    function setupAllSkeuoParallaxCards() {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll('.skeuo-card-container').forEach((container) => {
        if (container.dataset.parallaxActive === 'true') return;
        container.dataset.parallaxActive = 'true';

        const card = container.querySelector('.skeuo-card-body');
        const glare = container.querySelector('.skeuo-card-glare');
        const foil = container.querySelector('.skeuo-card-foil');

        if (!card || !glare) return;
        if (prefersReduced) return;

        let bounds = null;

        function updateBounds() {
          bounds = container.getBoundingClientRect();
        }

        container.addEventListener('mouseenter', () => {
          updateBounds();
          card.style.transition = 'transform 0.12s ease-out, box-shadow 0.12s ease-out';
          glare.style.opacity = '1';
          if (foil) foil.style.opacity = '0.35';
        });

        container.addEventListener('mousemove', (e) => {
          if (!bounds) updateBounds();
          const mouseX = e.clientX - bounds.left;
          const mouseY = e.clientY - bounds.top;

          const xPct = Math.max(0, Math.min(1, mouseX / bounds.width));
          const yPct = Math.max(0, Math.min(1, mouseY / bounds.height));

          const rotX = ((0.5 - yPct) * 22).toFixed(2);
          const rotY = ((xPct - 0.5) * 24).toFixed(2);

          const shadowX = -rotY * 1.8;
          const shadowY = Math.max(15, rotX * 1.8 + 25);
          const shadowBlur = 35 + Math.abs(rotX) + Math.abs(rotY);

          card.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) scale3d(1.03, 1.03, 1.03)`;
          card.style.boxShadow = `
            0 1px 0 1px rgba(255, 255, 255, 0.18) inset,
            0 -1px 0 1px rgba(0, 0, 0, 0.8) inset,
            ${shadowX.toFixed(1)}px ${shadowY.toFixed(1)}px ${shadowBlur.toFixed(1)}px rgba(0, 0, 0, 0.85),
            0 0 0 1px rgba(255, 255, 255, 0.12)
          `;

          glare.style.background = `radial-gradient(circle at ${xPct * 100}% ${yPct * 100}%, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.06) 45%, transparent 80%)`;

          if (foil) {
            foil.style.backgroundPosition = `${(xPct * 100).toFixed(1)}% ${(yPct * 100).toFixed(1)}%`;
          }
        });

        container.addEventListener('mouseleave', () => {
          card.style.transition = 'transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.65s cubic-bezier(0.16, 1, 0.3, 1)';
          card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
          card.style.boxShadow = `
            0 1px 0 1px rgba(255, 255, 255, 0.12) inset,
            0 -1px 0 1px rgba(0, 0, 0, 0.7) inset,
            0 20px 40px -15px rgba(0, 0, 0, 0.8),
            0 0 0 1px rgba(255, 255, 255, 0.08)
          `;
          glare.style.opacity = '0';
          if (foil) foil.style.opacity = '0.15';
        });

        window.addEventListener('resize', updateBounds, { passive: true });
      });
    }

    function setupCopyButtons() {
      document.querySelectorAll('.copy-card-email-btn').forEach((btn) => {
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const email = btn.getAttribute('data-email');
          if (!email) return;
          try {
            await navigator.clipboard.writeText(email);
            const label = btn.querySelector('.copy-text');
            if (label) {
              const orig = label.textContent;
              label.textContent = 'COPIED!';
              btn.classList.add('text-[var(--color-accent,#52FF1A)]');
              setTimeout(() => {
                label.textContent = orig;
                btn.classList.remove('text-[var(--color-accent,#52FF1A)]');
              }, 1800);
            }
          } catch {
            window.location.href = `mailto:${email}`;
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setupAllSkeuoParallaxCards();
        setupCopyButtons();
      });
    } else {
      setupAllSkeuoParallaxCards();
      setupCopyButtons();
    }
    document.addEventListener('astro:page-load', () => {
      setupAllSkeuoParallaxCards();
      setupCopyButtons();
    });
  })();
</script>

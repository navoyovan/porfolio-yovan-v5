---
import fallbackData from '../data/github-contributions-all.json';

interface ContributionDay {
  date: string;
  count: number;
  level: number;
  placeholder?: boolean;
}

let allContributions: ContributionDay[] = fallbackData.contributions;

try {
  const res = await fetch('https://github-contributions-api.jogruber.de/v4/navoyovan', {
    signal: AbortSignal.timeout(2500),
    headers: { 'User-Agent': 'navoyovan-portfolio-build' },
  });
  if (res.ok) {
    const json = await res.json();
    if (json?.contributions && json.contributions.length > 0) {
      allContributions = json.contributions;
    }
  }
} catch {
  // Gracefully use local cached fallback
}

const todayStr = new Date().toISOString().split('T')[0];

// Sort chronologically ascending
const sorted = allContributions.slice().sort((a, b) => a.date.localeCompare(b.date));

// Filter up to today
const filtered = sorted.filter((c) => c.date <= todayStr);

// Take ~2 years (730 days) and align to previous Sunday
const approx = filtered.slice(-730);
const firstDate = new Date(approx[0].date);
const dayOfWeek = firstDate.getDay();
const startIndex = filtered.length - 730 - dayOfWeek;
const days: ContributionDay[] = filtered.slice(startIndex);

// Pad end of last week to Saturday so every column has exactly 7 rows
const remainder = days.length % 7;
const padCount = remainder === 0 ? 0 : 7 - remainder;
for (let i = 0; i < padCount; i++) {
  days.push({ date: '', count: 0, level: 0, placeholder: true });
}

const availableWeeks = Math.ceil(days.length / 7);

// Responsive span tiers:
// Desktop (>= 1300px): 95 weeks (1.8y), gap 4px
// Medium (640px - 1299px, 4:3 screens & split windows): 64 weeks (1.2y), gap 3px
// Mobile (< 640px): 52 weeks (1.0y), gap 3px
const DESKTOP_WEEKS = 95;
const MEDIUM_WEEKS = 64;
const MOBILE_WEEKS = 52;

const startWeekOffset = Math.max(0, availableWeeks - DESKTOP_WEEKS);

// Build 95 weeks of 7-day columns
const weeks: ContributionDay[][] = [];
for (let w = 0; w < DESKTOP_WEEKS; w++) {
  const sliceStart = (startWeekOffset + w) * 7;
  weeks.push(days.slice(sliceStart, sliceStart + 7));
}

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const [year, month, day] = dateStr.split('-');
  const d = new Date(Number(year), Number(month) - 1, Number(day));
  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<!-- Temporary Live UI Tuner Bar (Per /live-ui-tuner skill) -->
<div
  id="ui-tuner-bar"
  class="w-full bg-[#fcfbf9] dark:bg-[#0e0e0e] border-y border-neutral-300 dark:border-neutral-800 px-4 py-2.5 flex flex-wrap items-center gap-4 text-xs font-mono select-none z-50 transition-colors"
>
  <span class="font-bold text-[11px] text-[var(--color-accent,#52FF1A)] flex items-center gap-1.5">
    <span class="w-2 h-2 rounded-full bg-[var(--color-accent,#52FF1A)] animate-pulse"></span>
    // LIVE NAME TUNER:
  </span>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
    <span>Font:</span>
    <select
      id="tune-font-family"
      class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded px-2 py-1 text-xs cursor-pointer text-neutral-900 dark:text-white font-mono max-w-[210px]"
    >
      <optgroup label="Neue Machina Versions">
        <option value="'Neue Machina v2 Inktrap', 'Neue Machina', sans-serif" selected>Neue Machina v2 (Inktrap)</option>
        <option value="'Neue Machina v2 Plain', sans-serif">Neue Machina v2 (Plain)</option>
        <option value="'Neue Machina v1', sans-serif">Neue Machina v1 (Original)</option>
      </optgroup>
      <optgroup label="Dev Menu Fonts (Keypress `)">
        <option value="'Syne', sans-serif">Syne (Default Heading)</option>
        <option value="'Clash Display', sans-serif">Clash Display (Editorial Brutal)</option>
        <option value="'General Sans', sans-serif">General Sans (Brutal Sans)</option>
        <option value="'Plus Jakarta Sans', sans-serif">Plus Jakarta Sans (Swiss Modern)</option>
        <option value="'Inter', sans-serif">Inter (Swiss Sans)</option>
        <option value="'Space Grotesk', sans-serif">Space Grotesk (Tech Mono Heading)</option>
        <option value="'Space Mono', monospace">Space Mono (Tech Monospace)</option>
        <option value="'Fraunces', serif">Fraunces (Archival Serif)</option>
        <option value="'Oswald', sans-serif">Oswald (Neo Industrial)</option>
        <option value="'DM Sans', sans-serif">DM Sans (Industrial Sans)</option>
        <option value="'Press Start 2P', monospace">Press Start 2P (Pixel)</option>
        <option value="'Outfit', sans-serif">Outfit (Global Sans)</option>
      </optgroup>
    </select>
  </label>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
    <span>Variant:</span>
    <select
      id="tune-name-preset"
      class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded px-2 py-1 text-xs cursor-pointer text-neutral-900 dark:text-white font-mono"
    >
      <option value="gunard-io-stacked">YOVAN; / GUNARD.IO (Domain Stacked)</option>
      <option value="gunard-io-inline">yovan gunard.io (Domain Inline)</option>
      <option value="logo">yovan; (Signature Logo)</option>
      <option value="stacked-darmawan" selected>YOVAN; / DARMAWAN. (Astro Style)</option>
      <option value="stacked-gunardio">YOVAN; / GUNARDIO.</option>
      <option value="full-stacked">YOVAN GUNARDIO / DARMAWAN;</option>
      <option value="brand-role">yovan; / systems engineer</option>
      <option value="single-line">yovan gunardio darmawan;</option>
      <option value="custom">Custom Text...</option>
    </select>
  </label>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300 cursor-pointer">
    <input
      id="tune-uppercase"
      type="checkbox"
      checked
      class="w-3.5 h-3.5 accent-[var(--color-accent,#52FF1A)] cursor-pointer"
    />
    <span>UPPERCASE</span>
  </label>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300 cursor-pointer">
    <input
      id="tune-capitalize"
      type="checkbox"
      class="w-3.5 h-3.5 accent-[var(--color-accent,#52FF1A)] cursor-pointer"
    />
    <span>Capitalize Each Word</span>
  </label>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
    <span>Size:</span>
    <input
      id="tune-font-size"
      type="range"
      min="18"
      max="64"
      step="2"
      value="36"
      class="cursor-pointer accent-[var(--color-accent,#52FF1A)] w-20 sm:w-24"
    />
    <span id="val-font-size" class="font-bold text-neutral-900 dark:text-neutral-100 w-10">36px</span>
  </label>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
    <span>Weight:</span>
    <select
      id="tune-font-weight"
      class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded px-2 py-1 text-xs cursor-pointer text-neutral-900 dark:text-white font-mono"
    >
      <option value="300">300 (Light)</option>
      <option value="400">400 (Regular)</option>
      <option value="600">600 (Semibold)</option>
      <option value="700">700 (Bold)</option>
      <option value="800">800 (Extrabold)</option>
      <option value="900" selected>900 (Black)</option>
    </select>
  </label>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
    <span>Tracking:</span>
    <input
      id="tune-letter-spacing"
      type="range"
      min="-4"
      max="12"
      step="0.5"
      value="-1"
      class="cursor-pointer accent-[var(--color-accent,#52FF1A)] w-20"
    />
    <span id="val-letter-spacing" class="font-bold text-neutral-900 dark:text-neutral-100 w-12">-1px</span>
  </label>

  <label class="flex items-center gap-1.5 text-neutral-700 dark:text-neutral-300">
    <span>Shadow:</span>
    <select
      id="tune-shadow"
      class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 rounded px-2 py-1 text-xs cursor-pointer text-neutral-900 dark:text-white font-mono"
    >
      <option value="adaptive" selected>Adaptive (Light Glow / Dark Shade)</option>
      <option value="light-glow">Light Glow (High Contrast)</option>
      <option value="dark-shade">Dark Shadow</option>
      <option value="none">None</option>
    </select>
  </label>

  <div id="custom-text-wrapper" class="hidden items-center gap-1.5">
    <input
      id="tune-custom-text"
      type="text"
      placeholder="Type custom text..."
      class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 px-2 py-1 text-xs font-mono text-neutral-900 dark:text-white rounded w-44"
    />
  </div>

  <div class="flex items-center gap-2 ml-auto">
    <input
      id="tune-output"
      type="text"
      readonly
      class="bg-neutral-100 dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 px-2 py-1 text-xs font-mono text-neutral-800 dark:text-neutral-200 rounded w-52 sm:w-64 select-all"
    />
    <button
      id="tune-copy-btn"
      type="button"
      class="px-3 py-1 font-bold rounded bg-neutral-900 text-white dark:bg-white dark:text-neutral-950 hover:opacity-90 transition-opacity cursor-pointer text-xs"
    >
      Copy
    </button>
  </div>
</div>

<section
  id="github-contrib-section"
  aria-label="GitHub Contributions Telemetry"
  class="w-full bg-[#fcfbf9] dark:bg-[#0e0e0e] transition-colors duration-200 py-0 overflow-hidden"
>
  <!-- Telemetry Header -->
  <div class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto py-2">
    <div class="flex items-center justify-between gap-3 min-h-[1.5rem]">
      <div class="flex items-center">
        <span
          id="github-contrib-status"
          class="font-mono text-[11px] font-medium text-neutral-900 dark:text-neutral-200 transition-opacity duration-150 min-h-[1.25rem] inline-flex items-center select-none"
        ></span>
      </div>

      <div class="flex items-center gap-4">
        <!-- Level Legend (Borderless) -->
        <div
          class="hidden sm:flex items-center gap-1.5 text-[10px] font-mono text-neutral-400 dark:text-neutral-500 select-none"
          aria-hidden="true"
        >
          <span>Less</span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-neutral-200 dark:bg-[#1c1c1c]"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-[#9be9a8] dark:bg-[#0e4429]"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-[#40c463] dark:bg-[#006d32]"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-[#30a14e] dark:bg-[#26a641]"></span>
          <span class="w-2.5 h-2.5 rounded-[2px] bg-[var(--color-accent,#1b7f3b)] dark:bg-[var(--color-accent,#52FF1A)]"></span>
          <span>More</span>
        </div>

        <!-- GitHub Profile Link -->
        <a
          href="https://github.com/navoyovan"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1.5 font-mono text-[11px] text-neutral-500 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded py-0.5 px-1"
          aria-label="View Yovan's GitHub profile (@navoyovan)"
        >
          <span>@navoyovan</span>
          <svg
            class="w-3 h-3 text-neutral-400 group-hover:text-neutral-950 dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17l9.2-9.2M17 17V8H8"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Heatmap: Pure borderless grid with name overlay -->
  <div class="relative w-full overflow-hidden">
    <div class="w-full overflow-x-auto scrollbar-none px-0 py-3 sm:py-4">
      <div
        id="github-contrib-grid"
        class="flex flex-row w-full px-0 select-none min-w-full gap-[3px] min-[1300px]:gap-[4px]"
      >
        {
          weeks.map((weekDays, wIdx) => {
            // Responsive week visibility:
            // Weeks 0..30 (first 31 weeks): desktop only (>= 1300px)
            // Weeks 31..42 (next 12 weeks): medium (4:3 / split screen, 640px-1299px) & desktop
            // Weeks 43..94 (last 52 weeks): all viewports (mobile, medium, desktop)
            let visibilityClass = 'flex';
            if (wIdx < DESKTOP_WEEKS - MEDIUM_WEEKS) {
              visibilityClass = 'hidden min-[1300px]:flex';
            } else if (wIdx < DESKTOP_WEEKS - MOBILE_WEEKS) {
              visibilityClass = 'hidden sm:flex';
            }

            return (
              <div
                class={`${visibilityClass} flex-col flex-1 gap-[3px] min-[1300px]:gap-[4px] min-w-0`}
                data-week={wIdx}
              >
                {weekDays.map((day) => {
                  if (day.placeholder) {
                    return (
                      <div
                        class="aspect-square w-full opacity-0 pointer-events-none"
                        aria-hidden="true"
                      />
                    );
                  }
                  const formattedDate = formatDate(day.date);
                  const countText = `${day.count} contribution${day.count === 1 ? '' : 's'}`;
                  const label = `${countText} on ${formattedDate}`;

                  let levelClasses = 'bg-neutral-200 dark:bg-[#1c1c1c]';
                  if (day.level === 1)
                    levelClasses = 'bg-[#9be9a8] dark:bg-[#0e4429]';
                  else if (day.level === 2)
                    levelClasses = 'bg-[#40c463] dark:bg-[#006d32]';
                  else if (day.level === 3)
                    levelClasses = 'bg-[#30a14e] dark:bg-[#26a641]';
                  else if (day.level >= 4)
                    levelClasses = 'bg-[var(--color-accent,#1b7f3b)] dark:bg-[var(--color-accent,#52FF1A)] dark:shadow-[0_0_8px_rgba(82,255,26,0.35)]';

                  return (
                    <div
                      tabindex="0"
                      role="gridcell"
                      aria-label={label}
                      data-count={day.count}
                      data-date={formattedDate}
                      data-label={label}
                      class={`aspect-square w-full rounded-[1px] sm:rounded-[2px] transition-transform duration-100 hover:scale-130 hover:z-10 hover:shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-neutral-950 dark:focus-visible:ring-white cursor-pointer ${levelClasses}`}
                    />
                  );
                })}
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Editorial Name Overlay Container -->
    <div
      class="absolute inset-y-0 left-0 flex items-center pl-4 sm:pl-8 lg:pl-12 pointer-events-none select-none z-20"
      aria-hidden="true"
    >
      <div
        id="name-overlay-content"
        class="font-heading font-black tracking-tight uppercase leading-[0.86] text-neutral-950 dark:text-white drop-shadow-[0_2px_12px_rgba(252,251,249,0.95)] dark:drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)]"
        style="font-size: 36px;"
      >
        <div>YOVAN<span class="text-[var(--color-accent,#52FF1A)]">;</span></div>
        <div class="text-neutral-500 dark:text-neutral-400">DARMAWAN.</div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function setupTunerAndTelemetry() {
      const grid = document.getElementById('github-contrib-grid');
      const status = document.getElementById('github-contrib-status');
      const overlay = document.getElementById('name-overlay-content');

      const fontSelect = document.getElementById('tune-font-family');
      const presetSelect = document.getElementById('tune-name-preset');
      const upperCheck = document.getElementById('tune-uppercase');
      const capCheck = document.getElementById('tune-capitalize');
      const sizeInput = document.getElementById('tune-font-size');
      const sizeVal = document.getElementById('val-font-size');
      const weightSelect = document.getElementById('tune-font-weight');
      const trackingInput = document.getElementById('tune-letter-spacing');
      const trackingVal = document.getElementById('val-letter-spacing');
      const shadowSelect = document.getElementById('tune-shadow');
      const customWrapper = document.getElementById('custom-text-wrapper');
      const customInput = document.getElementById('tune-custom-text');
      const output = document.getElementById('tune-output');
      const copyBtn = document.getElementById('tune-copy-btn');

      const FONT_STYLESHEETS = {
        "'Plus Jakarta Sans', sans-serif": 'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap',
        "'Inter', sans-serif": 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap',
        "'Clash Display', sans-serif": 'https://api.fontshare.com/v2/css?f[]=clash-display@700,600&display=swap',
        "'General Sans', sans-serif": 'https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap',
        "'Space Grotesk', sans-serif": 'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&display=swap',
        "'Space Mono', monospace": 'https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap',
        "'Fraunces', serif": 'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800&display=swap',
        "'Oswald', sans-serif": 'https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&display=swap',
        "'DM Sans', sans-serif": 'https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap',
      };

      const PRESETS = {
        'gunard-io-stacked': `<div>yovan<span class="text-[var(--color-accent,#52FF1A)]">;</span></div><div class="text-neutral-500 dark:text-neutral-400">gunard<span class="text-[var(--color-accent,#52FF1A)]">.io</span></div>`,
        'gunard-io-inline': `<span>yovan</span> <span class="text-neutral-500 dark:text-neutral-400">gunard</span><span class="text-[var(--color-accent,#52FF1A)]">.io</span>`,
        'logo': `<span>yovan</span><span class="text-[var(--color-accent,#52FF1A)] ml-[1px]">;</span>`,
        'stacked-darmawan': `<div>yovan<span class="text-[var(--color-accent,#52FF1A)]">;</span></div><div class="text-neutral-500 dark:text-neutral-400">darmawan.</div>`,
        'stacked-gunardio': `<div>yovan<span class="text-[var(--color-accent,#52FF1A)]">;</span></div><div class="text-neutral-500 dark:text-neutral-400">gunardio.</div>`,
        'full-stacked': `<div>yovan gunardio</div><div class="text-neutral-500 dark:text-neutral-400">darmawan<span class="text-[var(--color-accent,#52FF1A)]">;</span></div>`,
        'brand-role': `<div>yovan<span class="text-[var(--color-accent,#52FF1A)]">;</span></div><div class="text-[0.45em] font-mono tracking-widest text-neutral-500 dark:text-neutral-400">systems engineer</div>`,
        'single-line': `<span>yovan gunardio darmawan</span><span class="text-[var(--color-accent,#52FF1A)]">;</span>`,
      };

      if (presetSelect && upperCheck && capCheck && sizeInput && weightSelect && trackingInput && overlay && output && copyBtn) {
        const updateNameTuner = () => {
          const preset = presetSelect.value;
          const fontSize = parseInt(sizeInput.value, 10);
          const fontWeight = weightSelect.value;
          const tracking = parseFloat(trackingInput.value);
          const fontFamily = fontSelect ? fontSelect.value : "'Neue Machina', sans-serif";

          // Dynamically load remote stylesheet if chosen font requires it
          if (FONT_STYLESHEETS[fontFamily]) {
            const url = FONT_STYLESHEETS[fontFamily];
            if (!document.querySelector(`link[href="${url}"]`)) {
              const link = document.createElement('link');
              link.rel = 'stylesheet';
              link.href = url;
              document.head.appendChild(link);
            }
          }

          let textTransform = 'none';
          if (upperCheck.checked) textTransform = 'uppercase';
          else if (capCheck.checked) textTransform = 'capitalize';

          sizeVal.textContent = `${fontSize}px`;
          trackingVal.textContent = `${tracking}px`;

          overlay.style.fontFamily = fontFamily;
          overlay.style.fontSize = `${fontSize}px`;
          overlay.style.fontWeight = fontWeight;
          overlay.style.letterSpacing = `${tracking}px`;
          overlay.style.textTransform = textTransform;

          if (preset === 'custom') {
            customWrapper.classList.remove('hidden');
            customWrapper.classList.add('flex');
            const customVal = customInput.value || 'YOUR NAME';
            overlay.innerHTML = `<div>${customVal}</div>`;
          } else {
            customWrapper.classList.add('hidden');
            customWrapper.classList.remove('flex');
            overlay.innerHTML = PRESETS[preset] || PRESETS['stacked-darmawan'];
          }

          const fontLabel = fontSelect ? fontSelect.options[fontSelect.selectedIndex].text : 'Neue Machina';
          const shadow = shadowSelect ? shadowSelect.value : 'adaptive';

          if (shadow === 'light-glow') {
            overlay.style.filter = 'drop-shadow(0 2px 12px rgba(252, 251, 249, 0.95))';
          } else if (shadow === 'dark-shade') {
            overlay.style.filter = 'drop-shadow(0 2px 14px rgba(0, 0, 0, 0.95))';
          } else if (shadow === 'none') {
            overlay.style.filter = 'none';
          } else {
            overlay.style.filter = '';
          }

          output.value = `font: "${fontLabel}"; variant: "${preset}"; transform: "${textTransform}"; size: ${fontSize}px; weight: ${fontWeight}; tracking: ${tracking}px; shadow: "${shadow}";`;
        };

        if (fontSelect) fontSelect.onchange = updateNameTuner;
        presetSelect.onchange = updateNameTuner;
        if (shadowSelect) shadowSelect.onchange = updateNameTuner;
        upperCheck.onchange = () => {
          if (upperCheck.checked) capCheck.checked = false;
          updateNameTuner();
        };
        capCheck.onchange = () => {
          if (capCheck.checked) upperCheck.checked = false;
          updateNameTuner();
        };
        sizeInput.oninput = updateNameTuner;
        weightSelect.onchange = updateNameTuner;
        trackingInput.oninput = updateNameTuner;
        if (customInput) customInput.oninput = updateNameTuner;

        // Enable scrollwheel cycling on all dropdowns without scrolling the page
        const tunerBar = document.getElementById('ui-tuner-bar');
        if (tunerBar) {
          tunerBar.querySelectorAll('select').forEach((sel) => {
            sel.addEventListener(
              'wheel',
              function (e) {
                e.preventDefault();
                const delta = Math.sign(e.deltaY);
                if (delta > 0 && sel.selectedIndex < sel.options.length - 1) {
                  sel.selectedIndex++;
                  sel.dispatchEvent(new Event('change'));
                } else if (delta < 0 && sel.selectedIndex > 0) {
                  sel.selectedIndex--;
                  sel.dispatchEvent(new Event('change'));
                }
              },
              { passive: false }
            );
          });
        }

        copyBtn.onclick = () => {
          output.select();
          navigator.clipboard.writeText(output.value);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyBtn.textContent = 'Copy';
          }, 1500);
        };

        updateNameTuner();
      }

      // Hover Telemetry
      if (grid && status) {
        grid.addEventListener('mouseover', function (e) {
          const target = e.target.closest('[data-label]');
          if (target) {
            const label = target.getAttribute('data-label');
            if (label) status.textContent = label;
          }
        });

        grid.addEventListener('mouseleave', function () {
          status.textContent = '';
        });

        grid.addEventListener('focusin', function (e) {
          const target = e.target.closest('[data-label]');
          if (target) {
            const label = target.getAttribute('data-label');
            if (label) status.textContent = label;
          }
        });

        grid.addEventListener('focusout', function () {
          status.textContent = '';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTunerAndTelemetry);
    } else {
      setupTunerAndTelemetry();
    }
    document.addEventListener('astro:page-load', setupTunerAndTelemetry);
  })();
</script>

---
import fallbackData from '../data/github-contributions-all.json';

interface ContributionDay {
  date: string;
  count: number;
  level: number;
  placeholder?: boolean;
}

let allContributions: ContributionDay[] = fallbackData.contributions;

try {
  const res = await fetch('https://github-contributions-api.jogruber.de/v4/navoyovan', {
    signal: AbortSignal.timeout(2500),
    headers: { 'User-Agent': 'navoyovan-portfolio-build' },
  });
  if (res.ok) {
    const json = await res.json();
    if (json?.contributions && json.contributions.length > 0) {
      allContributions = json.contributions;
    }
  }
} catch {
  // Gracefully use local cached fallback
}

const todayStr = new Date().toISOString().split('T')[0];

// Sort chronologically ascending
const sorted = allContributions.slice().sort((a, b) => a.date.localeCompare(b.date));

// Filter up to today
const filtered = sorted.filter((c) => c.date <= todayStr);

// Take ~2 years (730 days) and align to previous Sunday
const approx = filtered.slice(-730);
const firstDate = new Date(approx[0].date);
const dayOfWeek = firstDate.getDay();
const startIndex = filtered.length - 730 - dayOfWeek;
const days: ContributionDay[] = filtered.slice(startIndex);

// Pad end of last week to Saturday so every column has exactly 7 rows
const remainder = days.length % 7;
const padCount = remainder === 0 ? 0 : 7 - remainder;
for (let i = 0; i < padCount; i++) {
  days.push({ date: '', count: 0, level: 0, placeholder: true });
}

const availableWeeks = Math.ceil(days.length / 7);

// Build all 2 full years of 7-day columns (~105 weeks)
const weeks: ContributionDay[][] = [];
for (let w = 0; w < availableWeeks; w++) {
  const sliceStart = w * 7;
  weeks.push(days.slice(sliceStart, sliceStart + 7));
}

// Compute threshold for top ~3% active days to receive fully lit lime accent
const activeCounts = days
  .filter((d) => !d.placeholder && d.count > 0)
  .map((d) => d.count)
  .sort((a, b) => b - a);
const topThreePctThreshold =
  activeCounts.length > 0
    ? activeCounts[Math.max(0, Math.floor(activeCounts.length * 0.03))] || 6
    : 6;

---

<section
  id="github-contrib-section"
  aria-label="GitHub Contributions Telemetry"
  class="w-full bg-[#fcfbf9] dark:bg-[#0e0e0e] transition-colors duration-200 p-0 m-0 overflow-hidden select-none"
  style="
    --cell: 28px;
    --gap: 3px;
    --pad: 8px;
    --cell-inner: calc((7 * var(--cell) - 6 * var(--gap)) / 7);
    height: calc(7 * var(--cell) + 2 * var(--pad));
    margin-top: calc(3 * var(--cell));
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 25%, black 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 25%, black 100%);
  "
>
  <!-- Heatmap: Borderless grid with seamless edge mask and right-anchored latest view -->
  <div class="relative w-full h-full overflow-hidden">
    <div
      id="github-contrib-scroll"
      class="w-full h-full overflow-x-auto scrollbar-none flex justify-end items-center"
      style="padding: var(--pad);"
    >
      <div
        id="github-contrib-grid"
        role="img"
        aria-label="GitHub contribution activity over the last two years"
        class="flex flex-row h-full select-none gap-[var(--gap)] shrink-0 w-max opacity-45 hover:opacity-90 transition-opacity duration-300"
      >
        {
          weeks.map((weekDays) => (
            <div class="gcd-col">
              {weekDays.map((day) => {
                if (day.placeholder) {
                  return (
                    <span
                      class="gcd-cell opacity-0 pointer-events-none"
                      aria-hidden="true"
                    />
                  );
                }

                return (
                  <span
                    class="gcd-cell"
                    data-c={day.count}
                    data-d={day.date}
                    data-l={day.level || undefined}
                  />
                );
              })}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Editorial Name Overlay: Yovan; Gunardio. (Hidden for now per request) -->
    <div
      class="hidden absolute inset-y-0 left-0 items-center pl-4 sm:pl-8 lg:pl-12 pointer-events-none select-none z-20"
      aria-hidden="true"
    >
      <div
        class="font-machina font-light tracking-tight text-neutral-950 dark:text-white drop-shadow-[0_2px_10px_rgba(255,255,255,0.85)] dark:drop-shadow-[0_2px_14px_rgba(0,0,0,0.95)]"
        style="
          font-size: calc(2.5 * var(--cell));
          line-height: calc(3 * var(--cell));
        "
      >
        <div>Yovan<span class="text-[var(--color-accent,#1b7f3b)] dark:text-[var(--color-accent,#52FF1A)]">;</span></div>
        <div class="text-neutral-500 dark:text-neutral-400">Gunardio.</div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #github-contrib-grid .gcd-col {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: var(--gap);
    flex-shrink: 0;
    width: var(--cell-inner);
    position: relative;
  }

  #github-contrib-grid .gcd-col:hover {
    z-index: 20;
  }

  #github-contrib-grid .gcd-cell {
    width: var(--cell-inner);
    height: var(--cell-inner);
    border-radius: 1px;
    flex-shrink: 0;
    cursor: default;
    transition: transform 100ms;
    position: relative;
  }

  @media (min-width: 640px) {
    #github-contrib-grid .gcd-cell {
      border-radius: 2px;
    }
  }

  #github-contrib-grid .gcd-cell:not([data-l]) {
    background-color: rgba(229, 231, 235, 0.5);
  }

  .dark #github-contrib-grid .gcd-cell:not([data-l]) {
    background-color: #1c1c1c;
  }

  @media (prefers-color-scheme: dark) {
    :root:not(.light) #github-contrib-grid .gcd-cell:not([data-l]) {
      background-color: #1c1c1c;
    }
  }

  #github-contrib-grid .gcd-cell[data-l="1"] {
    background-color: rgba(16, 185, 129, 0.20);
  }

  #github-contrib-grid .gcd-cell[data-l="2"] {
    background-color: rgba(16, 185, 129, 0.45);
  }

  #github-contrib-grid .gcd-cell[data-l="3"] {
    background-color: rgba(16, 185, 129, 0.70);
  }

  #github-contrib-grid .gcd-cell[data-l="4"] {
    background-color: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.35);
  }

  #github-contrib-grid .gcd-cell:hover {
    transform: scale(1.15);
    z-index: 30;
  }

  @media (prefers-reduced-motion: reduce) {
    #github-contrib-grid .gcd-cell {
      transition: none;
    }
    #github-contrib-grid .gcd-cell:hover {
      transform: none;
    }
  }
</style>

<!-- Floating Cursor-Following Tooltip (outside masked section to prevent clipping) -->
<div
  id="github-contrib-tooltip"
  dir="ltr"
  class="pointer-events-none fixed z-[9999] px-2.5 py-1 rounded bg-neutral-950/90 text-white dark:bg-white/95 dark:text-neutral-950 font-mono text-[11px] font-light shadow-md border border-neutral-800/80 dark:border-neutral-200/80 backdrop-blur-xs transition-opacity duration-150 opacity-0 whitespace-nowrap -translate-x-1/2 -translate-y-[calc(100%+10px)]"
  aria-hidden="true"
></div>

<script is:inline>
  (function () {
    function setupTelemetry() {
      const scrollEl = document.getElementById('github-contrib-scroll');
      if (scrollEl) {
        scrollEl.scrollLeft = scrollEl.scrollWidth;
      }

      const grid = document.getElementById('github-contrib-grid');
      const tooltip = document.getElementById('github-contrib-tooltip');
      if (!grid || !tooltip) return;

      if (tooltip.parentElement !== document.body) {
        document.body.appendChild(tooltip);
      }

      const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      function formatTelemetryDate(dateStr) {
        if (!dateStr) return '';
        const parts = dateStr.split('-');
        if (parts.length < 3) return dateStr;
        const month = MONTHS[parseInt(parts[1], 10) - 1] || parts[1];
        const day = parseInt(parts[2], 10);
        const year = parts[0];
        return `${month} ${day}, ${year}`;
      }

      function showTooltip(e) {
        const target = e.target.closest('.gcd-cell[data-d]');
        if (target) {
          const count = parseInt(target.getAttribute('data-c') || '0', 10);
          const dateStr = target.getAttribute('data-d');
          const formattedDate = formatTelemetryDate(dateStr);
          const countText = `${count} contribution${count === 1 ? '' : 's'}`;
          const label = `${countText} on ${formattedDate}`;

          if (tooltip) {
            tooltip.textContent = label;
            tooltip.style.opacity = '1';

            const rect = tooltip.getBoundingClientRect();
            const width = rect.width || 160;
            const height = rect.height || 28;
            const halfW = width / 2;
            const pad = 12;

            const clampedX = Math.max(halfW + pad, Math.min(window.innerWidth - halfW - pad, e.clientX));
            tooltip.style.left = `${clampedX}px`;

            if (e.clientY < height + 20) {
              tooltip.classList.remove('-translate-y-[calc(100%+10px)]');
              tooltip.classList.add('translate-y-[15px]');
            } else {
              tooltip.classList.remove('translate-y-[15px]');
              tooltip.classList.add('-translate-y-[calc(100%+10px)]');
            }

            const clampedY = Math.min(window.innerHeight - 20, e.clientY);
            tooltip.style.top = `${clampedY}px`;
          }
        } else {
          hideTooltip();
        }
      }

      function hideTooltip() {
        if (tooltip) tooltip.style.opacity = '0';
      }

      grid.addEventListener('mouseover', showTooltip);
      grid.addEventListener('mousemove', showTooltip);
      grid.addEventListener('mouseleave', hideTooltip);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTelemetry);
    } else {
      setupTelemetry();
    }
    document.addEventListener('astro:page-load', setupTelemetry);
  })();
</script>

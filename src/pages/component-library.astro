  </div>
  <ActionButtonOledModal />
  <HoverExpandOledModal />
</RootLayout>

<script>
  const setupComponentLibraryNav = () => {
    const navButtons = document.querySelectorAll<HTMLButtonElement>(
      ".sidebar-nav-btn, .tab-nav-btn",
    );
    if (navButtons.length === 0) return;

    navButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", `#${targetId}`);
        }
      });
    });

    const sectionIds = [
      "colors",
      "typography",
      "depth-cards",
      "buttons",
      "kinetic-triggers",
      "forms",
      "text-inputs",
      "dropdowns",
      "loaders",
      "status-badges",
      "metric-cards",
      "project-tiles",
      "tree-index",
      "app-window",
      "system-topology",
      "trend-chart",
      "kiosk-timeline",
      "frame-rank-chart",
    ];

    const updateActiveTab = (activeId: string) => {
      navButtons.forEach((btn) => {
        const targetId = btn.getAttribute("data-target");
        const isActive = targetId === activeId;
        if (btn.classList.contains("sidebar-nav-btn")) {
          if (isActive) {
            btn.classList.add(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.remove("text-neutral-600", "dark:text-neutral-400");
          } else {
            btn.classList.remove(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.add("text-neutral-600", "dark:text-neutral-400");
          }
        } else {
          // mobile tab
          if (isActive) {
            btn.classList.add(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.remove(
              "bg-neutral-100",
              "dark:bg-neutral-900",
              "text-neutral-600",
              "dark:text-neutral-400",
            );
            // Auto-scroll the mobile tab bar so active tab scrolls smoothly into view
            btn.scrollIntoView({
              behavior: "smooth",
              inline: "center",
              block: "nearest",
            });
          } else {
            btn.classList.remove(
              "bg-neutral-900",
              "dark:bg-white",
              "text-white",
              "dark:text-neutral-950",
              "font-bold",
            );
            btn.classList.add(
              "bg-neutral-100",
              "dark:bg-neutral-900",
              "text-neutral-600",
              "dark:text-neutral-400",
            );
          }
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            updateActiveTab(entry.target.id);
          }
        });
      },
      {
        rootMargin: "-10% 0px -70% 0px",
        threshold: 0,
      },
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  };

  const setupAccentColorPicker = () => {
    const trigger = document.getElementById("accent-picker-trigger");
    const menu = document.getElementById("accent-picker-menu");
    const chip = document.getElementById("accent-swatch-chip");
    const hexEl = document.getElementById("accent-swatch-hex");
    const nameEl = document.getElementById("accent-swatch-name");
    const arrow = document.getElementById("accent-picker-arrow");
    const optionBtns =
      document.querySelectorAll<HTMLButtonElement>(".accent-option-btn");

    if (!trigger || !menu) return;

    let isOpen = false;

    const setDropdownState = (open: boolean) => {
      isOpen = open;
      trigger.setAttribute("aria-expanded", open.toString());
      menu.setAttribute("aria-hidden", (!open).toString());

      if (open) {
        menu.classList.remove(
          "opacity-0",
          "-translate-y-2",
          "scale-95",
          "pointer-events-none",
        );
        menu.classList.add(
          "opacity-100",
          "translate-y-0",
          "scale-100",
          "pointer-events-auto",
        );
        arrow?.classList.add("rotate-180");
        optionBtns.forEach((btn) => btn.removeAttribute("tabindex"));
      } else {
        menu.classList.remove(
          "opacity-100",
          "translate-y-0",
          "scale-100",
          "pointer-events-auto",
        );
        menu.classList.add(
          "opacity-0",
          "-translate-y-2",
          "scale-95",
          "pointer-events-none",
        );
        arrow?.classList.remove("rotate-180");
        optionBtns.forEach((btn) => btn.setAttribute("tabindex", "-1"));
      }
    };

    setDropdownState(false);

    trigger.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();
      setDropdownState(!isOpen);
    };

    const applyAccent = (hex: string, name: string, save = true) => {
      if (typeof (window as any).__setPortfolioAccent === "function") {
        (window as any).__setPortfolioAccent(hex, name);
      } else {
        document.documentElement.style.setProperty("--color-accent", hex);
        document.documentElement.style.setProperty("--color-accent-hover", hex);
        document.documentElement.style.setProperty("--accent-color", hex);
        document.documentElement.style.setProperty("--accent-hover", hex);
        document.documentElement.style.setProperty("--terminal-green", hex);
      }
      if (chip) {
        chip.style.backgroundColor = hex;
        chip.style.boxShadow = `0 0 20px ${hex}4D`;
      }
      if (hexEl) {
        hexEl.textContent = `--color-accent • ${hex}`;
      }
      if (nameEl) {
        nameEl.textContent = `Accent ${name.replace("Accent ", "")}`;
      }
    };

    // Restore saved accent UI state if exists
    try {
      const savedHex = localStorage.getItem("portfolio_accent_hex");
      const savedName = localStorage.getItem("portfolio_accent_name");
      if (savedHex && savedName) {
        applyAccent(savedHex, savedName, false);
      }
    } catch {}

    optionBtns.forEach((btn) => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const hex = btn.getAttribute("data-accent-pick");
        const name = btn.getAttribute("data-accent-name");
        if (hex && name) {
          applyAccent(hex, name);
        }
        setDropdownState(false);
      };
    });

    const onDocClick = (e: MouseEvent) => {
      if (
        isOpen &&
        !menu.contains(e.target as Node) &&
        !trigger.contains(e.target as Node)
      ) {
        setDropdownState(false);
      }
    };
    document.removeEventListener("click", onDocClick);
    document.addEventListener("click", onDocClick);

    const onKeyDown = (e: KeyboardEvent) => {
      if (!isOpen) return;
      if (e.key === "Escape") {
        e.preventDefault();
        setDropdownState(false);
        trigger.focus();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        const focusables = Array.from(optionBtns);
        const currentIndex = focusables.indexOf(
          document.activeElement as HTMLButtonElement,
        );
        const nextIndex = (currentIndex + 1) % focusables.length;
        focusables[nextIndex]?.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        const focusables = Array.from(optionBtns);
        const currentIndex = focusables.indexOf(
          document.activeElement as HTMLButtonElement,
        );
        const nextIndex =
          (currentIndex - 1 + focusables.length) % focusables.length;
        focusables[nextIndex]?.focus();
      }
    };
    document.removeEventListener("keydown", onKeyDown);
    document.addEventListener("keydown", onKeyDown);
  };

  const initIndexMarquees = () => {
    const wrappers = document.querySelectorAll<HTMLElement>(
      ".index-marquee-wrapper",
    );
    wrappers.forEach((wrapper) => {
      const track = wrapper.querySelector<HTMLElement>(".index-marquee-track");
      const content = wrapper.querySelector<HTMLElement>(
        ".index-marquee-content",
      );
      if (!track || !content) return;

      const wrapperWidth = wrapper.clientWidth;
      if (wrapperWidth === 0) return;

      const existingClone = track.querySelector(".index-marquee-clone");
      if (existingClone) {
        existingClone.remove();
      }
      wrapper.classList.remove("is-overflowing");
      track.style.animation = "none";

      const naturalWidth = content.scrollWidth;

      if (naturalWidth > wrapperWidth + 2) {
        wrapper.classList.add("is-overflowing");

        const clone = content.cloneNode(true) as HTMLElement;
        clone.classList.add("index-marquee-clone");
        clone.setAttribute("aria-hidden", "true");
        track.appendChild(clone);

        const unitWidth = content.scrollWidth;
        const duration = Math.max(12, unitWidth / 26);

        track.style.animationName = "marquee-scroll";
        track.style.animationDuration = `${duration}s`;
        track.style.animationTimingFunction = "linear";
        track.style.animationIterationCount = "infinite";

        const trigger = wrapper.closest(".group") || wrapper;
        if (!(trigger as any)._marqueeTracks) {
          (trigger as any)._marqueeTracks = [];
          const slowDown = () => {
            ((trigger as any)._marqueeTracks || []).forEach((t: HTMLElement) => easeIndexMarqueeRate(t, 0.22, 600));
          };
          const speedUp = () => {
            ((trigger as any)._marqueeTracks || []).forEach((t: HTMLElement) => easeIndexMarqueeRate(t, 1.0, 600));
          };
          trigger.addEventListener("mouseenter", slowDown);
          trigger.addEventListener("mouseleave", speedUp);
          trigger.addEventListener("focusin", slowDown);
          trigger.addEventListener("focusout", speedUp);
        }
        if (!(trigger as any)._marqueeTracks.includes(track)) {
          (trigger as any)._marqueeTracks.push(track);
        }

        if (!(wrapper as any)._hasWrapperHover) {
          (wrapper as any)._hasWrapperHover = true;
          wrapper.addEventListener("mouseenter", () => easeIndexMarqueeRate(track, 0.22, 600));
          wrapper.addEventListener("mouseleave", () => easeIndexMarqueeRate(track, 1.0, 600));
        }
      }
    });
  };

  const easeIndexMarqueeRate = (track: HTMLElement, targetRate: number, durationMs = 600) => {
    const anims = track.getAnimations();
    if (!anims.length) return;
    const anim = anims[0];
    const startRate = anim.playbackRate;
    const startTime = performance.now();
    const trackAny = track as any;
    if (trackAny._rateRaf) cancelAnimationFrame(trackAny._rateRaf);

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / durationMs, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      anim.playbackRate = startRate + (targetRate - startRate) * eased;
      if (progress < 1) {
        trackAny._rateRaf = requestAnimationFrame(step);
      } else {
        trackAny._rateRaf = null;
      }
    }
    trackAny._rateRaf = requestAnimationFrame(step);
  };

  let autoScrollInterval: number | null = null;

  const setupAutoTabScroll = () => {
    const defaultInput = document.getElementById(
      "ti-default",
    ) as HTMLInputElement | null;
    if (!defaultInput) return;

    const autoScrollTargets = [
      "colors",
      "typography",
      "depth-cards",
      "buttons",
      "kinetic-triggers",
      "forms",
      "text-inputs",
      "dropdowns",
      "loaders",
    ];

    const triggerTab = (targetId: string) => {
      const sidebarBtn = document.querySelector<HTMLButtonElement>(
        `.sidebar-nav-btn[data-target="${targetId}"]`,
      );
      const mobileBtn = document.querySelector<HTMLButtonElement>(
        `.tab-nav-btn[data-target="${targetId}"]`,
      );

      if (sidebarBtn) {
        sidebarBtn.click();
      } else if (mobileBtn) {
        mobileBtn.click();
      } else {
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          targetEl.scrollIntoView({ behavior: "smooth" });
          history.replaceState(null, "", `#${targetId}`);
        }
      }
    };

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        const val = defaultInput.value.trim().toLowerCase();
        if (val === "autoscroll") {
          e.preventDefault();
          defaultInput.blur();

          // Clear any active auto-scroll loop
          if (autoScrollInterval) {
            clearInterval(autoScrollInterval);
            autoScrollInterval = null;
          }

          let currentIndex = 0;
          // Trigger first tab immediately
          triggerTab(autoScrollTargets[currentIndex]);

          // Loop infinitely every 2 seconds
          autoScrollInterval = window.setInterval(() => {
            currentIndex = (currentIndex + 1) % autoScrollTargets.length;
            triggerTab(autoScrollTargets[currentIndex]);
          }, 2000);
        } else if (
          val.startsWith("actionbutton") ||
          val.startsWith("action button") ||
          val.startsWith("action-button")
        ) {
          e.preventDefault();
          defaultInput.blur();
          const custom = defaultInput.value.trim().replace(/^(actionbutton|action button|action-button)/i, "").trim();
          window.dispatchEvent(new CustomEvent("open-actionbutton-oled", { detail: { text: custom || undefined } }));
        } else if (
          val === "hoverexpandbutton" ||
          val === "hoverexpand" ||
          val === "hover-expand" ||
          val === "hover expand button" ||
          val === "hover expand"
        ) {
          e.preventDefault();
          defaultInput.blur();
          window.dispatchEvent(new CustomEvent("open-hoverexpand-oled"));
        }
      }
    };

    const onInput = () => {
      const rawVal = defaultInput.value.trim();
      const val = rawVal.toLowerCase();
      if (
        val === "actionbutton" ||
        val === "action button" ||
        val === "action-button"
      ) {
        defaultInput.blur();
        window.dispatchEvent(new CustomEvent("open-actionbutton-oled"));
      } else if (
        val === "hoverexpandbutton" ||
        val === "hoverexpand" ||
        val === "hover-expand" ||
        val === "hover expand button" ||
        val === "hover expand"
      ) {
        defaultInput.blur();
        window.dispatchEvent(new CustomEvent("open-hoverexpand-oled"));
      }
    };

    defaultInput.removeEventListener("keydown", onKeyDown);
    defaultInput.addEventListener("keydown", onKeyDown);
    defaultInput.removeEventListener("input", onInput);
    defaultInput.addEventListener("input", onInput);
  };

  setupComponentLibraryNav();
  setupAccentColorPicker();
  initIndexMarquees();
  setupAutoTabScroll();

  let lastMarqueeWidth = typeof window !== "undefined" ? window.innerWidth : 0;
  let marqueeResizeTimer: number | null = null;
  window.addEventListener(
    "resize",
    () => {
      if (window.innerWidth === lastMarqueeWidth) return;
      lastMarqueeWidth = window.innerWidth;
      if (marqueeResizeTimer) clearTimeout(marqueeResizeTimer);
      marqueeResizeTimer = window.setTimeout(initIndexMarquees, 150);
    },
    { passive: true },
  );

  document.addEventListener("astro:page-load", () => {
    setupComponentLibraryNav();
    setupAccentColorPicker();
    initIndexMarquees();
    setupAutoTabScroll();
  });
</script>

<style is:global>
  @keyframes marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .index-marquee-wrapper:not(.is-overflowing) .stack-dot-trailing,
  .index-marquee-wrapper:not(.is-overflowing) .title-dot-trailing {
    display: none !important;
  }

  .index-marquee-wrapper.is-overflowing {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 36px,
      black calc(100% - 36px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 36px,
      black calc(100% - 36px),
      transparent 100%
    );
  }

  .index-marquee-track {
    display: inline-flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .index-marquee-track {
      animation: none !important;
      transform: none !important;
    }
    .index-marquee-wrapper {
      overflow-x: auto !important;
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }
  }
</style>

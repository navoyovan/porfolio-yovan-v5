---
import RootLayout from "../layouts/RootLayout.astro";
import ActionButton from "../components/ActionButton.astro";
import DepthCard from "../components/DepthCard.astro";
import Checkbox from "../components/Checkbox.astro";
import RadioButton from "../components/RadioButton.astro";
import ToggleSwitch from "../components/ToggleSwitch.astro";
import FormSlider from "../components/FormSlider.astro";
import TextInput from "../components/TextInput.astro";
import LimitTextarea from "../components/LimitTextarea.astro";
import PasswordInput from "../components/PasswordInput.astro";
import FormSelect from "../components/FormSelect.astro";
import SearchDropdown from "../components/SearchDropdown.astro";
import DatePicker from "../components/DatePicker.astro";
import SquareWaveLoader from "../components/SquareWaveLoader.astro";
import StatusBadge from "../components/StatusBadge.astro";
import MetricCard from "../components/MetricCard.astro";
import ProjectTile from "../components/ProjectTile.astro";
import AppWindow from "../components/AppWindow.astro";
import SystemTopology from "../components/SystemTopology.astro";
import TrendChart from "../components/TrendChart.astro";
import KioskTimeline from "../components/KioskTimeline.astro";
import HoverExpandButton from "../components/HoverExpandButton.astro";
import FrameRankChart from "../components/FrameRankChart.astro";
import ActionButtonOledModal from "../components/ActionButtonOledModal.astro";
import HoverExpandOledModal from "../components/HoverExpandOledModal.astro";

const foundationsNav = [
  { id: "colors", label: "Color Tokens" },
  { id: "typography", label: "Typography Hierarchy" },
  { id: "depth-cards", label: "Spatial Depth Cards" },
];

const interactionNav = [
  { id: "buttons", label: "Buttons & Micro" },
  { id: "kinetic-triggers", label: "Kinetic Triggers" },
  { id: "forms", label: "Form Controls & Sliders" },
  { id: "text-inputs", label: "Text Inputs & Area" },
  { id: "dropdowns", label: "Dropdowns & Pickers" },
  { id: "loaders", label: "Loaders (Square Wave)" },
];

const feedbackNav = [
  { id: "status-badges", label: "Status Badges" },
  { id: "metric-cards", label: "Metric Cards" },
];

const systemsNav = [
  { id: "project-tiles", label: "Project Tiles" },
  { id: "tree-index", label: "Directory Tree Index" },
  { id: "app-window", label: "App Window Mockup" },
  { id: "system-topology", label: "System Topology" },
  { id: "trend-chart", label: "Telemetry Trend Spline" },
  { id: "kiosk-timeline", label: "Activity Schedule Timeline" },
  { id: "frame-rank-chart", label: "Filmstrip Asset Ranking" },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<RootLayout
  title="Component Library | UI Primitives & Design Tokens"
  description="Design system, typography specimens, color tokens, and UI primitives architected for this Portfolio."
  noindex={true}
>
  <div class="w-full flex min-h-[calc(100vh-4rem)]">
    <!-- Outer Sidebar Nav (Sticky, Outside Main Content) -->
    <aside
      class="hidden xl:block w-64 shrink-0 border-r border-neutral-200/80 dark:border-neutral-800/80 py-8 px-0 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto no-scrollbar"
    >
      <nav class="space-y-6">
        <!-- 01 // FOUNDATIONS -->
        <div class="space-y-2">
          <div
            class="px-5 pb-1.5 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <span
              class="font-mono text-[11px] font-bold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider"
            >
              01 // FOUNDATIONS
            </span>
          </div>
          <ul class="space-y-0.5 list-none p-0 m-0">
            {
              foundationsNav.map((item) => (
                <li>
                  <button
                    type="button"
                    data-target={item.id}
                    class="sidebar-nav-btn group w-full flex items-center justify-between px-5 py-2 text-xs font-mono text-left rounded-none text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
                  >
                    <span class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-1.5">
                      {item.label}
                    </span>
                    <span class="text-[10px] text-neutral-400 dark:text-neutral-600 opacity-0 group-hover:opacity-100 transition-opacity">
                      →
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- 02 // INTERACTION PRIMITIVES -->
        <div class="space-y-2">
          <div
            class="px-5 pb-1.5 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <span
              class="font-mono text-[11px] font-bold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider"
            >
              02 // INTERACTION PRIMITIVES
            </span>
          </div>
          <ul class="space-y-0.5 list-none p-0 m-0">
            {
              interactionNav.map((item) => (
                <li>
                  <button
                    type="button"
                    data-target={item.id}
                    class="sidebar-nav-btn group w-full flex items-center justify-between px-5 py-2 text-xs font-mono text-left rounded-none text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
                  >
                    <span class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-1.5">
                      {item.label}
                    </span>
                    <span class="text-[10px] text-neutral-400 dark:text-neutral-600 opacity-0 group-hover:opacity-100 transition-opacity">
                      →
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- 03 // FEEDBACK & STATUS -->
        <div class="space-y-2">
          <div
            class="px-5 pb-1.5 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <span
              class="font-mono text-[11px] font-bold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider"
            >
              03 // FEEDBACK &amp; STATUS
            </span>
          </div>
          <ul class="space-y-0.5 list-none p-0 m-0">
            {
              feedbackNav.map((item) => (
                <li>
                  <button
                    type="button"
                    data-target={item.id}
                    class="sidebar-nav-btn group w-full flex items-center justify-between px-5 py-2 text-xs font-mono text-left rounded-none text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
                  >
                    <span class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-1.5">
                      {item.label}
                    </span>
                    <span class="text-[10px] text-neutral-400 dark:text-neutral-600 opacity-0 group-hover:opacity-100 transition-opacity">
                      →
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- 04 // SYSTEM & DATA VIZ -->
        <div class="space-y-2">
          <div
            class="px-5 pb-1.5 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <span
              class="font-mono text-[11px] font-bold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider"
            >
              04 // SYSTEM &amp; DATA VIZ
            </span>
          </div>
          <ul class="space-y-0.5 list-none p-0 m-0">
            {
              systemsNav.map((item) => (
                <li>
                  <button
                    type="button"
                    data-target={item.id}
                    class="sidebar-nav-btn group w-full flex items-center justify-between px-5 py-2 text-xs font-mono text-left rounded-none text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
                  >
                    <span class="inline-block transition-transform duration-150 ease-out group-hover:translate-x-1.5">
                      {item.label}
                    </span>
                    <span class="text-[10px] text-neutral-400 dark:text-neutral-600 opacity-0 group-hover:opacity-100 transition-opacity">
                      →
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- 05 // LICENSE -->
        <div
          class="pt-4 px-5 border-t border-neutral-200/80 dark:border-neutral-800/80"
        >
          <span
            class="text-[11px] font-mono text-neutral-400 dark:text-neutral-500"
          >
            CC BY 4.0 / Creative Commons Attribution
          </span>
        </div>
      </nav>
    </aside>

    <!-- Main Content Container -->
    <main
      class="flex-1 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 min-w-0"
    >
      <!-- Header -->
      <div
        id="library-header"
        class="border-b border-neutral-200 dark:border-neutral-800 pb-6 mb-4 xl:mb-12"
      >
        <h1
          class="text-3xl sm:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white font-heading"
        >
          Component Library
        </h1>
        <p
          class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl font-normal font-sans"
        >
          A showcase of typography, color tokens, and interactive UI primitives.
        </p>
      </div>

      <!-- Mobile Sticky Tab Switcher -->
      <div
        id="mobile-tab-switcher"
        class="xl:hidden sticky top-16 z-30 bg-[#fcfbf9]/95 dark:bg-[#0e0e0e]/95 backdrop-blur-md border-b border-neutral-200 dark:border-neutral-800 py-2.5 -mx-4 sm:-mx-6 px-4 sm:px-6 mb-8 overflow-x-auto flex items-center gap-1.5 no-scrollbar"
      >
        <span
          class="text-[10px] font-mono uppercase font-bold text-neutral-400 dark:text-neutral-500 shrink-0 select-none mr-0.5"
          >Foundations:</span
        >
        {
          foundationsNav.map((item) => (
            <button
              type="button"
              data-target={item.id}
              class="tab-nav-btn shrink-0 px-2.5 py-1 text-xs font-mono rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
            >
              {item.label}
            </button>
          ))
        }
        <div
          class="w-px h-5 bg-neutral-300 dark:bg-neutral-700 my-auto shrink-0 mx-1"
        >
        </div>
        <span
          class="text-[10px] font-mono uppercase font-bold text-neutral-400 dark:text-neutral-500 shrink-0 select-none mr-0.5"
          >Interaction:</span
        >
        {
          interactionNav.map((item) => (
            <button
              type="button"
              data-target={item.id}
              class="tab-nav-btn shrink-0 px-2.5 py-1 text-xs font-mono rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
            >
              {item.label}
            </button>
          ))
        }
        <div
          class="w-px h-5 bg-neutral-300 dark:bg-neutral-700 my-auto shrink-0 mx-1"
        >
        </div>
        <span
          class="text-[10px] font-mono uppercase font-bold text-neutral-400 dark:text-neutral-500 shrink-0 select-none mr-0.5"
          >Feedback:</span
        >
        {
          feedbackNav.map((item) => (
            <button
              type="button"
              data-target={item.id}
              class="tab-nav-btn shrink-0 px-2.5 py-1 text-xs font-mono rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
            >
              {item.label}
            </button>
          ))
        }
        <div
          class="w-px h-5 bg-neutral-300 dark:bg-neutral-700 my-auto shrink-0 mx-1"
        >
        </div>
        <span
          class="text-[10px] font-mono uppercase font-bold text-neutral-400 dark:text-neutral-500 shrink-0 select-none mr-0.5"
          >Systems:</span
        >
        {
          systemsNav.map((item) => (
            <button
              type="button"
              data-target={item.id}
              class="tab-nav-btn shrink-0 px-2.5 py-1 text-xs font-mono rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors cursor-pointer border border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
            >
              {item.label}
            </button>
          ))
        }
      </div>

      <!-- 01 // FOUNDATIONS Container -->
      <div id="foundations" class="space-y-16 scroll-mt-40 xl:scroll-mt-24">
        <!-- 01 / Color Tokens -->
        <section id="colors" class="space-y-6 scroll-mt-40 xl:scroll-mt-24">
          <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
            <h2
              class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
            >
              01 / Color Tokens
            </h2>
          </div>
          <!-- 01.0 / Core Brand & Surface Tokens -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            <!-- Neon Green Accent (Secret Interactive Swatch) -->
            <div
              class="relative flex flex-col gap-2"
              id="accent-swatch-container"
            >
              <div
                id="accent-swatch-chip"
                class="w-full aspect-video bg-[#52FF1A] border border-black/10 shadow-[0_0_20px_rgba(82,255,26,0.3)] transition-colors duration-200"
              >
              </div>
              <div class="flex flex-col relative">
                <button
                  type="button"
                  id="accent-picker-trigger"
                  aria-label="Select accent color palette"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="accent-picker-menu"
                  class="group/accent-btn text-left p-0 bg-transparent border-0 cursor-pointer select-none inline-flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A] rounded"
                >
                  <span
                    id="accent-swatch-name"
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100 group-hover/accent-btn:text-neutral-950 dark:group-hover/accent-btn:text-white transition-colors"
                    >Accent Neon</span
                  >
                  <span
                    id="accent-picker-arrow"
                    class="inline-flex items-center justify-center w-3 text-neutral-400 dark:text-neutral-500 group-hover/accent-btn:text-neutral-950 dark:group-hover/accent-btn:text-white transition-[opacity,transform] duration-200 text-[11px] leading-none"
                    aria-hidden="true"
                  >
                    ↓
                  </span>
                </button>
                <span
                  id="accent-swatch-hex"
                  class="font-mono text-[11px] text-neutral-500"
                  >--color-accent • #52FF1A</span
                >

                <!-- Secret Dropdown Menu -->
                <div
                  id="accent-picker-menu"
                  role="menu"
                  aria-label="Select Accent Color"
                  class="absolute top-full left-0 mt-2 min-w-[220px] bg-[#fcfbf9]/95 dark:bg-[#0e0e0e]/95 backdrop-blur-xl border border-neutral-200/90 dark:border-neutral-800/90 rounded-lg shadow-xl dark:shadow-2xl p-1.5 z-50 opacity-0 -translate-y-2 scale-95 pointer-events-none transition-[opacity,transform] duration-200 ease-out origin-top flex flex-col gap-1"
                >
                  <div
                    class="px-3 pt-2 pb-1 text-[10px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 font-semibold border-b border-neutral-200/60 dark:border-neutral-800/60 select-none flex items-center justify-between"
                  >
                    <span>ACCENT PALETTE</span>
                    <span class="text-[9px] text-neutral-400 font-normal"
                      >7 TOKENS</span
                    >
                  </div>
                  <ul
                    class="flex flex-col gap-0.5 list-none m-0 p-0"
                    role="none"
                  >
                    {
                      [
                        { name: "Neon Green", hex: "#52FF1A" },
                        { name: "Electric Yellow", hex: "#FFE500" },
                        { name: "Hot Coral", hex: "#FF5C3A" },
                        { name: "Sky Cyan", hex: "#00E5FF" },
                        { name: "Lavender Pulse", hex: "#C87DFF" },
                        { name: "Neon Pink", hex: "#FF3CAC" },
                        { name: "Solar Amber", hex: "#FFAA00" },
                      ].map((item) => (
                        <li role="none">
                          <button
                            type="button"
                            role="menuitem"
                            data-accent-pick={item.hex}
                            data-accent-name={item.name}
                            class="accent-option-btn group w-full flex items-center justify-between px-2.5 py-1.5 text-xs font-mono rounded text-neutral-700 dark:text-neutral-300 hover:text-neutral-950 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-900/80 transition-colors cursor-pointer border-0 bg-transparent text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#52FF1A]"
                          >
                            <span class="inline-flex items-center gap-2">
                              <span
                                class="w-2.5 h-2.5 rounded-full shrink-0 border border-black/10 dark:border-white/10"
                                style={`background-color: ${item.hex};`}
                                aria-hidden="true"
                              />
                              <span class="font-medium">{item.name}</span>
                            </span>
                            <span class="text-[10px] text-neutral-400 dark:text-neutral-500 group-hover:text-neutral-600 dark:group-hover:text-neutral-300">
                              {item.hex}
                            </span>
                          </button>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>

            <!-- Primary Background -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full aspect-video bg-[#fcfbf9] dark:bg-[#0e0e0e] border border-neutral-300 dark:border-neutral-700"
              >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Surface Base</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >#fcfbf9 / #0e0e0e</span
                >
              </div>
            </div>

            <!-- Ink Text -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full aspect-video bg-transparent border border-neutral-300 dark:border-neutral-700 flex items-center justify-center overflow-hidden"
              >
                <span
                  class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl tracking-[0.03em] leading-none text-neutral-950 dark:text-white select-none"
                >
                  Vedis!
                </span>
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Text Primary</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >#1a1a1a / #e5e5e5</span
                >
              </div>
            </div>

            <!-- Secondary Surface -->
            <div class="flex flex-col gap-2">
              <div
                class="w-full aspect-video bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300 dark:border-neutral-700"
              >
              </div>
              <div class="flex flex-col">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                  >Surface Card</span
                >
                <span class="font-mono text-[11px] text-neutral-500"
                  >#f6f4ee / #141414</span
                >
              </div>
            </div>
          </div>

          <!-- 01.1 / Semantic State Tokens (Smaller Paintchips) -->
          <div class="pt-2 space-y-3">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-1 sm:gap-0">
              <span
                class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100 uppercase tracking-wider"
                >01.1 / Semantic State Tokens</span
              >
              <span class="font-mono text-[10px] text-neutral-400"
                >Feedback &amp; Status Swatches</span
              >
            </div>

            <div class="grid grid-cols-3 sm:grid-cols-6 gap-4">
              <!-- Safe / Success -->
              <div class="flex flex-col gap-1.5">
                <div
                  class="w-full h-9 sm:h-10 bg-[#10B981] border border-black/10"
                >
                </div>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Safe</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >--color-safe</span
                  >
                </div>
              </div>

              <!-- Warning -->
              <div class="flex flex-col gap-1.5">
                <div
                  class="w-full h-9 sm:h-10 bg-[#F59E0B] border border-black/10"
                >
                </div>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Warning</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >--color-warning</span
                  >
                </div>
              </div>

              <!-- Danger -->
              <div class="flex flex-col gap-1.5">
                <div
                  class="w-full h-9 sm:h-10 bg-[#EF4444] border border-black/10"
                >
                </div>
                <div class="flex flex-col">
                  <span
                    class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                    >Danger</span
                  >
                  <span class="font-mono text-[10px] text-neutral-500"
                    >--color-danger</span
                  >
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 02 / Typography Hierarchy -->
        <section id="typography" class="space-y-8 scroll-mt-40 xl:scroll-mt-24">
          <div class="pb-2 border-b border-neutral-200 dark:border-neutral-800">
            <h2
              class="!font-mono font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 dark:text-neutral-400 font-semibold"
            >
              02 / Typography Hierarchy
            </h2>
          </div>

          <div class="space-y-12">
            <!-- Display & Headings (Syne) -->
            <div class="space-y-6">
              <div class="flex items-center gap-2">
                <span
                  class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100 uppercase tracking-wider"
                  >02.1 / Display & Headings</span
                >
              </div>

              <div
                class="space-y-8 border-l-2 border-neutral-200 dark:border-neutral-800 pl-6"
              >
                <!-- H1 Display Specimen -->
                <div class="flex flex-col gap-2">
                  <p
                    class="font-heading text-4xl sm:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white"
                    aria-hidden="true"
                  >
                    Systemata Visualia Architectata
                  </p>
                  <div class="flex flex-col">
                    <span
                      class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                      >Heading 1 / Display</span
                    >
                    <span class="font-mono text-[11px] text-neutral-500"
                      >Syne 800 • text-4xl sm:text-5xl • tracking-tight</span
                    >
                  </div>
                </div>

                <!-- H2 Section Specimen -->
                <div class="flex flex-col gap-2">
                  <p
                    class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950 dark:text-white"
                    aria-hidden="true"
                  >
                    Architectura Systematum et Interfacies
                  </p>

          <div class="space-y-4">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-1 sm:gap-0">
              <span
                class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100 uppercase tracking-wider"
                >18.1 / Filmstrip Asset Ranking Chart</span
              >
              <span class="font-mono text-[10px] text-neutral-400"
                >Proportional Filmstrip Slots</span
              >
            </div>

            <FrameRankChart />

            <div class="flex flex-col">
              <span
                class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100"
                >Filmstrip Popularity Rank Bar</span
              >
              <span class="font-mono text-[11px] text-neutral-500"
                >frames=&#123;...&#125; • 12-slot proportional filmstrip • rank
                index badges</span
              >
            </div>
          </div>
        </section>
      </div>

      <!-- License & Attribution Section -->
      <section
        id="library-license"
        class="pt-8 border-t border-neutral-200 dark:border-neutral-800 pb-4"
      >
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 bg-neutral-100/60 dark:bg-neutral-900/60 border border-neutral-200/80 dark:border-neutral-800"
        >
          <div class="space-y-1">
            <span
              class="font-mono text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white block"
            >
              CC BY 4.0 / Creative Commons Attribution
            </span>
            <div
              class="text-xs text-neutral-600 dark:text-neutral-400 font-normal space-y-1.5 max-w-2xl"
            >
              <p>
                Free to use and adapt for personal and commercial projects with credit to <span
                  class="font-medium text-neutral-900 dark:text-neutral-100"
                  >Yovan</span
                >.
              </p>
              <p>
                A backlink attribution is preferred but not required for private client work, internal company projects, or cases where attribution conflicts with business requirements.
              </p>
            </div>
          </div>
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[11px] text-neutral-500 hover:text-neutral-900 dark:hover:text-white underline underline-offset-4 shrink-0 transition-colors"
          >
            View Terms ↗
          </a>
        </div>
      </section>

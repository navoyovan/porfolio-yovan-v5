      <script>
        function setupOthersHorizontalScroll() {
          const container = document.getElementById("others-scroll-container");
          const track = document.getElementById("others-scrollbar-track");
          const thumb = document.getElementById("others-scrollbar-thumb");
          if (!container || !track || !thumb) return;

          let isDraggingThumb = false;
          let startThumbX = 0;
          let initialThumbX = 0;
          let currentThumbX = 0;

          const updateThumb = () => {
            if (isDraggingThumb) return;
            const maxScroll = container.scrollWidth - container.clientWidth;
            if (maxScroll <= 0) {
              track.style.display = "none";
              return;
            }
            track.style.display = "block";

            const trackWidth = track.clientWidth;
            const thumbWidth = Math.max(
              28,
              (container.clientWidth / container.scrollWidth) * trackWidth,
            );
            thumb.style.width = `${thumbWidth}px`;

            const maxThumbTravel = trackWidth - thumbWidth;
            const scrollProgress = Math.min(
              1,
              Math.max(0, container.scrollLeft / maxScroll),
            );
            currentThumbX = scrollProgress * maxThumbTravel;
            thumb.style.transform = `translateX(${currentThumbX}px)`;
          };

          container.addEventListener(
            "scroll",
            () => {
              requestAnimationFrame(updateThumb);
            },
            { passive: true },
          );

          window.addEventListener("resize", updateThumb);
          requestAnimationFrame(updateThumb);
          setTimeout(updateThumb, 400);

          // Scrollbar Thumb Dragging
          thumb.addEventListener("mousedown", (e) => {
            if (e.button !== 0) return;
            isDraggingThumb = true;
            startThumbX = e.clientX;
            initialThumbX = currentThumbX;
            document.body.classList.add("select-none", "cursor-grabbing");
            container.style.scrollBehavior = "auto";
            e.preventDefault();
            e.stopPropagation();
          });

          window.addEventListener("mousemove", (e) => {
            if (!isDraggingThumb) return;
            const maxScroll = container.scrollWidth - container.clientWidth;
            const trackWidth = track.clientWidth;
            const thumbWidth = thumb.clientWidth;
            const maxThumbTravel = trackWidth - thumbWidth;
            if (maxThumbTravel <= 0 || maxScroll <= 0) return;

            const deltaX = e.clientX - startThumbX;
            const targetThumbX = Math.min(
              maxThumbTravel,
              Math.max(0, initialThumbX + deltaX),
            );
            currentThumbX = targetThumbX;
            thumb.style.transform = `translateX(${targetThumbX}px)`;

            const progress = targetThumbX / maxThumbTravel;
            container.scrollLeft = progress * maxScroll;
          });

          const stopDraggingThumb = () => {
            if (isDraggingThumb) {
              isDraggingThumb = false;
              document.body.classList.remove("select-none", "cursor-grabbing");
              container.style.scrollBehavior = "";
              updateThumb();
            }
          };

          window.addEventListener("mouseup", stopDraggingThumb);
          window.addEventListener("blur", stopDraggingThumb);

          // Scrollbar Track Click-to-Jump
          track.addEventListener("click", (e) => {
            if (e.target === thumb) return;
            const rect = track.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const trackWidth = track.clientWidth;
            const thumbWidth = thumb.clientWidth;
            const maxThumbTravel = trackWidth - thumbWidth;
            const maxScroll = container.scrollWidth - container.clientWidth;
            if (maxThumbTravel <= 0 || maxScroll <= 0) return;

            const targetThumbX = Math.min(
              maxThumbTravel,
              Math.max(0, clickX - thumbWidth / 2),
            );
            const targetProgress = targetThumbX / maxThumbTravel;
            container.scrollTo({
              left: targetProgress * maxScroll,
              behavior: "smooth",
            });
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener(
            "DOMContentLoaded",
            setupOthersHorizontalScroll,
          );
        } else {
          setupOthersHorizontalScroll();
        }
        document.addEventListener(
          "astro:page-load",
          setupOthersHorizontalScroll,
        );
      </script>


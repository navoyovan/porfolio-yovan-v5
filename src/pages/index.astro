                  class="h-full bg-neutral-900/30 dark:bg-white/30 group-hover:bg-neutral-900/60 dark:group-hover:bg-white/60 active:bg-neutral-900/80 dark:active:bg-white/80 rounded-full cursor-grab active:cursor-grabbing transition-[background-color] duration-200 absolute top-0 left-0"

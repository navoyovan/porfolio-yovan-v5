---
import RootLayout from "../layouts/RootLayout.astro";
import Hero from "../components/Hero.astro";
import StatusBadge from "../components/StatusBadge.astro";
import ActionButton from "../components/ActionButton.astro";
import ProjectTile from "../components/ProjectTile.astro";
import HoverExpandButton from "../components/HoverExpandButton.astro";
import EasterEggs from "../components/EasterEggs.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;

const coreStack = [
  {
    name: "Laravel",
    category: "Backend Architecture",
    icon: "ti-brand-laravel",
  },
  { name: "React", category: "UI Engineering", icon: "ti-brand-react" },
  {
    name: "Electron",
    category: "Desktop & Kiosk OS",
    icon: "ti-device-desktop",
  },
  { name: "Astro", category: "Static & Content Web", icon: "ti-brand-astro" },
  {
    name: "Google Cloud Platform",
    category: "Cloud Infrastructure",
    icon: "ti-cloud",
  },
  { name: "Docker", category: "Containerization", icon: "ti-brand-docker" },
];

const supportingStack = [
  { name: "TypeScript", icon: "ti-brand-typescript" },
  { name: "JavaScript", icon: "ti-brand-javascript" },
  { name: "PHP", icon: "ti-brand-php" },
  { name: "C# / .NET", icon: "ti-code" },
  { name: "Node.js", icon: "ti-brand-nodejs" },
  { name: "Vite", icon: "ti-brand-vite" },
  { name: "WPF & WebView2", icon: "ti-app-window" },
  { name: "Tailwind CSS", icon: "ti-brand-tailwind" },
  { name: "CSS Modules", icon: "ti-brand-css3" },
  { name: "Zustand", icon: "ti-atom" },
  { name: "WebSockets", icon: "ti-broadcast" },
  { name: "RESTful APIs", icon: "ti-api" },
  { name: "Filament", icon: "ti-layout-dashboard" },
  { name: "SQLite", icon: "ti-database" },
  { name: "MySQL", icon: "ti-brand-mysql" },
  { name: "Google Cloud Storage", icon: "ti-cloud-upload" },
  { name: "SNAP API", icon: "ti-credit-card" },
  { name: "Three.js", icon: "ti-3d-cube-sphere" },
  { name: "GSAP", icon: "ti-keyframes" },
  { name: "Anime.js", icon: "ti-sparkles" },
  { name: "Leaflet.js", icon: "ti-map" },
  { name: "Chart.js", icon: "ti-chart-line" },
  { name: "Git & GitHub", icon: "ti-brand-github" },
  { name: "GitHub Pages", icon: "ti-brand-git" },
  { name: "OWASP Guidelines", icon: "ti-shield-check" },
  { name: "SEO & Metadata", icon: "ti-search" },
  { name: "Accessibility (a11y)", icon: "ti-accessible" },
];

const capabilities = [
  {
    icon: "ti-browser",
    title: "Landing Pages & Websites",
    titleId: "Landing Page & Website",
    description:
      "Fast, accessible, and search-optimized websites for products, businesses, campaigns, and personal brands. Built with structured SEO, semantic markup, and responsive UI.",
    descriptionId:
      "Website yang cepat, aksesibel, dan ramah SEO untuk produk, bisnis, kampanye, atau personal brand. Dibangun dengan struktur SEO rapi, semantic markup, dan halaman yang lancar.",
    tags: ["Astro", "Tailwind", "SEO", "Accessibility (a11y)", "Responsive UI"],
  },
  {
    icon: "ti-apps",
    title: "Web Applications",
    titleId: "Aplikasi Web",
    description:
      "Dashboards, internal tools, SaaS products, MVP projects, authentication, APIs, and the logic behind them.",
    descriptionId:
      "Dashboard, internal tools, produk SaaS, proyek MVP, autentikasi, API, dan logika di belakang panggung.",
    tags: ["React / Vue", "Full-Stack", "Auth & RBAC", "REST APIs"],
  },
  {
    icon: "ti-hand-click",
    title: "Interfaces & User Experience",
    titleId: "Antarmuka & Pengalaman Pengguna",
    description:
      "Designing and building user experiences across different platforms, from web interfaces with mobile optimized interface, touchscreen kiosks, and interactive environments.",
    descriptionId:
      "Merancang dan membangun pengalaman pengguna di berbagai platform, dari web yang termasuk antarmuka mobile, touchscreen kiosk, sampai instalasi interaktif.",
    tags: [
      "Web Interfaces",
      "Mobile Experiences",
      "Touchscreen Kiosks",
      "Interactive UI",
    ],
  },
  {
    icon: "ti-plug-connected",
    title: "Connected Systems",
    titleId: "Sistem Terintegrasi",
    description:
      "Realtime communication, payment integrations, cloud services, and software that needs to talk to hardware.",
    descriptionId:
      "Komunikasi realtime, integrasi pembayaran, layanan cloud, dan software yang perlu terhubung langsung ke hardware.",
    tags: [
      "WebSockets",
      "Payment Gateways",
      "Cloud Storage",
      "IPC / Hardware I/O",
    ],
  },
];
---

<RootLayout
  title="Yovan Gunardio Darmawan | Software Engineer & Builder"
  description="Hey, I'm Yovan. Software engineer building web apps, touchscreen kiosks, and connected hardware systems. Available for freelance projects."
  keywords={[
    "Yovan Gunardio Darmawan",
    "Software Engineer",
    "Freelance Developer",
    "Web Application Developer",
    "Full-Stack Developer",
    "React Developer",
    "Laravel Developer",
    "Electron Developer",
    "Touchscreen Kiosk Software",
    "Photobooth Software",
    "HYPE-BOX",
    "SEO & Web Optimization",
    "Web Accessibility (a11y)",
    "Indonesia",
  ]}
>
  <!-- page wrapper: position relative so easter eggs scatter through scroll height -->
  <div class="relative">
    <EasterEggs />

    <Hero firstName="yovan" middleName="gunardio" lastName="darmawan" />

    <div class="w-[92%] sm:w-[86%] lg:w-[80%] mx-auto space-y-24 pb-28">
      <!-- 01 // OVERVIEW & HERO STATEMENT -->
      <section
        id="intro"
        aria-labelledby="heading-intro"
        class="scroll-mt-24 pt-16 space-y-8"
      >
        <div
          class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800"
        >
          <span
            class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
          >
            01 // OVERVIEW
          </span>
        </div>

        <!-- Section Headline Header (Header 2 Full Width) -->
        <h2
          id="heading-intro"
          data-en="I build software that makes ideas real."
          data-id="Aku membuat software dan mengubah imajinasi menjadi nyata."
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-[1.12] font-heading w-full"
        >
          I build software that makes ideas real.
        </h2>

        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pt-2"
        >
          <!-- Left Column: Portrait Photo with Technical Halo -->
          <div
            class="lg:col-span-5 xl:col-span-5 lg:sticky lg:top-24 flex flex-col items-center justify-center pt-4 sm:pt-6"
            style="transform: translateZ(0);"
          >
            <div
              class="relative w-full max-w-md sm:max-w-lg flex flex-col items-center justify-center border-b border-neutral-300/80 dark:border-neutral-800 overflow-hidden"
              style="transform: translateZ(0); contain: paint;"
            >
              <!-- Texture Backdrop: Full Soft 3/4 Radial Mask -->
              <div
                class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden [mask-image:radial-gradient(circle_at_50%_40%,black_35%,transparent_75%)]"
                style="transform: translateZ(0); will-change: transform; backface-visibility: hidden;"
              >
                <!-- tx1: Halftone dot pattern -->
                <img
                  src={`${base}/images/tx1.jpg`}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 w-full h-full object-cover object-center opacity-40 dark:opacity-30 mix-blend-multiply dark:mix-blend-screen dark:invert grayscale filter contrast-125"
                />
              </div>

              <img
                src={`${base}/images/v.png`}
                alt="Portrait of Yovan Gunardio Darmawan"
                width="540"
                height="540"
                class="relative z-10 w-full max-h-[500px] sm:max-h-[540px] object-contain object-bottom select-none pt-4"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          </div>

          <!-- 65% Right Column: Narrative, Tech Stack & CTA -->
          <div class="lg:col-span-7 xl:col-span-7 space-y-6">
            <p
              data-en="Hello, I'm Yovan. I build things for the world wide web and occasionally things that talk to machines."
              data-id="Halo, aku Yovan. Aku bikin ini dan itu buat di internet, dan sesekali ngoprak ngoprek nyambungin software ke hardware."
              class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal"
            >
              Hello, I'm Yovan. I build things for the world wide web and
              occasionally things that talk to machines.
            </p>

            <ul
              class="space-y-2.5 py-1.5 pl-4 border-l-2 border-[var(--color-accent,#52FF1A)]/50 font-sans text-sm sm:text-base text-neutral-600 dark:text-neutral-400 list-none m-0 p-0"
              aria-label="Overview highlights"
            >
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of webapp in my life</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of vscode by my side</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of dashboard all I need</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of touchscreen kiosk what I see</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of 12v in the sun</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of solder all night long</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of LED, here I am</span>
              </li>
              <li class="flex items-center gap-2.5">
                <span
                  class="text-[var(--color-accent,#52FF1A)] text-xs font-mono select-none font-bold"
                  aria-hidden="true">›</span
                >
                <span>A little bit of git makes me your guy</span>
              </li>
            </ul>

            <p
              data-en="I enjoy building things across the stack, from the interface people see to the systems making everything run behind the scenes."
              data-id="Aku membangun sistem dari ujung ke ujung, dari tampilan yang dilihat orang sampai hiruk pikuk sistem di belakang panggung."
              class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal pt-3 sm:pt-4"
            >
              I enjoy building things across the stack, from the interface
              people see to the systems making everything run behind the scenes.
            </p>

            <!-- Tech Stack Layout -->
            <div
              class="pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80"
            >
              <!-- Core Stack Header -->
              <div class="flex items-center justify-between pb-6">
                <h3
                  class="font-heading font-bold text-xs sm:text-sm uppercase tracking-wider text-neutral-500 dark:text-neutral-400 m-0"
                >
                  Core Stack
                </h3>
                <span
                  class="font-sans text-[11px] text-neutral-400 dark:text-neutral-500 font-medium"
                >
                  {coreStack.length} core • {supportingStack.length} supporting
                </span>
              </div>

              <!-- Core Stack (Icon-as-Object: Unboxed, Breathing Grid) -->
              <ul
                class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-6 sm:gap-8 list-none m-0 p-0"
                aria-label="Core Technologies"
              >
                {
                  coreStack.map((tech) => (
                    <li class="flex flex-col space-y-2.5 group cursor-default">
                      <div class="text-3xl sm:text-4xl text-neutral-800 dark:text-neutral-200 group-hover:text-[var(--color-accent,#52FF1A)] transition-[transform,color] duration-200 group-hover:-translate-y-1 group-hover:scale-105 inline-flex items-center">
                        <i class={`ti ${tech.icon}`} aria-hidden="true" />
                      </div>
                      <div class="space-y-0.5">
                        <div class="font-heading font-bold text-sm sm:text-base text-neutral-950 dark:text-white tracking-tight m-0">
                          {tech.name}
                        </div>
                        <div class="font-sans text-[11px] sm:text-xs text-neutral-500 dark:text-neutral-400 leading-tight group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors m-0">
                          {tech.category}
                        </div>
                      </div>
                    </li>
                  ))
                }
              </ul>

              <!-- Supporting Stack Divider & Container -->
              <div
                class="mt-10 pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80"
              >
                <h3
                  class="font-heading font-bold text-xs sm:text-sm uppercase tracking-wider text-neutral-500 dark:text-neutral-400 block m-0 pb-4"
                >
                  Ecosystem & Supporting Tech
                </h3>
                <ul
                  class="flex flex-wrap items-center gap-x-4 sm:gap-x-5 gap-y-2.5 sm:gap-y-3 list-none m-0 p-0"
                  aria-label="Ecosystem and Supporting Technologies"
                >
                  {
                    supportingStack.map((tech) => (
                      <li class="inline-flex items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400 hover:text-neutral-950 dark:hover:text-white transition-colors group">
                        <i
                          class={`ti ${tech.icon} text-sm text-neutral-400 dark:text-neutral-500 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors`}
                          aria-hidden="true"
                        />
                        <span class="font-sans font-medium">{tech.name}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 // PROJECTS & HYPEBOX -->
      <section
        id="projects"
        aria-labelledby="heading-projects"
        class="scroll-mt-24 pt-16 space-y-10"
      >
        <div
          class="flex items-center justify-between pb-2 border-b border-neutral-200 dark:border-neutral-800"
        >
          <span
            class="font-heading font-bold text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
          >
            02 // FEATURED WORK
          </span>
          <a
            href={`${base}/portfolio-index`}
            class="group/action inline-flex items-center gap-1 font-heading font-bold text-xs uppercase tracking-wider text-neutral-500 dark:text-neutral-400 hover:text-[var(--color-accent,#52FF1A)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded px-1"
          >
            <span
              class="group-hover/action:underline underline-offset-4 decoration-[var(--color-accent,#52FF1A)]"
            >
              View Full Index
            </span>
            <span
              class="inline-block opacity-40 transition-all duration-200 group-hover/action:opacity-100 group-hover/action:translate-x-0.5"
            >
              →
            </span>
          </a>
        </div>

        <!-- Project Intro Copywriting -->
        <div class="space-y-3 max-w-3xl">
          <h2
            id="heading-projects"
            data-en="Things I've built"
            data-id="Beberapa karya yang aku bikin"
            class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white leading-tight font-heading"
          >
            Things I've built
          </h2>
          <p
            data-en="A collection of projects, and products where I tried to solve a problem, learn something new, or just casually building some SaaS Multi-tenant B2B Ecosystem"
            data-id="Kumpulan proyek dan produk tempat aku mencoba menyelesaikan masalah, belajar hal baru, atau sekedar bikin SaaS Multi-tenant B2B"
            class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal"
          >
            A collection of projects, and products where I tried to solve a
            problem, learn something new, or just some SaaS Milti-tenant B2B
            Ecosystem
          </p>
        </div>

        <!-- Featured Spotlight: Hypebox Pipeline & Connected Ecosystem -->
        <article
          aria-labelledby="heading-hypebox"
          class="border-[1.5px] border-dashed border-neutral-300 dark:border-neutral-700 bg-transparent p-6 sm:p-8 space-y-8"
        >
          <!-- Hypebox Header & Actions -->
          <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-neutral-200/80 dark:border-neutral-800/80"
          >
            <div class="space-y-1">
              <h3
                id="heading-hypebox"
                class="text-2xl sm:text-3xl font-black tracking-tight text-neutral-950 dark:text-white leading-none font-heading"
              >
                HYPE-BOX
              </h3>
              <p
                data-en="A connected photo booth platform, built from kiosk to backend."
                data-id="Platform photo booth terintegrasi, dibangun dari software kiosk sampai backend."
                class="text-sm font-medium text-neutral-600 dark:text-neutral-400 m-0 pt-0.5"
              >
                A connected photo booth platform, built from kiosk to backend.
              </p>
            </div>

            <div
              class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto"
            >
              <ActionButton
                variant="secondary"
                size="sm"
                href="https://navoyovan.github.io/photobooth-kiosk-demo/"
                target="_blank"
                rel="noopener noreferrer"
                ariaLabel="Launch Kiosk Demo (opens in new tab)"
                data-aria-en="Launch Kiosk Demo (opens in new tab)"
                data-aria-id="Uji Coba Kiosk (buka di tab baru)"
                class="group/btn overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
              >
                <div
                  class="inline-flex items-center translate-x-[10px] group-hover/btn:translate-x-0 transition-transform duration-200 ease-out"
                >
                  <span data-en="Launch Kiosk Demo" data-id="Uji Coba Kiosk"
                    >Launch Kiosk Demo</span
                  >
                  <span
                    class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-200 ease-out"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </div>
              </ActionButton>
              <ActionButton
                variant="primary"
                size="sm"
                href="https://navoyovan.github.io/hypebox/"
                target="_blank"
                rel="noopener noreferrer"
                ariaLabel="Visit Hypebox Site (opens in new tab)"
                data-aria-en="Visit Hypebox Site (opens in new tab)"
                data-aria-id="Kunjungi Situs Hypebox (buka di tab baru)"
                class="group/btn overflow-hidden w-full sm:w-auto max-sm:!py-[11px]"
              >
                <div
                  class="inline-flex items-center translate-x-[10px] group-hover/btn:translate-x-0 transition-transform duration-200 ease-out"
                >
                  <span
                    data-en="Visit Hypebox Site"
                    data-id="Kunjungi Situs Hypebox">Visit Hypebox Site</span
                  >
                  <span
                    class="inline-flex items-center justify-center w-3.5 ml-1.5 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-200 ease-out"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </div>
              </ActionButton>
            </div>
          </div>

          <!-- Architecture Summary -->
          <p
            data-en="An integrated hardware-software pipeline orchestrating printers, camera hardware, a touchscreen Electron client, real-time WebSocket telemetry, and cloud fleet management."
            data-id="Pipeline hardware-software terintegrasi yang menghubungkan printer, kamera, aplikasi touchscreen berbasis Electron, telemetry real-time WebSocket, dan cloud fleet management."
            class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed max-w-3xl font-normal m-0"
          >
            An integrated hardware-software pipeline orchestrating physical
            printers, camera hardware, a touchscreen Electron client, real-time
            WebSocket telemetry, and cloud fleet management.
          </p>

          <!-- Pipeline Cards (1-line side-scroll on mobile, 4-col grid on desktop) -->
          <div
            class="flex flex-nowrap overflow-x-auto gap-4 pb-4 pt-3 sm:pt-4 -mx-4 px-4 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-4 lg:overflow-visible lg:pb-0 lg:gap-4 no-scrollbar"
          >
            <!-- STAGE 01: Initiation & Payment -->
            <div
              class="w-[280px] sm:w-[320px] lg:w-auto shrink-0 lg:shrink flex flex-col justify-between p-4 sm:p-5 bg-[#f6f4ee] dark:bg-[#141414] border border-neutral-300/80 dark:border-neutral-800 transition-all duration-200 hover:border-neutral-400 dark:hover:border-neutral-600 shadow-sm relative group"
            >
              <div class="flex flex-col flex-1 gap-3">
                <p
                  class="font-sans text-[11px] uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold m-0"
                >
                  Edge &rarr; API
                </p>
                <h4
                  class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight leading-tight group-hover:text-[var(--color-accent,#52FF1A)] transition-colors font-heading m-0"
                >
                  Touch &amp; QRIS Payment
                </h4>
                <p
                  data-en="Kiosk generates order. Laravel REST API generates dynamic QRIS via SNAP API with webhook confirmation."
                  data-id="Kiosk bikin order. Laravel REST API mengenerate kode QRIS via SNAP API dengan konfirmasi webhook."
                  class="font-sans text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal m-0"
                >
                  Kiosk generates order. Laravel REST API generates dynamic QRIS
                  via SNAP API with webhook confirmation.
                </p>
              </div>
              <div class="mt-auto pt-3.5 space-y-2">
                <div
                  class="flex items-center justify-between font-mono text-[10px] text-neutral-500 dark:text-neutral-400"
                >
                  <span>Protocol:</span>
                  <span
                    class="font-semibold text-neutral-700 dark:text-neutral-300"
                    >REST / SNAP</span
                  >
                </div>
                <ul
                  class="flex flex-wrap gap-1.5 list-none p-0 m-0"
                  aria-label="Tech tokens"
                >
                  <li>
                    <span
                      class="font-sans text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2 sm:px-2.5 py-0.5 rounded inline-block"
                      >ELECTRON</span
                    >
                  </li>
                  <li>
                    <span
                      class="font-sans text-[9px] sm:text-[10px] font-semibold uppercase tracking-wider text-neutral-700 dark:text-neutral-300 bg-neutral-200/60 dark:bg-neutral-800/80 px-2 sm:px-2.5 py-0.5 rounded inline-block"
                      >LARAVEL</span
                    >
                  </li>
                  <li>
                    <span

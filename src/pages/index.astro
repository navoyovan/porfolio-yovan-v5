---
import RootLayout from "../layouts/RootLayout.astro";
import Hero from "../components/Hero.astro";
import Overview from "../components/Overview.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import StatusBadge from "../components/StatusBadge.astro";
import ActionButton from "../components/ActionButton.astro";
import EasterEggs from "../components/EasterEggs.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;

const capabilities = [
  {
    icon: "ti-browser",
    title: "Landing Pages & Websites",
    titleId: "Landing Page & Website",
    description:
      "Fast, accessible, and search-optimized websites for products, businesses, campaigns, and personal brands. Built with structured SEO, semantic markup, and responsive UI.",
    descriptionId:
      "Website yang cepat, aksesibel, dan ramah SEO untuk produk, bisnis, kampanye, atau personal brand. Dibangun dengan struktur SEO rapi, semantic markup, dan halaman yang lancar.",
    tags: ["Astro", "Tailwind", "SEO", "Accessibility (a11y)", "Responsive UI"],
  },
  {
    icon: "ti-apps",
    title: "Web Applications",
    titleId: "Aplikasi Web",
    description:
      "Dashboards, internal tools, SaaS products, MVP projects, authentication, APIs, and the logic behind them.",
    descriptionId:
      "Dashboard, internal tools, produk SaaS, proyek MVP, autentikasi, API, dan logika di belakang panggung.",
    tags: ["React / Vue", "Full-Stack", "Auth & RBAC", "REST APIs"],
  },
  {
    icon: "ti-hand-click",
    title: "Interfaces & User Experience",
    titleId: "Antarmuka & Pengalaman Pengguna",
    description:
      "Designing and building user experiences across different platforms, from web interfaces with mobile optimized interface, touchscreen kiosks, and interactive environments.",
    descriptionId:
      "Merancang dan membangun pengalaman pengguna di berbagai platform, dari web yang termasuk antarmuka mobile, touchscreen kiosk, sampai instalasi interaktif.",
    tags: [
      "Web Interfaces",
      "Mobile Experiences",
      "Touchscreen Kiosks",
      "Interactive UI",
    ],
  },
  {
    icon: "ti-plug-connected",
    title: "Connected Systems",
    titleId: "Sistem Terintegrasi",
    description:
      "Realtime communication, payment integrations, cloud services, and software that needs to talk to hardware.",
    descriptionId:
      "Komunikasi realtime, integrasi pembayaran, layanan cloud, dan software yang perlu terhubung langsung ke hardware.",
    tags: [
      "WebSockets",
      "Payment Gateways",
      "Cloud Storage",
      "IPC / Hardware I/O",
    ],
  },
];
---

<RootLayout
  title="Yovan Gunardio Darmawan | Software Engineer & Builder"
  description="Hey, I'm Yovan. Software engineer building web apps, touchscreen kiosks, and connected hardware systems. Available for freelance projects."
  keywords={[
    "Yovan Gunardio Darmawan",
    "Software Engineer",
    "Freelance Developer",
    "Web Application Developer",
    "Full-Stack Developer",
    "React Developer",
    "Laravel Developer",
    "Electron Developer",
    "Touchscreen Kiosk Software",
    "Photobooth Software",
    "HYPE-BOX",
    "SEO & Web Optimization",
    "Web Accessibility (a11y)",
    "Indonesia",
  ]}
>
  <!-- page wrapper: position relative so easter eggs scatter through scroll height -->
  <div class="relative">
    <EasterEggs />

    <Hero firstName="Yovan" middleName="Gunardio." />

    <div class="relative z-10 w-[92%] sm:w-[86%] lg:w-[80%] mx-auto space-y-24 pb-28">
      <!-- 01 // OVERVIEW & HERO STATEMENT -->
      <Overview base={base} />

      <!-- 02 // PROJECTS & HYPEBOX -->
      <FeaturedProjects base={base} />


      <!-- 03 // WHAT I CAN BUILD -->
      <section
        id="capabilities"
        aria-labelledby="heading-capabilities"
        class="scroll-mt-24 pt-16 space-y-8"
      >
        <!-- Section 03 Sliced Numeral Header Bar -->
        <div class="flex items-stretch gap-0 pb-1">
          <!-- Big Section Numeral "3" (Sliced vertically in half by container boundary) -->
          <div
            id="capabilities-numeral-crop"
            class="relative overflow-hidden flex items-center justify-end select-none shrink-0"
            style="width: 85px; contain: paint;"
          >
            <span
              id="capabilities-numeral"
              class="relative font-heading font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-tighter shrink-0 select-none"
              aria-hidden="true"
              style="font-size: 92px; left: 13px; top: -6px; display: inline-block;"
            >
              3
            </span>
          </div>

          <!-- Vertical Divider Line (Exact Slice Axis) -->
          <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

          <!-- Right Side: Section label with horizontal rule + Headline -->
          <div class="flex-1 flex flex-col justify-center min-w-0 pl-3 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
            <!-- Top: Category label with horizontal rule -->
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
              <span class="font-heading font-bold text-[10.5px] sm:text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                WHAT I CAN BUILD
              </span>
            </div>

            <!-- Section Headline -->
            <div class="pt-0.5">
              <h2
                id="heading-capabilities"
                data-en="From simple pages to systems that do stuff."
                data-id="Dari halaman sederhana sampai sistem yang beneran kerja."
                class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-[1.08] font-heading w-full m-0"
              >
                From simple pages to systems that do stuff.
              </h2>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-4 pb-4">
          {
            capabilities.map((item) => (
              <div class="group relative p-6 sm:p-7 border border-neutral-300/80 dark:border-neutral-800 bg-[#f6f4ee] dark:bg-[#141414] transition-all duration-200 hover:border-neutral-400 dark:hover:border-neutral-600">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 lg:gap-8">
                  <div class="flex items-start gap-4 sm:gap-6 flex-1">
                    <div
                      class="text-xl sm:text-2xl text-neutral-400 dark:text-neutral-500 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors pt-0.5 shrink-0 flex items-center justify-center"
                      aria-hidden="true"
                    >
                      <i class={`ti ${item.icon}`} />
                    </div>
                    <div class="space-y-1.5 flex-1">
                      <h3
                        data-en={item.title}
                        data-id={item.titleId || item.title}
                        class="text-lg sm:text-xl font-heading font-bold text-neutral-950 dark:text-white group-hover:text-[var(--color-accent,#52FF1A)] transition-colors m-0"
                      >
                        {item.title}
                      </h3>
                      <p
                        data-en={item.description}
                        data-id={item.descriptionId || item.description}
                        class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400 max-w-3xl m-0"
                      >
                        {item.description}
                      </p>
                    </div>
                  </div>

                  <ul
                    class="flex flex-wrap gap-1.5 sm:gap-2 lg:justify-end shrink-0 pl-8 sm:pl-10 lg:pl-0 list-none m-0 p-0"
                    aria-label="Capability tags"
                  >
                    {item.tags.map((tag) => (
                      <li>
                        <span class="text-[9px] sm:text-[10px] font-sans font-semibold px-2 sm:px-2.5 py-0.5 sm:py-1 rounded bg-neutral-200/60 dark:bg-neutral-800/80 text-neutral-600 dark:text-neutral-400 uppercase tracking-wider inline-block">
                          {tag}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 04 // PHILOSOPHY -->
      <section
        id="philosophy"
        aria-labelledby="heading-philosophy"
        class="scroll-mt-24 pt-16 space-y-8"
      >
        <!-- Section 04 Sliced Numeral Header Bar -->
        <div class="flex items-stretch gap-0 pb-1">
          <!-- Big Section Numeral "4" (Sliced vertically in half by container boundary) -->
          <div
            id="philosophy-numeral-crop"
            class="relative overflow-hidden flex items-center justify-end select-none shrink-0"
            style="width: 85px; contain: paint;"
          >
            <span
              id="philosophy-numeral"
              class="relative font-heading font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-tighter shrink-0 select-none"
              aria-hidden="true"
              style="font-size: 92px; left: 13px; top: -6px; display: inline-block;"
            >
              4
            </span>
          </div>

          <!-- Vertical Divider Line (Exact Slice Axis) -->
          <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

          <!-- Right Side: Section label with horizontal rule + Headline & Subdeck -->
          <div class="flex-1 flex flex-col justify-center min-w-0 pl-3 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
            <!-- Top: Category label with horizontal rule -->
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
              <span class="font-heading font-bold text-[10.5px] sm:text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                PHILOSOPHY
              </span>
            </div>

            <!-- Section Headline & Subdeck -->
            <div class="space-y-1.5 pt-0.5">
              <h2
                id="heading-philosophy"
                data-en="I build for the thing, not the stack."
                data-id="Aku bikin produk, bukan sekedar stacknya doang."
                class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-[1.08] font-heading w-full m-0"
              >
                I build for the thing, not the stack.
              </h2>
              <p
                data-en="Understanding the whole problem before deciding how to solve it. The interface, the backend, the hardware, the weird edge cases; they're all part of the same product."
                data-id="Dengan memahami masalahnya secara menyeluruh sebelum milih jalan solusinya. Antarmuka, backend, hardware, sampai kasus unik yang ga kepikiran, semuanya tetap bagian dari satu produk."
                class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal max-w-3xl m-0"
              >
                Understanding the whole problem before deciding how to solve it.
                The interface, the backend, the hardware, the weird edge cases;
                they're all part of the same product.
              </p>
            </div>
          </div>
        </div>

        <div class="flex flex-col lg:flex-row items-start gap-8 lg:gap-12 pt-2">
          <!-- 65% Left Column: Principles, Strategy & Quote -->
          <div class="w-full lg:w-[65%] space-y-8">

            <div class="space-y-8 sm:space-y-10 pt-2">
              <div class="group flex items-start gap-4 sm:gap-6">
                <span
                  class="text-xs sm:text-sm font-sans font-bold text-neutral-400 dark:text-neutral-500 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors pt-1 shrink-0 select-none"
                  aria-hidden="true"
                >
                  01
                </span>
                <div class="space-y-1.5 flex-1">
                  <h3
                    data-en="Start with the actual use case."
                    data-id="Mulai dari studi kasusnya."
                    class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight group-hover:text-[var(--color-accent,#52FF1A)] transition-colors font-heading m-0"
                  >
                    Start with the actual use case.
                  </h3>
                  <p
                    data-en="Technology is just the tool. I care about what the product needs to accomplish, who is using it, and what could get in their way."
                    data-id="Teknologi adalah alat. Yang terpenting adalah apa tujuan produknya, siapa penggunanya, dan kendala apa yang mungkin mereka hadapi."
                    class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed m-0"
                  >
                    Technology is just the tool. I care about what the product
                    needs to accomplish, who is using it, and what could get in
                    their way.
                  </p>
                </div>
              </div>

              <div class="group flex items-start gap-4 sm:gap-6">
                <span
                  class="text-xs sm:text-sm font-sans font-bold text-neutral-400 dark:text-neutral-500 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors pt-1 shrink-0 select-none"
                  aria-hidden="true"
                >
                  02
                </span>
                <div class="space-y-1.5 flex-1">
                  <h3
                    data-en="Keep complexity earned."
                    data-id="Kompleksitas seperlunya saja."
                    class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight group-hover:text-[var(--color-accent,#52FF1A)] transition-colors font-heading m-0"
                  >
                    Keep complexity earned.
                  </h3>
                  <p
                    data-en="Not every project needs a giant architecture. I use what the problem calls for, it doesnt have to be over-engineered but still hitting the spot."
                    data-id="Tidak semua project butuh arsitektur besar-besaran. Aku pilih solusi yang pas sesuai masalahnya, nggak perlu over-engineered yang penting tetap tepat sasaran."
                    class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed m-0"
                  >
                    Not every project needs a giant architecture. I use what the
                    problem calls for, it doesnt have to be over-engineered but
                    still hitting the spot.
                  </p>
                </div>
              </div>

              <div class="group flex items-start gap-4 sm:gap-6">
                <span
                  class="text-xs sm:text-sm font-sans font-bold text-neutral-400 dark:text-neutral-500 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors pt-1 shrink-0 select-none"
                  aria-hidden="true"
                >
                  03
                </span>
                <div class="space-y-1.5 flex-1">
                  <h3
                    data-en="Make the pieces work together."
                    data-id="Bikin tiap bagian nyambung dengan mulus."
                    class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight group-hover:text-[var(--color-accent,#52FF1A)] transition-colors font-heading m-0"
                  >
                    Make the pieces work together.
                  </h3>
                  <p
                    data-en="A good interface is only one part of a good product. I like connecting the things behind it: databases, realtime systems, devices, payments, and everything in between; see them in broad, see them in granular level, all of 'em are part of the same product."
                    data-id="Antarmuka yang bagus baru sebagian dari produk yang baik dan benar. Aku biasa ngehubungin hal-hal di baliknya seperti: database, sistem realtime, perangkat fisik, pembayaran, dan semuanya, baik dari gambaran besar sampai detail terkecil."
                    class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed m-0"
                  >
                    A good interface is only one part of a good product. I like
                    connecting the things behind it: databases, realtime
                    systems, devices, payments, and everything in between; see
                    them in broad, see them in granular level, all of 'em are
                    part of the same product.
                  </p>
                </div>
              </div>

              <div class="group flex items-start gap-4 sm:gap-6">
                <span
                  class="text-xs sm:text-sm font-sans font-bold text-neutral-400 dark:text-neutral-500 group-hover:text-[var(--color-accent,#52FF1A)] transition-colors pt-1 shrink-0 select-none"
                  aria-hidden="true"
                >
                  04
                </span>
                <div class="space-y-1.5 flex-1">
                  <h3
                    data-en="Sweat the details that matter."
                    data-id="Teliti pada detail-detail yang penting."
                    class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight group-hover:text-[var(--color-accent,#52FF1A)] transition-colors font-heading m-0"
                  >
                    Sweat the details that matter.
                  </h3>
                  <p
                    data-en="Loading states, feedback, transitions, edge cases, awkward workflows; the little things are often what separate something that technically works from something that actually feels good to use."
                    data-id='Loading state, feedback, transisi, penanganan error, alur yang canggung dan bikin kesel; hal-hal kecil inilah yang membedakan software yang sekadar "bisa jalan" dengan software yang beneran enak dipakai.'
                    class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed"
                  >
                    Loading states, feedback, transitions, edge cases, awkward
                    workflows; the little things are often what separate
                    something that technically works from something that
                    actually feels good to use.
                  </p>
                </div>
              </div>
            </div>

            <div class="pt-4 space-y-4">
              <p
                data-en="And the final product should make someone say:"
                data-id="Dan hasil akhir yang ideal bikin orang bilang:"
                class="text-neutral-600 dark:text-neutral-400 text-base"
              >
                And the final product should make someone say:
              </p>

              <!-- Quote Highlight -->
              <div
                class="p-6 sm:p-7 border-l-4 border-[var(--color-accent,#52FF1A)] bg-[#f6f4ee] dark:bg-[#141414] border-y border-r border-neutral-300/60 dark:border-neutral-800 space-y-3"
              >
                <blockquote
                  class="text-2xl sm:text-3xl md:text-4xl font-bold italic tracking-tight text-neutral-950 dark:text-white font-heading"
                >
                  "_"
                </blockquote>
                <p
                  data-en="Nothing. That's how I know I built it for the actual use case: when the software gets out of the way, and does what it's supposed to do, it leaves nothing for the user to complain about."
                  data-id="Nggak ada. Di situlah kita tahu software ini dibuat dengan bagus: ketika aplikasinya bekerja mulus tanpa kendala, pengguna nggak punya alasan buat mengeluh."
                  class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed"
                >
                  Nothing. That's how I know I built it for the actual use case:
                  when the software gets out of the way, and does what it's
                  supposed to do, it leaves nothing for the user to complain
                  about.
                </p>
              </div>
            </div>
          </div>

          <!-- 35% Right Column (Empty for now) -->
          <div class="hidden lg:block lg:w-[35%]"></div>
        </div>
      </section>

      <!-- 05 // ABOUT -->
      <section
        id="about"
        aria-labelledby="heading-about"
        class="scroll-mt-24 pt-16 space-y-8"
      >
        <!-- Section 05 Sliced Numeral Header Bar -->
        <div class="flex items-stretch gap-0 pb-1">
          <!-- Big Section Numeral "5" (Sliced vertically in half by container boundary) -->
          <div
            id="about-numeral-crop"
            class="relative overflow-hidden flex items-center justify-end select-none shrink-0"
            style="width: 85px; contain: paint;"
          >
            <span
              id="about-numeral"
              class="relative font-heading font-black leading-none text-neutral-950/40 dark:text-white/40 tracking-tighter shrink-0 select-none"
              aria-hidden="true"
              style="font-size: 92px; left: 13px; top: -6px; display: inline-block;"
            >
              5
            </span>
          </div>

          <!-- Vertical Divider Line (Exact Slice Axis) -->
          <div class="w-px bg-neutral-300 dark:bg-neutral-800 shrink-0 self-stretch my-0.5" aria-hidden="true"></div>

          <!-- Right Side: Section label with horizontal rule + Headline -->
          <div class="flex-1 flex flex-col justify-center min-w-0 pl-3 sm:pl-4 lg:pl-5 py-0.5 gap-1.5">
            <!-- Top: Category label with horizontal rule -->
            <div class="flex items-center justify-between pb-1 border-b border-neutral-200 dark:border-neutral-800 w-full">
              <span class="font-heading font-bold text-[10.5px] sm:text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
                ABOUT
              </span>
            </div>

            <!-- Section Headline -->
            <div class="pt-0.5">
              <h2
                id="heading-about"
                data-en="A little bit about myself."
                data-id="Sedikit cerita tentang aku."
                class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-950 dark:text-white leading-[1.08] font-heading w-full m-0"
              >
                A little bit about myself.
              </h2>
            </div>
          </div>
        </div>

        <div
          class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start pt-2"
        >
          <div class="lg:col-span-5 space-y-3">
            <div
              aria-hidden="true"
              class="hidden lg:block font-mono text-[10px] sm:text-[11px] text-neutral-400/50 dark:text-neutral-600/60 italic leading-relaxed pt-1 select-none"
            >
              <p
                data-en="// You can find these labels throughout the page, some are interactable and would show some of my secret cool projects."
                data-id="// Label-label seperti ini tersebar di seluruh halaman, beberapa bisa diklik buat liat proyek rahasia yang seru."
                class="m-0"
              >
                // You can find these labels throughout the page, some are
                interactable and would show some of my secret cool projects.
              </p>
              <div
                class="flex items-center gap-1.5 pt-1 text-neutral-400/40 dark:text-neutral-600/50"
              >
                <span
                  data-en="Try clicking this label"
                  data-id="Coba klik label ini"
                  class="shrink-0"
                >
                  Try clicking this label
                </span>
                <!-- Long hairline dashed connector line extending all the way to the divider -->
                <div class="flex flex-1 items-center min-w-[60px]">
                  <div
                    class="flex-1 border-b border-dashed border-neutral-300/30 dark:border-neutral-700/40"
                  >
                  </div>
                  <span
                    class="not-italic text-[9px] text-neutral-400/40 dark:text-neutral-600/50 font-mono -ml-0.5 leading-none"
                    >›</span
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- Vertical Easter Egg Divider between the 2 About Columns (Desktop) -->
          <div
            class="hidden lg:flex absolute left-[41.6%] inset-y-0 items-center justify-center -translate-x-1/2 select-none pointer-events-none"
          >
            <button
              type="button"
              data-easter="modpe"
              class="font-mono text-[10px] text-neutral-600 dark:text-neutral-300 opacity-[0.08] hover:opacity-75 hover:underline underline-offset-4 cursor-pointer select-none transition-[opacity,text-decoration] duration-200 [writing-mode:vertical-rl] rotate-180 pointer-events-auto p-1 bg-transparent border-0 tracking-wider focus-visible:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent,#52FF1A)] rounded"
              aria-label="Unlock ModPE Scripting Cool Stuff"
              data-aria-en="Unlock ModPE Scripting Cool Stuff"
              data-aria-id="Buka Cool Stuff Skrip ModPE"
            >
              Entity.setRenderType(mob, 3);
            </button>
          </div>

          <div
            class="lg:col-span-7 space-y-6 text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal"
          >
            <p
              data-en="My journey started with modding Java games back when I was in elementary school and Android games in high school, but curiosity pulled me into everything around it, like- designing interfaces, building backend, connecting hardware, and creating intuitive experiences for users."
              data-id="Perjalananku berawal dari ngoprek game Java ketika SD dan game Android pas SMA. Rasa penasaran menuntunku dari sana sampe ke sini, desain UI/UX, bikin backend, jadi tukang kabel (nyambungin hardware), sampai membangun pengalaman yang intuitif buat pengguna."
            >
              My journey started with modding Java games back when I was in
              elementary school and Android games in high school, but curiosity
              pulled me into everything around it, like- designing interfaces,
              building backend, connecting hardware, and creating intuitive
              experiences for users.
            </p>
            <p
              data-en="I enjoy working on projects where software isn't just sitting on a screen, but where it interacts with people, devices, and the real world."
              data-id="Aku paling antusias dengan proyek yang di mana software nggak cuma diam di layar, tapi beneran berinteraksi dengan orang, perangkat fisik, dan dunia nyata."
              class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base"
            >
              I enjoy working on projects where software isn't just sitting on a
              screen, but where it interacts with people, devices, and the real
              world.
            </p>

            <!-- Mobile Easter Egg inline fallback & hint -->
            <div
              aria-hidden="true"
